ww.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"कमल, गेंद, मछली, घर","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) हमें पौधों के लिए क्या बचाना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>प्लास्टिक कचरा</b><span>　/　</span><b>धुआँ</b></div></div></div><div class=\"opt-line\">(2) भोजन से पहले क्या करें?<div class=\"tiny-options\"><div class=\"choices\"><b>हाथ धोएँ</b><span>　/　</span><b>मिट्टी खाएँ</b><span>　/　</span><b>किताब फाड़ें</b></div></div></div><div class=\"opt-line\">(3) अगर कोई चोट लगे तो किसे बताएँ?<div class=\"tiny-options\"><div class=\"choices\"><b>विश्वसनीय बड़े को</b><span>　/　</span><b>किसी को नहीं</b><span>　/　</span><b>अजनबी को</b></div></div></div><div class=\"opt-line\">(4) गर्मी में कौन से कपड़े आरामदायक?<div class=\"tiny-options\"><div class=\"choices\"><b>हल्के सूती</b><span>　/　</span><b>बहुत भारी ऊनी</b><span>　/　</span><b>गीले कपड़े</b></div></div></div></div>","answer":"पानी; हाथ धोएँ; विश्वसनीय बड़े को; हल्के सूती","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> आम • पत्ता • सेब • कप</p>","answer":"कप, सेब, पत्ता, आम","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) दूध किससे मिलता है?</div><div class=\"opt-line\">(2) पेड़ हमें क्या देते हैं?</div><div class=\"opt-line\">(3) हाथ के कितने पंजे होते हैं?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>book/किताब · water/पानी · apple/सेब · tree/पेड़</b></p>","answer":"उत्तर: गाय/भैंस, छाया, दो; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|3|7|Art":{"grade":"Nursery","term":3,"year":7,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>circle/गोला · square/वर्ग · fish/मछली</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|3|7|Oral":{"grade":"Nursery","term":3,"year":7,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — कहानी सुनकर प्रश्न समझना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न समझना। उदाहरण सामग्री/संवाद: <b>मनपसंद खिलौना</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — रंग/आकृति पहचानना","body":"<p>अध्यापक निर्देश: रंग/आकृति पहचानना। उदाहरण सामग्री/संवाद: <b>बगीचे की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — आयु-अनुसार गिनती/जोड़","body":"<p>अध्यापक निर्देश: आयु-अनुसार गिनती/जोड़। उदाहरण सामग्री/संवाद: <b>ढक्कन</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — स्वच्छता की एक आदत बताना","body":"<p>अध्यापक निर्देश: स्वच्छता की एक आदत बताना। उदाहरण सामग्री/संवाद: <b>घर</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — साथियों से सहयोग करना","body":"<p>अध्यापक निर्देश: साथियों से सहयोग करना। उदाहरण सामग्री/संवाद: <b>नमस्ते</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>I can count / मैं गिन सकता/सकती हूँ | Water / पानी | Good morning / सुप्रभात</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|3|8|Hindi":{"grade":"Nursery","term":3,"year":8,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">फ</span><span class=\"trace\">ब</span><span class=\"trace\">भ</span><span class=\"trace\">म</span><span class=\"trace\">य</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: फ, ब, भ, म, य","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>य</b><span>　/　</span><b>भ</b><span>　/　</span><b>ल</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>र</b><span>　/　</span><b>म</b><span>　/　</span><b>व</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>ल</b><span>　/　</span><b>य</b><span>　/　</span><b>श</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>व</b><span>　/　</span><b>र</b><span>　/　</span><b>स</b></div></div></div>","answer":"क्रम से: भ, म, य, र","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg> <span class=\"wide-space\">________</span>　 (फ / फ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (आ / ब)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"wide-space\">________</span>　 (क / भ)</div></div>","answer":"चित्र/उत्तर: फूल — फ, आम — आ, कमल — क","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ब　→　<span class=\"blank\">_____</span>　→　म</div><div class=\"opt-line\">भ　→　<span class=\"blank\">_____</span>　→　य</div><div class=\"opt-line\">म　→　<span class=\"blank\">_____</span>　→　र</div></div>","answer":"बीच के अक्षर: भ, म, य","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">य</span><span class=\"trace\">र</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>भ | त | ढ | ज | इ</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|3|8|English":{"grade":"Nursery","term":3,"year":8,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">B</span><span class=\"trace\">C</span><span class=\"trace\">D</span><span class=\"trace\">E</span><span class=\"trace\">F</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: B, C, D, E, F","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>C</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>D</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>E</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>F</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b></div></div></div>","answer":"Circle: C, D, E, F","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>U</b><span>　/　</span><b>V</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>C</b><span>　/　</span><b>D</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>C</b><span>　/　</span><b>D</b></div></div></div>","answer":"Umbrella — U, Car — C, Cup — C","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">F　<span class=\"blank\">_____</span>　H</div><div class=\"opt-line\">G　<span class=\"blank\">_____</span>　I</div><div class=\"opt-line\">H　<span class=\"blank\">_____</span>　J</div></div>","answer":"G, H, I","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>F</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b><span>　/　</span><b>J</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>M · R · F · D · P</b></p>","answer":"Teacher records recognition of own-name letter.; recognise M, R, F, D, P","marks":4}]},"Nursery|3|8|Maths":{"grade":"Nursery","term":3,"year":8,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\