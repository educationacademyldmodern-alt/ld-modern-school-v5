-West","hi":"दक्षिण-पश्चिम"},{"en":"West","hi":"पश्चिम"},{"en":"North-East","hi":"उत्तर-पूर्व"},{"en":"South","hi":"दक्षिण"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which process turns vapour into drops?","hi":"वाष्प से बूँदें बनने की प्रक्रिया क्या है?","ans":"Condensation","ans_hi":"संघनन","options":[{"en":"Freezing","hi":"जमना"},{"en":"Melting","hi":"पिघलना"},{"en":"Evaporation","hi":"वाष्पीकरण"},{"en":"Condensation","hi":"संघनन"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which natural event produces thunder and lightning?","hi":"गर्जन और बिजली किस प्राकृतिक घटना में होते हैं?","ans":"Thunderstorm","ans_hi":"गरज-चमक वाला तूफान","options":[{"en":"Sunlight","hi":"सूर्यप्रकाश"},{"en":"Thunderstorm","hi":"गरज-चमक वाला तूफान"},{"en":"Freezing","hi":"जमना"},{"en":"Gravity","hi":"गुरुत्वाकर्षण"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What protects an online account?","hi":"ऑनलाइन खाते की सुरक्षा किससे होती है?","ans":"Strong password","ans_hi":"मजबूत पासवर्ड","options":[{"en":"Helmet","hi":"हेलमेट"},{"en":"Reusable bag","hi":"दोबारा उपयोग होने वाला थैला"},{"en":"Trusted adult","hi":"विश्वसनीय वयस्क"},{"en":"Strong password","hi":"मजबूत पासवर्ड"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which direction is opposite to North?","hi":"उत्तर के विपरीत कौन-सी दिशा है?","ans":"South","ans_hi":"दक्षिण","options":[{"en":"West","hi":"पश्चिम"},{"en":"North-East","hi":"उत्तर-पूर्व"},{"en":"South-East","hi":"दक्षिण-पूर्व"},{"en":"South","hi":"दक्षिण"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which device measures rainfall?","hi":"वर्षा की मात्रा कौन-सा यंत्र मापता है?","ans":"Rain gauge","ans_hi":"वर्षामापी","options":[{"en":"Thunderstorm","hi":"गरज-चमक वाला तूफान"},{"en":"Freezing","hi":"जमना"},{"en":"Evaporation","hi":"वाष्पीकरण"},{"en":"Rain gauge","hi":"वर्षामापी"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 51 trees on Monday and 4 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 51 और मंगलवार को 4 पेड़ लगाए। कुल कितने पेड़?","ans":"55","ans_hi":"55","options":[{"en":"61","hi":"61"},{"en":"55","hi":"55"},{"en":"59","hi":"59"},{"en":"53","hi":"53"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 19 paper sheets and reused 6. How many were left unused?","hi":"कक्षा ने 19 कागज़ की शीट इकट्ठी कीं और 6 फिर उपयोग कीं। कितनी बचीं?","ans":"13","ans_hi":"13","options":[{"en":"21","hi":"21"},{"en":"11","hi":"11"},{"en":"26","hi":"26"},{"en":"13","hi":"13"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 11 rows with 7 flowers each. How many flowers?","hi":"बगीचे में 11 कतारें हैं और हर कतार में 7 फूल हैं। कुल कितने फूल?","ans":"77","ans_hi":"77","options":[{"en":"84","hi":"84"},{"en":"76","hi":"76"},{"en":"78","hi":"78"},{"en":"77","hi":"77"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"50 reusable bottles are shared equally among 5 groups. How many in each group?","hi":"50 दोबारा प्रयोग होने वाली बोतलें 5 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"10","ans_hi":"10","options":[{"en":"17","hi":"17"},{"en":"20","hi":"20"},{"en":"12","hi":"12"},{"en":"10","hi":"10"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 19 birds on a tree. 10 fly away. How many stay?","hi":"पेड़ पर 19 पक्षी थे, 10 उड़ गए। कितने बचे?","ans":"9","ans_hi":"9","options":[{"en":"7","hi":"7"},{"en":"18","hi":"18"},{"en":"19","hi":"19"},{"en":"9","hi":"9"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 11 pages each day for 3 days. How many pages?","hi":"विद्यार्थी 3 दिन तक रोज़ 11 पृष्ठ पढ़ता है। कुल कितने?","ans":"33","ans_hi":"33","options":[{"en":"66","hi":"66"},{"en":"34","hi":"34"},{"en":"33","hi":"33"},{"en":"36","hi":"36"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 6 litres of water a day for 6 days. How many litres?","hi":"कक्षा 6 दिनों तक प्रतिदिन 6 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"36","ans_hi":"36","options":[{"en":"37","hi":"37"},{"en":"36","hi":"36"},{"en":"38","hi":"38"},{"en":"42","hi":"42"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 21 pencils, and 13 are used. How many remain?","hi":"कुल 21 पेंसिल में 13 उपयोग हो गईं। कितनी बचीं?","ans":"8","ans_hi":"8","options":[{"en":"21","hi":"21"},{"en":"16","hi":"16"},{"en":"8","hi":"8"},{"en":"10","hi":"10"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 42 recyclable items in the morning and 4 in the evening. How many items?","hi":"टीम ने सुबह 42 और शाम 4 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"46","ans_hi":"46","options":[{"en":"52","hi":"52"},{"en":"4","hi":"4"},{"en":"48","hi":"48"},{"en":"46","hi":"46"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 45 seedlings. 5 more are planted. How many now?","hi":"पहले 45 पौध थे, 5 और लगाए गए। अब कुल कितने?","ans":"50","ans_hi":"50","options":[{"en":"51","hi":"51"},{"en":"57","hi":"57"},{"en":"50","hi":"50"},{"en":"55","hi":"55"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A child gets a message that asks for bank details. What is right?","hi":"बैंक जानकारी माँगने वाला संदेश आए तो क्या करें?","ans":"Do not reply; infor