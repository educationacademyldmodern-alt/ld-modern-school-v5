:"8","hi":"8"},{"en":"10","hi":"10"},{"en":"6","hi":"6"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 3 paper sheets and reused 5. How many were left unused?","hi":"कक्षा ने 3 कागज़ की शीट इकट्ठी कीं और 5 फिर उपयोग कीं। कितनी बचीं?","ans":"-2","ans_hi":"-2","options":[{"en":"-2","hi":"-2"},{"en":"5","hi":"5"},{"en":"0","hi":"0"},{"en":"3","hi":"3"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 2 rows with 3 flowers each. How many flowers?","hi":"बगीचे में 2 कतारें हैं और हर कतार में 3 फूल हैं। कुल कितने फूल?","ans":"6","ans_hi":"6","options":[{"en":"6","hi":"6"},{"en":"9","hi":"9"},{"en":"8","hi":"8"},{"en":"12","hi":"12"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"4 reusable bottles are shared equally among 2 groups. How many in each group?","hi":"4 दोबारा प्रयोग होने वाली बोतलें 2 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"2","ans_hi":"2","options":[{"en":"0","hi":"0"},{"en":"2","hi":"2"},{"en":"1","hi":"1"},{"en":"4","hi":"4"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 9 birds on a tree. 5 fly away. How many stay?","hi":"पेड़ पर 9 पक्षी थे, 5 उड़ गए। कितने बचे?","ans":"4","ans_hi":"4","options":[{"en":"5","hi":"5"},{"en":"4","hi":"4"},{"en":"3","hi":"3"},{"en":"9","hi":"9"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 4 pages each day for 3 days. How many pages?","hi":"विद्यार्थी 3 दिन तक रोज़ 4 पृष्ठ पढ़ता है। कुल कितने?","ans":"12","ans_hi":"12","options":[{"en":"15","hi":"15"},{"en":"11","hi":"11"},{"en":"12","hi":"12"},{"en":"13","hi":"13"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 3 litres of water a day for 3 days. How many litres?","hi":"कक्षा 3 दिनों तक प्रतिदिन 3 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"9","ans_hi":"9","options":[{"en":"8","hi":"8"},{"en":"6","hi":"6"},{"en":"9","hi":"9"},{"en":"7","hi":"7"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 8 pencils, and 6 are used. How many remain?","hi":"कुल 8 पेंसिल में 6 उपयोग हो गईं। कितनी बचीं?","ans":"2","ans_hi":"2","options":[{"en":"2","hi":"2"},{"en":"8","hi":"8"},{"en":"3","hi":"3"},{"en":"1","hi":"1"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 5 recyclable items in the morning and 5 in the evening. How many items?","hi":"टीम ने सुबह 5 और शाम 5 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"10","ans_hi":"10","options":[{"en":"8","hi":"8"},{"en":"10","hi":"10"},{"en":"11","hi":"11"},{"en":"5","hi":"5"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 5 seedlings. 1 more are planted. How many now?","hi":"पहले 5 पौध थे, 1 और लगाए गए। अब कुल कितने?","ans":"6","ans_hi":"6","options":[{"en":"8","hi":"8"},{"en":"9","hi":"9"},{"en":"12","hi":"12"},{"en":"6","hi":"6"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"Your friend falls while playing. What is the kind first step?","hi":"खेलते समय मित्र गिर जाए तो पहला अच्छा कदम क्या है?","ans":"Call a teacher and help","ans_hi":"शिक्षक को बुलाएँ और सहायता करें","options":[{"en":"Laugh at the friend","hi":"मित्र पर हँसें"},{"en":"Run away without telling","hi":"बिना बताए भाग जाएँ"},{"en":"Call a teacher and help","hi":"शिक्षक को बुलाएँ और सहायता करें"},{"en":"Push the friend again","hi":"फिर धक्का दें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A stranger sends a link promising free toys. What should you do?","hi":"अनजान व्यक