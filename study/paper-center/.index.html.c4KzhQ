:"<div class=\"traces\"><span class=\"trace\">5</span><span class=\"trace\">1</span><span class=\"trace\">2</span><span class=\"trace\">3</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 5, 1, 2, 3","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।","marks":4}]},"Nursery|1|4|EVS":{"grade":"Nursery","term":1,"year":4,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"सेब, पत्ता, आम, कमल","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) रात में क्या दिखाई देता है?<div class=\"tiny-options\"><div class=\"choices\"><b>चाँद</b><span>　/　</span><b>सूरज</b><span>　/　</span><b>इंद्रधनुष</b></div></div></div><div class=\"opt-line\">(2) पेड़ पर क्या लगते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>पत्ते</b><span>　/　</span><b>जूते</b><span>　/　</span><b>खिलौने</b></div></div></div><div class=\"opt-line\">(3) बिल्ली कैसी होती है?<div class=\"tiny-options\"><div class=\"choices\"><b>जानवर</b><span>　/　</span><b>फल</b><span>　/　</span><b>वाहन</b></div></div></div><div class=\"opt-line\">(4) फूल पौधे का क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>भाग</b><span>　/　</span><b>जूता</b><span>　/　</span><b>बर्तन</b></div></div></div></div>","answer":"चाँद; पत्ते; जानवर; भाग","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> मछली • गेंद • कमल • आम</p>","answer":"आम, कमल, गेंद, मछली","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) पानी को क्या करना चाहिए?</div><div class=\"opt-line\">(2) कुत्ता किस तरह का जानवर है?</div><div class=\"opt-line\">(3) किताब किससे बनी होती है?</div></div>","answer":"उत्तर: बचाना, पालतू, कागज","marks":4}]},"Nursery|1|4|Art":{"grade":"Nursery","term":1,"year":4,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।","marks":4}]},"Nursery|1|4|Oral":{"grade":"Nursery","term":1,"year":4,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>सड़क की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>कंकड़</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>पेड़</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>माफ कीजिए</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4}]},"Nursery|1|5|Hindi":{"grade":"Nursery","term":1,"year":5,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">प</span><span class=\"trace\">फ</span><span class=\"trace\">ब</span><span class=\"trace\">म</span><span class=\"trace\">न</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: प, फ, ब, म, न","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>न</b><span>　/　</span><b>ब</b><span>　/　</span><b>आ</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>अ</b><span>　/　</span><b>म</b><span>　/　</span><b>इ</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>आ</b><span>　/　</span><b>न</b><span>　/　</span><b>ई</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>इ</b><span>　/　</span><b>अ</b><span>　/　</span><b>उ</b></div></div></div>","answer":"क्रम से: ब, म, न, अ","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg> <span class=\"wide-space\">________</span>　 (ग / प)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg> <span class=\"wide-space\">________</span>　 (म / फ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (घ / ब)</div></div>","answer":"चित्र/उत्तर: गेंद — ग, मछली — म, घर — घ","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">फ　→　<span class=\"blank\">_____</span>　→　म</div><div class=\"opt-line\">ब　→　<span class=\"blank\">_____</span>　→　न</div><div class=\"opt-line\">अ　→　<span class=\"blank\">_____</span>　→　इ</div></div>","answer":"बीच के अक्षर: ब, म, आ","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">न</span><span class=\"trace\">अ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>इ | आ | ब | थ | ध</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|5|English":{"grade":"Nursery","term":1,"year":5,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">A</span><span class=\"trace\">B</span><span class=\"trace\">C</span><span class=\"trace\">D</span><span class=\"trace\">E</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: A, B, C, D, E","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>B</b><span>　/　</span><b>D</b><span>　/　</span><b>E</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>C</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>D</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>E</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b></div></div></div>","answer":"Circle: B, C, D, E","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>L</b><span>　/　</span><b>M</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>B</b><span>　/　</span><b>C</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>F</b><span>　/　</span><b>G</b></div></div></div>","answer":"Lotus — L, Ball — B, Fish — F","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">E　<span class=\"blank\">_____</span>　G</div><div class=\"opt-line\">F　<span class=\"blank\">_____</span>　H</div><div class=\"opt-line\">G　<span class=\"blank\">_____</span>　I</div></div>","answer":"F, G, H","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>E</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>G · L · A · D · J</b></p>","answer":"Teacher records recognition of own-name letter.; recognise G, L, A, D, J","marks":4}]},"Nursery|1|5|Maths":{"grade":"Nursery","term":1,"year":5,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"5, 1, 2, 3","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>3</b><span>　/　</span><b>4</b><span>　/　</span><b>5</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>4</b><span>　/　</span><b>5</b><span>　/　</span><b>1</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>1</b><span>　/　</span><b>2</b><span>　/　</span><b>3</b></div></div></div>","answer":"3, 4, 5, 1","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">3</span><span class=\"trace\">4</span><span class=\"trace\">5</span><span class=\"trace\">1</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 3, 4, 5, 1","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>2 · 3 · 5 · 2 · 5</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 2, 3, 5, 2, 5","marks":4}]},"Nursery|1|5|EVS":{"grade":"Nursery","term":1,"year":5,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"कमल, गेंद, मछली, घर","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) कुत्ता किस तरह का जानवर है?<div class=\"tiny-options\"><div class=\"choices\"><b>पालतू</b><span>　/　</span><b>जलचर</b><span>　/　</span><b>पक्षी</b></div></div></div><div class=\"opt-line\">(2) किताब किससे बनी होती है?<div class=\"tiny-options\"><div class=\"choices\"><b>कागज</b><span>　/　</span><b>दूध</b><span>　/　</span><b>तेल</b></div></div></div><div class=\"opt-line\">(3) मौसम गर्म हो तो क्या पीना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>स्याही</b><span>　/　</span><b>मिट्टी</b></div></div></div><div class=\"opt-line\">(4) हरे पौधे कहाँ उगते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>मिट्टी में</b><span>　/　</span><b>प्लास्टिक में हमेशा</b><span>　/　</span><b>पत्थर के भीतर</b></div></div></div></div>","answer":"पालतू; कागज; पानी; मिट्टी में","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> फूल • सूरज • घर • मछली</p>","answer":"मछली, घर, सूरज, फूल","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) आम क्या है?</div><div class=\"opt-line\">(2) गाजर क्या है?</div><div class=\"opt-line\">(3) मछली कहाँ रहती है?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>water/पानी · fish/मछली · sun/सूर्य · mango/आम</b></p>","answer":"उत्तर: फल, सब्जी, पानी; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|5|Art":{"grade":"Nursery","term":1,"year":5,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>triangle/त्रिभुज · ball/गेंद · sun/सूर्य</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|5|Oral":{"grade":"Nursery","term":1,"year":5,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद फल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>कक्षा की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>गेंदें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>सूरज</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>धन्यवाद</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>My name is… / मेरा नाम… | Wash hands / हाथ धोना | My teacher / मेरे शिक्षक</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|1|6|Hindi":{"grade":"Nursery","term":1,"year":6,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">म</span><span class=\"trace\">न</span><span class=\"trace\">अ</span><span class=\"trace\">आ</span><span class=\"trace\">इ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: म, न, अ, आ, इ","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>इ</b><span>　/　</span><b>अ</b><span>　/　</span><b>उ</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>ई</b><span>　/　</span><b>आ</b><span>　/　</span><b>ऊ</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>उ</b><span>　/　</span><b>इ</b><span>　/　</span><b>क</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>ऊ</b><span>　/　</span><b>ई</b><span>　/　</span><b>ख</b></div></div></div>","answer":"क्रम से: अ, आ, इ, ई","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg> <span class=\"wide-space\">________</span>　 (फ / म)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (आ / न)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"wide-space\">________</span>　 (क / अ)</div></div>","answer":"चित्र/उत्तर: फूल — फ, आम — आ, कमल — क","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">आ　→　<span class=\"blank\">_____</span>　→　ई</div><div class=\"opt-line\">इ　→　<span class=\"blank\">_____</span>　→　उ</div><div class=\"opt-line\">ई　→　<span class=\"blank\">_____</span>　→　ऊ</div></div>","answer":"बीच के अक्षर: इ, ई, उ","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">इ</span><span class=\"trace\">ई</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>घ | न | अ | इ | ख</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|6|English":{"grade":"Nursery","term":1,"year":6,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">D</span><span class=\"trace\">E</span><span class=\"trace\">F</span><span class=\"trace\">G</span><span class=\"trace\">H</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: D, E, F, G, H","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>E</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>F</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>G</b><span>　/　</span><b>I</b><span>　/　</span><b>J</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>H</b><span>　/　</span><b>J</b><span>　/　</span><b>K</b></div></div></div>","answer":"Circle: E, F, G, H","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>H</b><span>　/　</span><b>I</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>F</b><span>　/　</span><b>G</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>C</b><span>　/　</span><b>D</b></div></div></div>","answer":"House — H, Flower — F, Cat — C","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">H　<span class=\"blank\">_____</span>　J</div><div class=\"opt-line\">I　<span class=\"blank\">_____</span>　K</div><div class=\"opt-line\">J　<span class=\"blank\">_____</span>　L</div></div>","answer":"I, J, K","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>H</b><span>　/　</span><b>I</b><span>　/　</span><b>J</b><span>　/　</span><b>K</b><span>　/　</span><b>L</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>D · I · A · J · G</b></p>","answer":"Teacher records recognition of own-name letter.; recognise D, I, A, J, G","marks":4}]},"Nursery|1|6|Maths":{"grade":"Nursery","term":1,"year":6,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"3, 4, 5, 1","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>1</b><span>　/　</span><b>2</b><span>　/　</span><b>3</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>2</b><span>　/　</span><b>3</b><span>　/　</span><b>4</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>3</b><span>　/　</span><b>4</b><span>　/　</span><b>5</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>4</b><span>　/　</span><b>5</b><span>　/　</span><b>1</b></div></div></div>","answer":"1, 2, 3, 4","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">1</span><span class=\"trace\">2</span><span class=\"trace\">3</span><span class=\"trace\">4</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 1, 2, 3, 4","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>3 · 2 · 4 · 5 · 5</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 3, 2, 4, 5, 5","marks":4}]},"Nursery|1|6|EVS":{"grade":"Nursery","term":1,"year":6,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"घर, सूरज, फूल, बिल्ली","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) गाजर क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>सब्जी</b><span>　/　</span><b>गाड़ी</b><span>　/　</span><b>खिलौना</b></div></div></div><div class=\"opt-line\">(2) मछली कहाँ रहती है?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>पेड़</b><span>　/　</span><b>आकाश</b></div></div></div><div class=\"opt-line\">(3) पौधे को बढ़ने के लिए क्या चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>जूता</b><span>　/　</span><b>किताब</b></div></div></div><div class=\"opt-line\">(4) पक्षी कहाँ उड़ते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>आकाश</b><span>　/　</span><b>पानी के भीतर</b><span>　/　</span><b>अलमारी</b></div></div></div></div>","answer":"सब्जी; पानी; पानी; आकाश","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> किताब • पेड़ • बिल्ली • फूल</p>","answer":"फूल, बिल्ली, पेड़, किताब","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) पेड़ पर क्या लगते हैं?</div><div class=\"opt-line\">(2) बिल्ली कैसी होती है?</div><div class=\"opt-line\">(3) फूल पौधे का क्या है?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>apple/सेब · leaf/पत्ती · banana/केला · water/पानी</b></p>","answer":"उत्तर: पत्ते, जानवर, भाग; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|6|Art":{"grade":"Nursery","term":1,"year":6,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>fish/मछली · triangle/त्रिभुज · house/घर</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|6|Oral":{"grade":"Nursery","term":1,"year":6,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद रंग</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>घर की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>पेंसिलें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>कृपया</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>I can count / मैं गिन सकता/सकती हूँ | Water / पानी | Please / कृपया</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|1|7|Hindi":{"grade":"Nursery","term":1,"year":7,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">आ</span><span class=\"trace\">इ</span><span class=\"trace\">ई</span><span class=\"trace\">उ</span><span class=\"trace\">ऊ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: आ, इ, ई, उ, ऊ","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>ऊ</b><span>　/　</span><b>ई</b><span>　/　</span><b>ख</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>क</b><span>　/　</span><b>उ</b><span>　/　</span><b>ग</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>ख</b><span>　/　</span><b>ऊ</b><span>　/　</span><b>घ</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>ग</b><span>　/　</span><b>क</b><span>　/　</span><b>च</b></div></div></div>","answer":"क्रम से: ई, उ, ऊ, क","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg> <span class=\"wide-space\">________</span>　 (ग / आ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg> <span class=\"wide-space\">________</span>　 (म / इ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (घ / ई)</div></div>","answer":"चित्र/उत्तर: गेंद — ग, मछली — म, घर — घ","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">उ　→　<span class=\"blank\">_____</span>　→　क</div><div class=\"opt-line\">ऊ　→　<span class=\"blank\">_____</span>　→　ख</div><div class=\"opt-line\">क　→　<span class=\"blank\">_____</span>　→　ग</div></div>","answer":"बीच के अक्षर: ऊ, क, ख","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">ऊ</span><span class=\"trace\">क</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>झ | त | ब | इ | ग</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|7|English":{"grade":"Nursery","term":1,"year":7,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">G</span><span class=\"trace\">H</span><span class=\"trace\">I</span><span class=\"trace\">J</span><span class=\"trace\">K</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: G, H, I, J, K","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>H</b><span>　/　</span><b>J</b><span>　/　</span><b>K</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>I</b><span>　/　</span><b>K</b><span>　/　</span><b>L</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>J</b><span>　/　</span><b>L</b><span>　/　</span><b>M</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>K</b><span>　/　</span><b>M</b><span>　/　</span><b>N</b></div></div></div>","answer":"Circle: H, I, J, K","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>B</b><span>　/　</span><b>C</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>M</b><span>　/　</span><b>N</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>C</b><span>　/　</span><b>D</b></div></div></div>","answer":"Book — B, Moon — M, Car — C","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">K　<span class=\"blank\">_____</span>　M</div><div class=\"opt-line\">L　<span class=\"blank\">_____</span>　N</div><div class=\"opt-line\">A　<span class=\"blank\">_____</span>　C</div></div>","answer":"L, M, B","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>K</b><span>　/　</span><b>L</b><span>　/　</span><b>M</b><span>　/　</span><b>N</b><span>　/　</span><b>A</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>M · N · H · G · D</b></p>","answer":"Teacher records recognition of own-name letter.; recognise M, N, H, G, D","marks":4}]},"Nursery|1|7|Maths":{"grade":"Nursery","term":1,"year":7,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"1, 2, 3, 4","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　<div class=\"choices\"><b>4</b><span>　/　</span><b>5</b><span>　/　</span><b>1</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　<div class=\"choices\"><b>1</b><span>　/　</span><b>2</b><span>　/　</span><b>3</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　<div class=\"choices\"><b>2</b><span>　/　</span><b>3</b><span>　/　</span><b>4</b></div></div></div>","answer":"4, 5, 1, 2","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">4</span><span class=\"trace\">5</span><span class=\"trace\">1</span><span class=\"trace\">2</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 4, 5, 1, 2","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>3 · 2 · 1 · 4 · 4</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 3, 2, 1, 4, 4","marks":4}]},"Nursery|1|7|EVS":{"grade":"Nursery","term":1,"year":7,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"बिल्ली, पेड़, किताब, चाँद","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) बिल्ली कैसी होती है?<div class=\"tiny-options\"><div class=\"choices\"><b>जानवर</b><span>　/　</span><b>फल</b><span>　/　</span><b>वाहन</b></div></div></div><div class=\"opt-line\">(2) फूल पौधे का क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>भाग</b><span>　/　</span><b>जूता</b><span>　/　</span><b>बर्तन</b></div></div></div><div class=\"opt-line\">(3) स्वस्थ रहने के लिए क्या खाएँ?<div class=\"tiny-options\"><div class=\"choices\"><b>पौष्टिक भोजन</b><span>　/　</span><b>केवल मिठाई</b><span>　/　</span><b>मिट्टी</b></div></div></div><div class=\"opt-line\">(4) पानी को क्या करना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>बचाना</b><span>　/　</span><b>व्यर्थ बहाना</b><span>　/　</span><b>गंदा करना</b></div></div></div></div>","answer":"जानवर; भाग; पौष्टिक भोजन; बचाना","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> कार • छाता • चाँद • किताब</p>","answer":"किताब, चाँद, छाता, कार","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) किताब किससे बनी होती है?</div><div class=\"opt-line\">(2) मौसम गर्म हो तो क्या पीना चाहिए?</div><div class=\"opt-line\">(3) हरे पौधे कहाँ उगते हैं?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>mango/आम · book/किताब · tree/पेड़ · banana/केला</b></p>","answer":"उत्तर: कागज, पानी, मिट्टी में; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|7|Art":{"grade":"Nursery","term":1,"year":7,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>ball/गेंद · star/तारा · fish/मछली</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|7|Oral":{"grade":"Nursery","term":1,"year":7,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद खिलौना</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>बगीचे की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>ढक्कन</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>घर</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>नमस्ते</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>I can count / मैं गिन सकता/सकती हूँ | Please / कृपया | Wash hands / हाथ धोना</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|1|8|Hindi":{"grade":"Nursery","term":1,"year":8,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">उ</span><span class=\"trace\">ऊ</span><span class=\"trace\">क</span><span class=\"trace\">ख</span><span class=\"trace\">ग</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: उ, ऊ, क, ख, ग","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>ग</b><span>　/　</span><b>क</b><span>　/　</span><b>च</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>घ</b><span>　/　</span><b>ख</b><span>　/　</span><b>छ</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>च</b><span>　/　</span><b>ग</b><span>　/　</span><b>ज</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>छ</b><span>　/　</span><b>घ</b><span>　/　</span><b>ट</b></div></div></div>","answer":"क्रम से: क, ख, ग, घ","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg> <span class=\"wide-space\">________</span>　 (फ / उ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (आ / ऊ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"wide-space\">________</span>　 (क / क)</div></div>","answer":"चित्र/उत्तर: फूल — फ, आम — आ, कमल — क","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ख　→　<span class=\"blank\">_____</span>　→　घ</div><div class=\"opt-line\">ग　→　<span class=\"blank\">_____</span>　→　च</div><div class=\"opt-line\">घ　→　<span class=\"blank\">_____</span>　→　छ</div></div>","answer":"बीच के अक्षर: ग, घ, च","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">ग</span><span class=\"trace\">घ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>म | ख | ठ | छ | आ</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|8|English":{"grade":"Nursery","term":1,"year":8,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">J</span><span class=\"trace\">K</span><span class=\"trace\">L</span><span class=\"trace\">M</span><span class=\"trace\">N</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: J, K, L, M, N","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>K</b><span>　/　</span><b>M</b><span>　/　</span><b>N</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>L</b><span>　/　</span><b>N</b><span>　/　</span><b>A</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>M</b><span>　/　</span><b>A</b><span>　/　</span><b>B</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>N</b><span>　/　</span><b>B</b><span>　/　</span><b>C</b></div></div></div>","answer":"Circle: K, L, M, N","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>C</b><span>　/　</span><b>D</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>A</b><span>　/　</span><b>B</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>L</b><span>　/　</span><b>M</b></div></div></div>","answer":"Cup — C, Apple — A, Leaf — L","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">B　<span class=\"blank\">_____</span>　D</div><div class=\"opt-line\">C　<span class=\"blank\">_____</span>　E</div><div class=\"opt-line\">D　<span class=\"blank\">_____</span>　F</div></div>","answer":"C, D, E","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>N</b><span>　/　</span><b>A</b><span>　/　</span><b>B</b><span>　/　</span><b>C</b><span>　/　</span><b>D</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>E · M · H · I · G</b></p>","answer":"Teacher records recognition of own-name letter.; recognise E, M, H, I, G","marks":4}]},"Nursery|1|8|Maths":{"grade":"Nursery","term":1,"year":8,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"4, 5, 1, 2","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　<div class=\"choices\"><b>2</b><span>　/　</span><b>3</b><span>　/　</span><b>4</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　<div class=\"choices\"><b>3</b><span>　/　</span><b>4</b><span>　/　</span><b>5</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　<div class=\"choices\"><b>4</b><span>　/　</span><b>5</b><span>　/　</span><b>1</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 2L12 8L18 8L13 12L15 18L10 14L5 18L7 12L2 8L8 8Z\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div></div>","answer":"2, 3, 4, 5","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">2</span><span class=\"trace\">3</span><span class=\"trace\">4</span><span class=\"trace\">5</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 2, 3, 4, 5","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>5 · 5 · 2 · 2 · 5</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 5, 5, 2, 2, 5","marks":4}]},"Nursery|1|8|EVS":{"grade":"Nursery","term":1,"year":8,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"चाँद, छाता, कार, कप","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) मौसम गर्म हो तो क्या पीना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>स्याही</b><span>　/　</span><b>मिट्टी</b></div></div></div><div class=\"opt-line\">(2) हरे पौधे कहाँ उगते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>मिट्टी में</b><span>　/　</span><b>प्लास्टिक में हमेशा</b><span>　/　</span><b>पत्थर के भीतर</b></div></div></div><div class=\"opt-line\">(3) गाय हमें क्या देती है?<div class=\"tiny-options\"><div class=\"choices\"><b>दूध</b><span>　/　</span><b>पेट्रोल</b><span>　/　</span><b>कागज</b></div></div></div><div class=\"opt-line\">(4) आम क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>फल</b><span>　/　</span><b>पक्षी</b><span>　/　</span><b>वाहन</b></div></div></div></div>","answer":"पानी; मिट्टी में; दूध; फल","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> पत्ता • सेब • कप • कार</p>","answer":"कार, कप, सेब, पत्ता","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) मछली कहाँ रहती है?</div><div class=\"opt-line\">(2) पौधे को बढ़ने के लिए क्या चाहिए?</div><div class=\"opt-line\">(3) पक्षी कहाँ उड़ते हैं?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>fish/मछली · mango/आम · water/पानी · apple/सेब</b></p>","answer":"उत्तर: पानी, पानी, आकाश; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|8|Art":{"grade":"Nursery","term":1,"year":8,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>ball/गेंद · triangle/त्रिभुज · fish/मछली</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|8|Oral":{"grade":"Nursery","term":1,"year":8,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>सड़क की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>कंकड़</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>पेड़</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>माफ कीजिए</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>Water / पानी | My school / मेरा विद्यालय | Share toys / खिलौने बाँटना</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|1|9|Hindi":{"grade":"Nursery","term":1,"year":9,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">ख</span><span class=\"trace\">ग</span><span class=\"trace\">घ</span><span class=\"trace\">च</span><span class=\"trace\">छ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: ख, ग, घ, च, छ","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>छ</b><span>　/　</span><b>घ</b><span>　/　</span><b>ट</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>ज</b><span>　/　</span><b>च</b><span>　/　</span><b>प</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>ट</b><span>　/　</span><b>छ</b><span>　/　</span><b>फ</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>प</b><span>　/　</span><b>ज</b><span>　/　</span><b>ब</b></div></div></div>","answer":"क्रम से: घ, च, छ, ज","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg> <span class=\"wide-space\">________</span>　 (ग / ख)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg> <span class=\"wide-space\">________</span>　 (म / ग)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (घ / घ)</div></div>","answer":"चित्र/उत्तर: गेंद — ग, मछली — म, घर — घ","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">च　→　<span class=\"blank\">_____</span>　→　ज</div><div class=\"opt-line\">छ　→　<span class=\"blank\">_____</span>　→　ट</div><div class=\"opt-line\">ज　→　<span class=\"blank\">_____</span>　→　प</div></div>","answer":"बीच के अक्षर: छ, ज, ट","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">छ</span><span class=\"trace\">ज</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>थ | ज | ह | ई | ध</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|9|English":{"grade":"Nursery","term":1,"year":9,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">M</span><span class=\"trace\">N</span><span class=\"trace\">A</span><span class=\"trace\">B</span><span class=\"trace\">C</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: M, N, A, B, C","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>N</b><span>　/　</span><b>B</b><span>　/　</span><b>C</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>A</b><span>　/　</span><b>C</b><span>　/　</span><b>D</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>B</b><span>　/　</span><b>D</b><span>　/　</span><b>E</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>C</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b></div></div></div>","answer":"Circle: N, A, B, C","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>M</b><span>　/　</span><b>N</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>L</b><span>　/　</span><b>M</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>B</b><span>　/　</span><b>C</b></div></div></div>","answer":"Mango — M, Lotus — L, Ball — B","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">E　<span class=\"blank\">_____</span>　G</div><div class=\"opt-line\">F　<span class=\"blank\">_____</span>　H</div><div class=\"opt-line\">G　<span class=\"blank\">_____</span>　I</div></div>","answer":"F, G, H","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>C</b><span>　/　</span><b>D</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>N · B · C · J · E</b></p>","answer":"Teacher records recognition of own-name letter.; recognise N, B, C, J, E","marks":4}]},"Nursery|1|9|Maths":{"grade":"Nursery","term":1,"year":9,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"2, 3, 4, 5","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>1</b><span>　/　</span><b>2</b><span>　/　</span><b>3</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>2</b><span>　/　</span><b>3</b><span>　/　</span><b>4</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　<div class=\"choices\"><b>3</b><span>　/　</span><b>4</b><span>　/　</span><b>5</b></div></div></div>","answer":"5, 1, 2, 3","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">5</span><span class=\"trace\">1</span><span class=\"trace\">2</span><span class=\"trace\">3</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 5, 1, 2, 3","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>2 · 1 · 2 · 1 · 2</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 2, 1, 2, 1, 2","marks":4}]},"Nursery|1|9|EVS":{"grade":"Nursery","term":1,"year":9,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"कप, सेब, पत्ता, आम","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) पौधे को बढ़ने के लिए क्या चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>पानी</b><span>　/　</span><b>जूता</b><span>　/　</span><b>किताब</b></div></div></div><div class=\"opt-line\">(2) पक्षी कहाँ उड़ते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>आकाश</b><span>　/　</span><b>पानी के भीतर</b><span>　/　</span><b>अलमारी</b></div></div></div><div class=\"opt-line\">(3) रात में क्या दिखाई देता है?<div class=\"tiny-options\"><div class=\"choices\"><b>चाँद</b><span>　/　</span><b>सूरज</b><span>　/　</span><b>इंद्रधनुष</b></div></div></div><div class=\"opt-line\">(4) पेड़ पर क्या लगते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>पत्ते</b><span>　/　</span><b>जूते</b><span>　/　</span><b>खिलौने</b></div></div></div></div>","answer":"पानी; आकाश; चाँद; पत्ते","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> गेंद • कमल • आम • पत्ता</p>","answer":"पत्ता, आम, कमल, गेंद","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) फूल पौधे का क्या है?</div><div class=\"opt-line\">(2) स्वस्थ रहने के लिए क्या खाएँ?</div><div class=\"opt-line\">(3) पानी को क्या करना चाहिए?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>tree/पेड़ · sun/सूर्य · mango/आम · leaf/पत्ती</b></p>","answer":"उत्तर: भाग, पौष्टिक भोजन, बचाना; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|9|Art":{"grade":"Nursery","term":1,"year":9,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>ball/गेंद · triangle/त्रिभुज · square/वर्ग</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|9|Oral":{"grade":"Nursery","term":1,"year":9,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद फल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>कक्षा की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>गेंदें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>सूरज</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>धन्यवाद</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>Good morning / सुप्रभात | I can count / मैं गिन सकता/सकती हूँ | My school / मेरा विद्यालय</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|1|10|Hindi":{"grade":"Nursery","term":1,"year":10,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">च</span><span class=\"trace\">छ</span><span class=\"trace\">ज</span><span class=\"trace\">ट</span><span class=\"trace\">प</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: च, छ, ज, ट, प","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>प</b><span>　/　</span><b>ज</b><span>　/　</span><b>ब</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>फ</b><span>　/　</span><b>ट</b><span>　/　</span><b>म</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>ब</b><span>　/　</span><b>प</b><span>　/　</span><b>न</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>म</b><span>　/　</span><b>फ</b><span>　/　</span><b>अ</b></div></div></div>","answer":"क्रम से: ज, ट, प, फ","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg> <span class=\"wide-space\">________</span>　 (फ / च)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (आ / छ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"wide-space\">________</span>　 (क / ज)</div></div>","answer":"चित्र/उत्तर: फूल — फ, आम — आ, कमल — क","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ट　→　<span class=\"blank\">_____</span>　→　फ</div><div class=\"opt-line\">प　→　<span class=\"blank\">_____</span>　→　ब</div><div class=\"opt-line\">फ　→　<span class=\"blank\">_____</span>　→　म</div></div>","answer":"बीच के अक्षर: प, फ, ब","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">प</span><span class=\"trace\">फ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>स | य | इ | थ | द</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|1|10|English":{"grade":"Nursery","term":1,"year":10,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">B</span><span class=\"trace\">C</span><span class=\"trace\">D</span><span class=\"trace\">E</span><span class=\"trace\">F</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: B, C, D, E, F","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>C</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>D</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>E</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>F</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b></div></div></div>","answer":"Circle: C, D, E, F","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>F</b><span>　/　</span><b>G</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>H</b><span>　/　</span><b>I</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>F</b><span>　/　</span><b>G</b></div></div></div>","answer":"Fish — F, House — H, Flower — F","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">H　<span class=\"blank\">_____</span>　J</div><div class=\"opt-line\">I　<span class=\"blank\">_____</span>　K</div><div class=\"opt-line\">J　<span class=\"blank\">_____</span>　L</div></div>","answer":"I, J, K","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>F</b><span>　/　</span><b>G</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b><span>　/　</span><b>J</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>G · A · F · J · H</b></p>","answer":"Teacher records recognition of own-name letter.; recognise G, A, F, J, H","marks":4}]},"Nursery|1|10|Maths":{"grade":"Nursery","term":1,"year":10,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"5, 1, 2, 3","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>3</b><span>　/　</span><b>4</b><span>　/　</span><b>5</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>4</b><span>　/　</span><b>5</b><span>　/　</span><b>1</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>1</b><span>　/　</span><b>2</b><span>　/　</span><b>3</b></div></div></div>","answer":"3, 4, 5, 1","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">3</span><span class=\"trace\">4</span><span class=\"trace\">5</span><span class=\"trace\">1</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 3, 4, 5, 1","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">1　<span class=\"blank\">_____</span>　3</div><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div></div>","answer":"4, 2, 3","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>1 · 1 · 1 · 3 · 1</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 1, 1, 1, 3, 1","marks":4}]},"Nursery|1|10|EVS":{"grade":"Nursery","term":1,"year":10,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"आम, कमल, गेंद, मछली","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) स्वस्थ रहने के लिए क्या खाएँ?<div class=\"tiny-options\"><div class=\"choices\"><b>पौष्टिक भोजन</b><span>　/　</span><b>केवल मिठाई</b><span>　/　</span><b>मिट्टी</b></div></div></div><div class=\"opt-line\">(2) पानी को क्या करना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>बचाना</b><span>　/　</span><b>व्यर्थ बहाना</b><span>　/　</span><b>गंदा करना</b></div></div></div><div class=\"opt-line\">(3) कुत्ता किस तरह का जानवर है?<div class=\"tiny-options\"><div class=\"choices\"><b>पालतू</b><span>　/　</span><b>जलचर</b><span>　/　</span><b>पक्षी</b></div></div></div><div class=\"opt-line\">(4) किताब किससे बनी होती है?<div class=\"tiny-options\"><div class=\"choices\"><b>कागज</b><span>　/　</span><b>दूध</b><span>　/　</span><b>तेल</b></div></div></div></div>","answer":"पौष्टिक भोजन; बचाना; पालतू; कागज","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> सूरज • घर • मछली • गेंद</p>","answer":"गेंद, मछली, घर, सूरज","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) हरे पौधे कहाँ उगते हैं?</div><div class=\"opt-line\">(2) गाय हमें क्या देती है?</div><div class=\"opt-line\">(3) आम क्या है?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>book/किताब · apple/सेब · mango/आम · fish/मछली</b></p>","answer":"उत्तर: मिट्टी में, दूध, फल; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|1|10|Art":{"grade":"Nursery","term":1,"year":10,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>triangle/त्रिभुज · leaf/पत्ती · ball/गेंद</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|1|10|Oral":{"grade":"Nursery","term":1,"year":10,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — अपना नाम स्पष्ट कहना","body":"<p>अध्यापक निर्देश: अपना नाम स्पष्ट कहना। उदाहरण सामग्री/संवाद: <b>मनपसंद रंग</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — चार परिचित चित्र पहचानना","body":"<p>अध्यापक निर्देश: चार परिचित चित्र पहचानना। उदाहरण सामग्री/संवाद: <b>घर की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — 1–5 वस्तुएँ गिनना","body":"<p>अध्यापक निर्देश: 1–5 वस्तुएँ गिनना। उदाहरण सामग्री/संवाद: <b>पेंसिलें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — सरल निर्देश के दो चरण पूरे करना","body":"<p>अध्यापक निर्देश: सरल निर्देश के दो चरण पूरे करना। उदाहरण सामग्री/संवाद: <b>फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — खेल के सामान साझा करना","body":"<p>अध्यापक निर्देश: खेल के सामान साझा करना। उदाहरण सामग्री/संवाद: <b>कृपया</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>My school / मेरा विद्यालय | I can count / मैं गिन सकता/सकती हूँ | Water / पानी</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|2|1|Hindi":{"grade":"Nursery","term":2,"year":1,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">उ</span><span class=\"trace\">ऊ</span><span class=\"trace\">ए</span><span class=\"trace\">ऐ</span><span class=\"trace\">ओ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: उ, ऊ, ए, ऐ, ओ","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>ओ</b><span>　/　</span><b>ए</b><span>　/　</span><b>क</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>औ</b><span>　/　</span><b>ऐ</b><span>　/　</span><b>ख</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>क</b><span>　/　</span><b>ओ</b><span>　/　</span><b>ग</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>ख</b><span>　/　</span><b>औ</b><span>　/　</span><b>घ</b></div></div></div>","answer":"क्रम से: ए, ऐ, ओ, औ","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (घ / उ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg> <span class=\"wide-space\">________</span>　 (स / ऊ)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg> <span class=\"wide-space\">________</span>　 (फ / ए)</div></div>","answer":"चित्र/उत्तर: घर — घ, सूरज — स, फूल — फ","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ऊ　→　<span class=\"blank\">_____</span>　→　ऐ</div><div class=\"opt-line\">ए　→　<span class=\"blank\">_____</span>　→　ओ</div><div class=\"opt-line\">ऐ　→　<span class=\"blank\">_____</span>　→　औ</div></div>","answer":"बीच के अक्षर: ए, ऐ, ओ","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">ओ</span><span class=\"trace\">औ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।","marks":4}]},"Nursery|2|1|English":{"grade":"Nursery","term":2,"year":1,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">E</span><span class=\"trace\">F</span><span class=\"trace\">G</span><span class=\"trace\">H</span><span class=\"trace\">I</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: E, F, G, H, I","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>F</b><span>　/　</span><b>H</b><span>　/　</span><b>I</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>G</b><span>　/　</span><b>I</b><span>　/　</span><b>J</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>H</b><span>　/　</span><b>J</b><span>　/　</span><b>K</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>I</b><span>　/　</span><b>K</b><span>　/　</span><b>L</b></div></div></div>","answer":"Circle: F, G, H, I","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>H</b><span>　/　</span><b>I</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>S</b><span>　/　</span><b>T</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>F</b><span>　/　</span><b>G</b></div></div></div>","answer":"House — H, Sun — S, Flower — F","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">G　<span class=\"blank\">_____</span>　I</div><div class=\"opt-line\">H　<span class=\"blank\">_____</span>　J</div><div class=\"opt-line\">I　<span class=\"blank\">_____</span>　K</div></div>","answer":"H, I, J","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>I</b><span>　/　</span><b>J</b><span>　/　</span><b>K</b><span>　/　</span><b>L</b><span>　/　</span><b>M</b></div>","answer":"Teacher records recognition of own-name letter.","marks":4}]},"Nursery|2|1|Maths":{"grade":"Nursery","term":2,"year":1,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg 