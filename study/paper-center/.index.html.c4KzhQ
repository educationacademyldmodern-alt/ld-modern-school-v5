=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　<span class=\"blank\">__________</span></div></div>","answer":"Sun: S, Flower: F, Cat: C, Tree: T","marks":5},{"title":"Match capital letters to small letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">A　→　<div class=\"choices\"><b>a</b><span>　/　</span><b>b</b></div></div><div class=\"opt-line\">B　→　<div class=\"choices\"><b>b</b><span>　/　</span><b>c</b></div></div><div class=\"opt-line\">C　→　<div class=\"choices\"><b>c</b><span>　/　</span><b>d</b></div></div><div class=\"opt-line\">D　→　<div class=\"choices\"><b>d</b><span>　/　</span><b>e</b></div></div></div>","answer":"A→a, B→b, C→c, D→d","marks":5},{"title":"Copy any three capital letters neatly.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">E　<span class=\"blank\">________________</span></div><div class=\"opt-line\">F　<span class=\"blank\">________________</span></div><div class=\"opt-line\">G　<span class=\"blank\">________________</span></div></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>K · F · M · T · D</b></p>","answer":"Correctly copied letters: E, F, G; recognise K, F, M, T, D","marks":5}]},"LKG|0|8|Maths":{"grade":"LKG","term":0,"year":8,"subject":"Maths","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अंक देखकर लिखिए और पढ़िए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">5　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">8　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">11　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">14　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">17　→　<span class=\"blank\">__________</span></div></div>","answer":"अंक: 5, 8, 11, 14, 17","marks":5},{"title":"खाली स्थान भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">10　<span class=\"blank\">______</span>　12</div><div class=\"opt-line\">15　<span class=\"blank\">______</span>　17</div><div class=\"opt-line\">2　<span class=\"blank\">______</span>　4</div><div class=\"opt-line\">7　<span class=\"blank\">______</span>　9</div></div>","answer":"11, 16, 3, 8","marks":5},{"title":"संख्या पहचानकर दिए अंकों में छोटे अंक को घेरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">4 और 8　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">6 और 7　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">8 और 12　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">1 और 2　→　<span class=\"blank\">_____</span></div></div>","answer":"4, 6, 8, 1","marks":5},{"title":"सही बड़ा या छोटा चिन्ह ( &gt; / &lt; / = ) भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">2　____　4</div><div class=\"opt-line\">7　____　6</div><div class=\"opt-line\">12　____　14</div><div class=\"opt-line\">17　____　16</div></div>","answer":"<, >, <, >","marks":5},{"tit