 और बिजली किस प्राकृतिक घटना में होते हैं?","ans":"Thunderstorm","ans_hi":"गरज-चमक वाला तूफान","options":[{"en":"Gravity","hi":"गुरुत्वाकर्षण"},{"en":"Condensation","hi":"संघनन"},{"en":"Melting","hi":"पिघलना"},{"en":"Thunderstorm","hi":"गरज-चमक वाला तूफान"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which organ filters blood to form urine?","hi":"रक्त छानकर मूत्र कौन-सा अंग बनाता है?","ans":"Kidneys","ans_hi":"गुर्दे","options":[{"en":"Brain","hi":"मस्तिष्क"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Heart","hi":"हृदय"},{"en":"Ears","hi":"कान"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which organ helps us hear?","hi":"सुनने में कौन-सा अंग मदद करता है?","ans":"Ears","ans_hi":"कान","options":[{"en":"Eyes","hi":"आँखें"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Small intestine","hi":"छोटी आँत"},{"en":"Ears","hi":"कान"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which process turns water into ice?","hi":"पानी के बर्फ बनने की प्रक्रिया क्या है?","ans":"Freezing","ans_hi":"जमना","options":[{"en":"Melting","hi":"पिघलना"},{"en":"Condensation","hi":"संघनन"},{"en":"Evaporation","hi":"वाष्पीकरण"},{"en":"Freezing","hi":"जमना"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What protects the brain inside the head?","hi":"सिर के भीतर मस्तिष्क की रक्षा क्या करता है?","ans":"Skull","ans_hi":"खोपड़ी","options":[{"en":"Brain","hi":"मस्तिष्क"},{"en":"Heart","hi":"हृदय"},{"en":"Eyes","hi":"आँखें"},{"en":"Skull","hi":"खोपड़ी"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"In which direction does the Sun appear to rise?","hi":"सूर्य किस दिशा में उगता हुआ दिखाई देता है?","ans":"East","ans_hi":"पूर्व","options":[{"en":"West","hi":"पश्चिम"},{"en":"South","hi":"दक्षिण"},{"en":"East","hi":"पूर्व"},{"en":"North-West","hi":"उत्