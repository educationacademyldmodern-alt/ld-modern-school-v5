ern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which process turns vapour into drops?","hi":"वाष्प से बूँदें बनने की प्रक्रिया क्या है?","ans":"Condensation","ans_hi":"संघनन","options":[{"en":"Thunderstorm","hi":"गरज-चमक वाला तूफान"},{"en":"Condensation","hi":"संघनन"},{"en":"Rain gauge","hi":"वर्षामापी"},{"en":"Sunlight","hi":"सूर्यप्रकाश"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which direction is opposite to North?","hi":"उत्तर के विपरीत कौन-सी दिशा है?","ans":"South","ans_hi":"दक्षिण","options":[{"en":"West","hi":"पश्चिम"},{"en":"South-West","hi":"दक्षिण-पश्चिम"},{"en":"South","hi":"दक्षिण"},{"en":"North-West","hi":"उत्तर-पश्चिम"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which natural event produces thunder and lightning?","hi":"गर्जन और बिजली किस प्राकृतिक घटना में होते हैं?","ans":"Thunderstorm","ans_hi":"गरज-चमक वाला तूफान","options":[{"en":"Melting","hi":"पिघलना"},{"en":"Condensation","hi":"संघनन"},{"en":"Evaporation","hi":"वाष्पीकरण"},{"en":"Thunderstorm","hi":"गरज-चमक वाला तूफान"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which organ filters blood to form urine?","hi":"रक्त छानकर मूत्र कौन-सा अंग बनाता है?","ans":"Kidneys","ans_hi":"गुर्दे","options":[{"en":"Small intestine","hi":"छोटी आँत"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Brain","hi":"मस्तिष्क"},{"en":"Ears","hi":"कान"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which direction lies between North and East?","hi":"उत्तर और पूर्व के बीच कौन-सी दिशा है?","ans":"North-East","ans_hi":"उत्तर-पूर्व","options":[{"en":"West","hi":"पश्चिम"},{"en":"North-West","hi":"उत्तर-पश्चिम"},{"en":"North-East","hi":"उत्तर-पूर्व"},{"en":"South-West","hi":"दक्षिण-पश्चिम"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 19 trees on Monday and 5 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 19 और मंगलवार को 5 पेड़ लगाए। कुल कितने पेड़?","ans":"24","ans_hi":"24","options":[{"en":"22","hi":"22"},{"en":"24","hi":"24"},{"en":"25","hi":"25"},{"en":"26","hi":"26"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 43 paper sheets and reused 12. How many were left unused?","hi":"कक्षा ने 43 कागज़ की शीट इकट्ठी कीं और 12 फिर उपयोग कीं। कितनी बचीं?","ans":"31","ans_hi":"31","options":[{"en":"43","hi":"43"},{"en":"29","hi":"29"},{"en":"32","hi":"32"},{"en":"31","hi":"31"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 11 rows with 4 flowers each. How many flowers?","hi":"बगीचे में 11 कतारें हैं और हर कतार में 4 फूल हैं। कुल कितने फूल?","ans":"44","ans_hi":"44","options":[{"en":"48","hi":"48"},{"en":"43","hi":"43"},{"en":"44","hi":"44"},{"en":"42","hi":"42"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"30 reusable bottles are shared equally among 6 groups. How many in each group?","hi":"30 दोबारा प्रयोग होने वाली बोतलें 6 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"5","ans_hi":"5","options":[{"en":"6","hi":"6"},{"en":"7","hi":"7"},{"en":"5","hi":"5"},{"en":"13","hi":"13"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 27 birds on a tree. 11 fly away. How many stay?","hi":"पेड़ पर 27 पक्षी थे, 11 उड़ गए। कितने बचे?","ans":"16","ans_hi":"16","options":[{"en":"16","hi":"16"},{"en":"32","hi":"32"},{"en":"15","hi":"15"},{"en":"27","hi":"27"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 10 pages each day for 6 days. How many pages?","hi":"विद्यार्थी 6 दिन तक रोज़ 10 पृष्ठ पढ़ता है। कुल कितने?","ans":"60","ans_hi":"60","options":[{"en":"59","hi":"59"},{"en":"50","hi":"50"},{"en":"60","hi":"60"},{"en":"61","hi":"61"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 12 litres of water a day for 4 days. How many litres?","hi":"कक्षा 4 दिनों तक प्रतिदिन 12 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"48","ans_hi":"48","options":[{"en":"54","hi":"54"},{"en":"47","hi":"47"},{"en":"46","hi":"46"},{"en":"48","hi":"48"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 35 pencils, and 15 are used. How many remain?","hi":"कुल 35 पेंसिल में 15 उपयोग हो गईं। कितनी बचीं?","ans":"20","ans_hi":"20","options":[{"en":"40","hi":"40"},{"en":"21","hi":"21"},{"en":"20","hi":"20"},{"en":"22","hi":"22"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 54 recyclable items in the morning and 12 in the evening. How many items?","hi":"टीम ने सुबह 54 और शाम 12 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"66","ans_hi":"66","options":[{"en":"65","hi":"65"},{"en":"66","hi":"66"},{"en":"80","hi":"80"},{"en":"132","hi":"132"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 39 seedlings. 16 more are planted. How many now?","hi":"पहले 39 पौध थे, 16 और लगाए गए। अब कुल कितने?","ans":"55","ans_hi":"55","options":[{"en":"110","hi":"110"},{"en":"55","hi":"55"},{"en":"56","hi":"56"},{"en":"57","hi":"57"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The school garden soil dries quickly. Which practice helps?","hi":"विद्यालय बगीचे की मिट्टी जल्दी सूखती है। क्या मदद करता है?","ans":"Water carefully near plant roots","ans_hi":"पौधों की जड़ों के पास सावधानी से पानी दें","options":[{"en":"Water carefully near plant roots","hi":"पौधों की जड़ों के पास सावधानी से पानी दें"},{"en":"Remove all soil","hi":"पूरी मिट्टी हटा दें"},{"en":"Break the plants","hi":"पौधे तोड़ें"},{"en":"Waste water on paths","hi":"पगडंडी पर पानी बहाएँ"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A confusing chart has no data source. What should you do?","hi":"अस्पष्ट चार्ट पर आँकड़ों का स्रोत न हो तो क्या करें?","ans":"Ask where the data came from","ans_hi":"पूछें आँकड़े कहाँ से आए","options":[{"en":"Hide the chart","hi":"चार्ट छिपाएँ"},{"en":"Change its numbers","hi":"आँकड़े बदल दें"},{"en":"Ask where the data came from","hi":"पूछें आँकड़े कहाँ से आए"},{"en":"Accept it without checking","hi":"बिना जाँचे मानें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"The science club wants to save energy. What should it do?","hi":"विज्ञान क्लब ऊर्जा बचाना चाहता है। क्या करे?","ans":"Switch off unused electrical devices","ans_hi":"अनुपयोगी विद्युत उपकरण बंद करे","options":[{"en":"Run fans in empty rooms","hi":"खाली कमरों में पंखे चलाए"},{"en":"Waste batteries","hi":"बैटरियाँ फेंके"},{"en":"Keep lights on all day","hi":"दिनभर लाइट जलाए"},{"en":"Switch off unused electrical devices","hi":"अनुपयोगी विद्युत उपकरण बंद करे"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which choice reduces plastic waste on a picnic?","hi":"पिकनिक में प्लास्टिक कचरा कैसे घटेगा?","ans":"Carry a reusable water bottle","ans_hi":"दोबारा भरी जा सकने वाली बोतल रखें","options":[{"en":"Use many single-use cups","hi":"कई डिस्पोज़ेबल कप लें"},{"en":"Throw wrappers in nature","hi":"रैपर प्रकृति में फेंकें"},{"en":"Buy extra plastic bags","hi":"अधिक प्लास्टिक थैलियाँ लें"},{"en":"Carry a reusable water bottle","hi":"दोबारा भरी जा सकने वाली बोतल रखें"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"What is good digital citizenship in a class group?","hi":"कक्षा समूह में अच्छा डिजिटल व्यवहार क्या है?","ans":"Use polite language and verify posts","ans_hi":"शिष्ट भाषा और जाँचकर संदेश भेजना","options":[{"en":"Spread false rumours","hi":"झूठी अफवाह फैलाना"},{"en":"Post insults","hi":"अपमान करना"},{"en":"Share classmates' secrets","hi":"सहपाठियों की गुप्त बातें भेजना"},{"en":"Use polite language and verify posts","hi":"शिष्ट भाषा और जाँचकर संदेश भेजना"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"}],"structure":"Core learning + digital/environment + applied reasoning / मूल + आधुनिक + तर्क","paper_code":"GK-3-3-09"},"3|2|10|GK":{"grade":"3","term":2,"year":10,"subject":"GK","kind":"gk","marks":50,"duration":"75 minutes / 75 मिनट","qs":[{"en":"Which city is the capital of Uttar Pradesh?","hi":"उत्तर प्रदेश की राजधानी कौन-सा शहर है?","ans":"Lucknow","ans_hi":"लखनऊ","options":[{"en":"Agra","hi":"आगरा"},{"en":"Lucknow","hi":"लखनऊ"},{"en":"Mumbai","hi":"मुंबई"},{"en":"Varanasi","hi":"वाराणसी"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"cities"},{"en":"Which state contains the city of Jaipur?","hi":"जयपुर किस राज्य में स्थित है?","ans":"Rajasthan","ans_hi":"राजस्थान","options":[{"en":"Karnataka","hi":"कर्नाटक"},{"en":"Uttar Pradesh","hi":"उत्तर प्रदेश"},{"en":"Maharashtra","hi":"महाराष्ट्र"},{"en":"Rajasthan","hi":"राजस्थान"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"states"},{"en":"Which state contains the city of Patna?","hi":"पटना किस राज्य में स्थित है?","ans":"Bihar","ans_hi":"बिहार","options":[{"en":"Uttar Pradesh","hi":"उत्तर प्रदेश"},{"en":"Kerala","hi":"केरल"},{"en":"Bihar","hi":"बिहार"},{"en":"West Bengal","hi":"पश्चिम बंगाल"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"states"},{"en":"Which ocean lies south of India?","hi":"भारत के दक्षिण में कौन-सा महासागर है?","ans":"Indian Ocean","ans_hi":"हिंद महासागर","options":[{"en":"Pacific Ocean","hi":"प्रशांत महासागर"},{"en":"Southern Ocean","hi":"दक्षिणी महासागर"},{"en":"Indian Ocean","hi":"हिंद महासागर"},{"en":"Arc