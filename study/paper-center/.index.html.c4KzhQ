cesses"},{"en":"Which gas is essential for burning?","hi":"जलने के लिए सामान्यतः कौन-सी गैस आवश्यक है?","ans":"Oxygen","ans_hi":"ऑक्सीजन","options":[{"en":"Helium","hi":"हीलियम"},{"en":"Oxygen","hi":"ऑक्सीजन"},{"en":"Ozone","hi":"ओज़ोन"},{"en":"Nitrogen","hi":"नाइट्रोजन"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which substance carries oxygen in red blood cells?","hi":"लाल रक्त कोशिकाओं में ऑक्सीजन कौन ले जाता है?","ans":"Haemoglobin","ans_hi":"हीमोग्लोबिन","options":[{"en":"Cell wall","hi":"कोशिका भित्ति"},{"en":"Haemoglobin","hi":"हीमोग्लोबिन"},{"en":"Cell","hi":"कोशिका"},{"en":"Chloroplast","hi":"हरितलवक"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which imaginary line lies near 23.5° S?","hi":"लगभग 23.5° दक्षिण अक्षांश की रेखा कौन-सी है?","ans":"Tropic of Capricorn","ans_hi":"मकर रेखा","options":[{"en":"Antarctica","hi":"अंटार्कटिका"},{"en":"Tropic of Capricorn","hi":"मकर रेखा"},{"en":"Indian Ocean","hi":"हिंद महासागर"},{"en":"Equator","hi":"भूमध्य रेखा"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which cell part regulates materials entering or leaving?","hi":"कोशिका में पदार्थों के प्रवेश-निकास को कौन नियंत्रित करता है?","ans":"Cell membrane","ans_hi":"कोशिका झिल्ली","options":[{"en":"Chloroplast","hi":"हरितलवक"},{"en":"Protein","hi":"प्रोटीन"},{"en":"Carbohydrate","hi":"कार्बोहाइड्रेट"},{"en":"Cell membrane","hi":"कोशिका झिल्ली"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which cell part contains most genetic information in many organisms?","hi":"कई जीवों की कोशिका में अधिकतर आनुवंशिक सूचना कहाँ होती है?","ans":"Nucleus","ans_hi":"केंद्रक","options":[{"en":"Carbohydrate","hi":"कार्बोहाइड्रेट"},{"en":"Cell membrane","hi":"कोशिका झिल्ली"},{"en":"Nucleus","hi":"केंद्रक"},{"en":"Chloroplast","hi":"हरितलवक"}],"correct":2,"kind":"modern","m