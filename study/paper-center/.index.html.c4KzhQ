ars","hi":"मंगल"},{"en":"Neptune","hi":"वरुण"},{"en":"Saturn","hi":"शनि"},{"en":"Mercury","hi":"बुध"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which planet is called the Red Planet?","hi":"लाल ग्रह किसे कहते हैं?","ans":"Mars","ans_hi":"मंगल","options":[{"en":"Venus","hi":"शुक्र"},{"en":"Mercury","hi":"बुध"},{"en":"Neptune","hi":"वरुण"},{"en":"Mars","hi":"मंगल"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which instrument records temperature?","hi":"तापमान कौन-सा यंत्र मापता है?","ans":"Thermometer","ans_hi":"तापमापी","options":[{"en":"Telescope","hi":"दूरबीन"},{"en":"Thermometer","hi":"तापमापी"},{"en":"Rain gauge","hi":"वर्षामापी"},{"en":"Compass","hi":"दिशासूचक"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which instrument measures wind speed?","hi":"हवा की गति कौन-सा यंत्र मापता है?","ans":"Anemometer","ans_hi":"पवनवेगमापी","options":[{"en":"Telescope","hi":"दूरबीन"},{"en":"Rain gauge","hi":"वर्षामापी"},{"en":"Anemometer","hi":"पवनवेगमापी"},{"en":"Compass","hi":"दिशासूचक"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which tool measures rainfall?","hi":"वर्षा की मात्रा कौन-सा यंत्र मापता है?","ans":"Rain gauge","ans_hi":"वर्षामापी","options":[{"en":"Anemometer","hi":"पवनवेगमापी"},{"en":"Barometer","hi":"वायुदाबमापी"},{"en":"Telescope","hi":"दूरबीन"},{"en":"Rain gauge","hi":"वर्षामापी"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What should we do with electronic waste?","hi":"इलेक्ट्रॉनिक कचरे का क्या करना चाहिए?","ans":"Give to authorised recycler","ans_hi":"अधिकृत पुनर्चक्रणकर्ता को देना","options":[{"en":"Give to authorised recycler","hi":"अधिकृत पुनर्चक्रणकर्ता को देना"},{"en":"Tell a trusted adult","hi":"विश्वसनीय बड़े को बताएँ"},{"en":"Paper","hi":"कागज़"},{"en":"Check its source 