":[{"en":"65","hi":"65"},{"en":"112","hi":"112"},{"en":"56","hi":"56"},{"en":"48","hi":"48"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 32 pencils, and 7 are used. How many remain?","hi":"कुल 32 पेंसिल में 7 उपयोग हो गईं। कितनी बचीं?","ans":"25","ans_hi":"25","options":[{"en":"25","hi":"25"},{"en":"34","hi":"34"},{"en":"23","hi":"23"},{"en":"24","hi":"24"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 31 recyclable items in the morning and 11 in the evening. How many items?","hi":"टीम ने सुबह 31 और शाम 11 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"42","ans_hi":"42","options":[{"en":"41","hi":"41"},{"en":"42","hi":"42"},{"en":"44","hi":"44"},{"en":"55","hi":"55"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 22 seedlings. 14 more are planted. How many now?","hi":"पहले 22 पौध थे, 14 और लगाए गए। अब कुल कितने?","ans":"36","ans_hi":"36","options":[{"en":"50","hi":"50"},{"en":"72","hi":"72"},{"en":"35","hi":"35"},{"en":"36","hi":"36"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student shares a photo of another child without permission. What is better?","hi":"बिना अनुमति दूसरे बच्चे का फोटो साझा हुआ। क्या उचित है?","ans":"Ask permission before sharing","ans_hi":"साझा करने से पहले अनुमति लें","options":[{"en":"Add personal details","hi":"निजी जानकारी जोड़ें"},{"en":"Ask permission before sharing","hi":"साझा करने से पहले अनुमति लें"},{"en":"Share more photos","hi":"और फोटो भेजें"},{"en":"Ignore privacy","hi":"गोपनीयता अनदेखी करें"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A viral message says school is closed, but no notice is issued. What should you do?","hi":"वायरल संदेश कहे स्कूल बंद है, पर सूचना न हो, तो क्या करें?","ans":"Check the official school notice","ans_hi":"विद्यालय की आधिकारिक सूचना जाँचें","options":[{"en":"Delete official updates","hi":"आधिकारिक सूचना हटाएँ"},{"en":"Send it to everyone","hi":"सबको भेजें"},{"en":"Check the official school notice","hi":"विद्यालय की आधिकारिक सूचना जाँचें"},{"en":"Assume it is true","hi":"उसे सच मान लें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"The science club wants to save energy. What should it do?","hi":"विज्ञान क्लब ऊर्जा बचाना चाहता है। क्या करे?","ans":"Switch off unused electrical devices","ans_hi":"अनुपयोगी विद्युत उपकरण बंद करे","options":[{"en":"Waste batteries","hi":"बैटरियाँ फेंके"},{"en":"Keep lights on all day","hi":"दिनभर लाइट जलाए"},{"en":"Switch off unused electrical devices","hi":"अनुपयोगी विद्युत उपकरण बंद करे"},{"en":"Run fans in empty rooms","hi":"खाली कमरों में पंखे चलाए"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"How should students check an unusual online fact?","hi":"अजीब ऑनलाइन तथ्य की जाँच कैसे करें?","ans":"Compare reliable sources","ans_hi":"विश्वसनीय स्रोतों की तुलना करें","options":[{"en":"Ignore dates and authors","hi":"तारीख और लेखक अनदेखे करें"},{"en":"Use only rumours","hi":"केवल अफवाह सुनें"},{"en":"Compare reliable sources","hi":"विश्वसनीय स्रोतों की तुलना करें"},{"en":"Believe the first website","hi":"पहली वेबसाइट पर भरोसा करें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A rainwater tank is overflowing. What is a sensible response?","hi":"वर्षाजल की टंकी से पानी बह रहा हो तो क्या करें?","ans":"Tell an adult to fix the overflow","ans_hi":"किसी बड़े को बताकर निकास ठीक कराएँ","options":[{"en":"Tell an adult to fix the overflow","hi":"किसी बड़े को बताकर निकास ठीक कराएँ"},{"en":"Contaminate the water","hi":"पानी गंदा करें"},{"en":"Break the pipe","hi":"पाइप तोड़ दें"},{"en":"Ignore for weeks","hi":"हफ्तों अनदेखा करें"}],"correct":0,"kind":"case","marks":1