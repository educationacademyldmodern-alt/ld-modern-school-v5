[{"en":"4","hi":"4"},{"en":"10","hi":"10"},{"en":"8","hi":"8"},{"en":"6","hi":"6"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"4 reusable bottles are shared equally among 2 groups. How many in each group?","hi":"4 दोबारा प्रयोग होने वाली बोतलें 2 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"2","ans_hi":"2","options":[{"en":"0","hi":"0"},{"en":"3","hi":"3"},{"en":"2","hi":"2"},{"en":"4","hi":"4"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 9 birds on a tree. 2 fly away. How many stay?","hi":"पेड़ पर 9 पक्षी थे, 2 उड़ गए। कितने बचे?","ans":"7","ans_hi":"7","options":[{"en":"14","hi":"14"},{"en":"9","hi":"9"},{"en":"7","hi":"7"},{"en":"5","hi":"5"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 3 pages each day for 2 days. How many pages?","hi":"विद्यार्थी 2 दिन तक रोज़ 3 पृष्ठ पढ़ता है। कुल कितने?","ans":"6","ans_hi":"6","options":[{"en":"12","hi":"12"},{"en":"5","hi":"5"},{"en":"3","hi":"3"},{"en":"6","hi":"6"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 2 litres of water a day for 2 days. How many litres?","hi":"कक्षा 2 दिनों तक प्रतिदिन 2 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"4","ans_hi":"4","options":[{"en":"2","hi":"2"},{"en":"8","hi":"8"},{"en":"5","hi":"5"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 7 pencils, and 4 are used. How many remain?","hi":"कुल 7 पेंसिल में 4 उपयोग हो गईं। कितनी बचीं?","ans":"3","ans_hi":"3","options":[{"en":"2","hi":"2"},{"en":"4","hi":"4"},{"en":"6","hi":"6"},{"en":"3","hi":"3"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 5 recyclable items in the morning and 2 in the evening. How many items?","hi":"टीम ने सुबह 5 और शाम 2 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"7","ans_hi":"7","options":[{"en":"5","hi":"5"},{"en":"6","hi":"6"},{"en":"7","hi":"7"},{"en":"11","hi":"11"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 4 seedlings. 4 more are planted. How many now?","hi":"पहले 4 पौध थे, 4 और लगाए गए। अब कुल कितने?","ans":"8","ans_hi":"8","options":[{"en":"10","hi":"10"},{"en":"16","hi":"16"},{"en":"9","hi":"9"},{"en":"8","hi":"8"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"Your friend falls while playing. What is the kind first step?","hi":"खेलते समय मित्र गिर जाए तो पहला अच्छा कदम क्या है?","ans":"Call a teacher and help","ans_hi":"शिक्षक को बुलाएँ और सहायता करें","options":[{"en":"Run away without telling","hi":"बिना बताए भाग जाएँ"},{"en":"Push the friend again","hi":"फिर धक्का दें"},{"en":"Laugh at the friend","hi":"मित्र पर हँसें"},{"en":"Call a teacher and help","hi":"शिक्षक को बुलाएँ और सहायता करें"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"You need to wash hands before lunch. What do you use?","hi":"भोजन से पहले हाथ धोने के लिए क्या उपयोग करें?","ans":"Soap and clean water","ans_hi":"साबुन और स्वच्छ पानी","options":[{"en":"A dirty cloth","hi":"गंदा कपड़ा"},{"en":"Soap and clean water","hi":"साबुन और स्वच्छ पानी"},{"en":"Only coloured paint","hi":"केवल रंग"},{"en":"Only dry soil","hi":"केवल सूखी मिट्टी"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action keeps the classroom clean?","hi":"कक्षा को साफ रखने के लिए क्या करें?","ans":"Use the dustbin","ans_hi":"कूड़ादान प्रयोग करें","options":[{"en":"Use the dustbin","hi":"कूड़ादान प्रयोग करें"},{"en":"Drop wrappers on floor","hi":"रैपर नीचे फेंकें"},{"en":"Mark desks with pen","hi":"मेज़ पर लिखें"},{"en":"Scatter papers","hi":"कागज़ बिखेरें"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action protects a garden sapling?","hi":"बगीचे के छोटे पौधे को किससे बचाया जा सकता है?","ans":"Avoid stepping on it","ans_hi":"उस पर पैर न रखें","options":[{"en":"Avoid stepping on it","hi":"उस पर पैर न रखें"},{"en":"Break its stem","hi":"तना तोड़ें"},{"en":"Cover it with litter","hi":"उस पर कूड़ा डालें"},{"en":"Pull its leaves","hi":"पत्तियाँ नोचें"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"The pedestrian light shows red. What should you do?","hi":"पैदल यात्री का सिग्नल लाल हो तो क्या करें?","ans":"Wait for the safe crossing signal","ans_hi":"सुरक्षित सिग्नल की प्रतीक्षा करें","options":[{"en":"Wait for the safe crossing signal","hi":"सुरक्षित सिग्नल की प्रतीक्षा करें"},{"en":"Ignore road markings","hi":"चिह्न अनदेखे करें"},{"en":"Run onto the road","hi":"सड़क पर दौड़ पड़ें"},{"en":"Close your eyes and cross","hi":"आँख बंद कर पार करें"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"}],"structure":"Core learning + digital/environment + applied reasoning / मूल + आधुनिक + तर्क","paper_code":"GK-1-3-02"},"1|2|3|GK":{"grade":"1","term":2,"year":3,"subject":"GK","kind":"gk","marks":50,"duration":"60 minutes / 60 मिनट","qs":[{"en":"What is the capital of India?","hi":"भारत की राजधानी क्या है?","ans":"New Delhi","ans_hi":"नई दिल्ली","options":[{"en":"Varanasi","hi":"वाराणसी"},{"en":"Patna","hi":"पटना"},{"en":"New Delhi","hi":"नई दिल्ली"},{"en":"Lucknow","hi":"लखनऊ"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"cities"},{"en":"What is the name of our country?","hi":"हमारे देश का नाम क्या है?","ans":"India","ans_hi":"भारत","options":[{"en":"Sri Lanka","hi":"श्रीलंका"},{"en":"India","hi":"भारत"},{"en":"Bhutan","hi":"भूटान"},{"en":"Nepal","hi":"नेपाल"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"c