height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"3, 4, 5, 6","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　<div class=\"choices\"><b>