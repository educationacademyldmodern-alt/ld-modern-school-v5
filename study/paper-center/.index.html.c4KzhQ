"तापमापी"},{"en":"Magnifying glass","hi":"आवर्धक काँच"},{"en":"Clock","hi":"घड़ी"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which machine is used to print pages?","hi":"पृष्ठ छापने की मशीन कौन-सी है?","ans":"Printer","ans_hi":"प्रिंटर","options":[{"en":"Camera","hi":"कैमरा"},{"en":"Printer","hi":"प्रिंटर"},{"en":"Clock","hi":"घड़ी"},{"en":"Keyboard","hi":"कीबोर्ड"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which device has keys for typing letters?","hi":"अक्षर टाइप करने वाला उपकरण कौन-सा है?","ans":"Keyboard","ans_hi":"कीबोर्ड","options":[{"en":"Compass","hi":"दिशासूचक यंत्र"},{"en":"Thermometer","hi":"तापमापी"},{"en":"Magnifying glass","hi":"आवर्धक काँच"},{"en":"Keyboard","hi":"कीबोर्ड"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which instrument shows direction?","hi":"दिशा कौन-सा यंत्र बताता है?","ans":"Compass","ans_hi":"दिशासूचक यंत्र","options":[{"en":"Printer","hi":"प्रिंटर"},{"en":"Monitor","hi":"मॉनिटर"},{"en":"Camera","hi":"कैमरा"},{"en":"Compass","hi":"दिशासूचक यंत्र"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which plant part supports the leaves?","hi":"पौधे का कौन-सा भाग पत्तियों को सहारा देता है?","ans":"Stem","ans_hi":"तना","options":[{"en":"Leaves","hi":"पत्तियाँ"},{"en":"Flower","hi":"फूल"},{"en":"Roots","hi":"जड़ें"},{"en":"Stem","hi":"तना"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which material covers many tree trunks?","hi":"कई वृक्षों के तनों को बाहर से क्या ढकता है?","ans":"Bark","ans_hi":"छाल","options":[{"en":"Leaves","hi":"पत्तियाँ"},{"en":"Roots","hi":"जड़ें"},{"en":"Fruit","hi":"फल"},{"en":"Bark","hi":"छाल"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Who puts out fires?","hi":"आग कौन बुझाता है?","ans":"Firefighter","ans_hi":"अग्निशामक कर्मी","options":[{"en":"Painter","hi":"रंगकर्मी"},{"en":"Bus driver","hi":"बस चालक"},{"en":"Dentist","hi":"दंत चिकित्सक"},{"en":"Firefighter","hi":"अग्निशामक कर्मी"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which device shows images from a computer?","hi":"कंप्यूटर की तस्वीरें कौन-सा उपकरण दिखाता है?","ans":"Monitor","ans_hi":"मॉनिटर","options":[{"en":"Clock","hi":"घड़ी"},{"en":"Camera","hi":"कैमरा"},{"en":"Printer","hi":"प्रिंटर"},{"en":"Monitor","hi":"मॉनिटर"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 12 trees on Monday and 7 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 12 और मंगलवार को 7 पेड़ लगाए। कुल कितने पेड़?","ans":"19","ans_hi":"19","options":[{"en":"17","hi":"17"},{"en":"21","hi":"21"},{"en":"19","hi":"19"},{"en":"38","hi":"38"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 19 paper sheets and reused 5. How many were left unused?","hi":"कक्षा ने 19 कागज़ की शीट इकट्ठी कीं और 5 फिर उपयोग कीं। कितनी बचीं?","ans":"14","ans_hi":"14","options":[{"en":"13","hi":"13"},{"en":"14","hi":"14"},{"en":"28","hi":"28"},{"en":"12","hi":"12"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 8 rows with 4 flowers each. How many flowers?","hi":"बगीचे में 8 कतारें हैं और हर कतार में 4 फूल हैं। कुल कितने फूल?","ans":"32","ans_hi":"32","options":[{"en":"64","hi":"64"},{"en":"24","hi":"24"},{"en":"32","hi":"32"},{"en":"31","hi":"31"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"24 reusable bottles are shared equally among 3 groups. How many in each group?","hi":"24 दोबारा प्रयोग होने वाली बोतलें 3 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"8","ans_hi":"8","options":[{"en":"13","hi":"13"},{"en":"8","hi":"8"},{"en":"10","hi":"10"},{"en":"11","hi":"11"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 22 birds on a tree. 7 fly away. How many stay?","hi":"पेड़ पर 22 पक्षी थे, 7 उड़ गए। कितने बचे?","ans":"15","ans_hi":"15","options":[{"en":"15","hi":"15"},{"en":"17","hi":"17"},{"en":"14","hi":"14"},{"en":"16","hi":"16"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 6 pages each day for 2 days. How many pages?","hi":"विद्यार्थी 2 दिन तक रोज़ 6 पृष्ठ पढ़ता है। कुल कितने?","ans":"12","ans_hi":"12","options":[{"en":"13","hi":"13"},{"en":"10","hi":"10"},{"en":"12","hi":"12"},{"en":"16","hi":"16"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 7 litres of water a day for 4 days. How many litres?","hi":"कक्षा 4 दिनों तक प्रतिदिन 7 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"28","ans_hi":"28","options":[{"en":"34","hi":"34"},{"en":"56","hi":"56"},{"en":"26","hi":"26"},{"en":"28","hi":"28"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 22 pencils, and 8 are used. How many remain?","hi":"कुल 22 पेंसिल में 8 उपयोग हो गईं। कितनी बचीं?","ans":"14","ans_hi":"14","options":[{"en":"14","hi":"14"},{"en":"16","hi":"16"},{"en":"24","hi":"24"},{"en":"22","hi":"22"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 11 recyclable items in the morning and 8 in the evening. How many items?","hi":"टीम ने सुबह 11 और शाम 8 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"19","ans_hi":"19","options":[{"en":"20","hi":"20"},{"en":"8","hi":"8"},{"en":"19","hi":"19"},{"en":"27","hi":"27"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 19 seedlings. 4 more are planted. How many now?","hi":"पहले 19 पौध थे, 4 और लगाए गए। अब कुल कितने?","ans":"23","ans_hi":"23","options":[{"en":"4","hi":"4"},{"en":"22","hi":"22"},{"en":"25","hi":"25"},{"en":"23","hi":"23"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"You find another child's ID card. What should you do?","hi":"आपको दूसरे बच्चे का पहचानपत्र मिले तो क्या करें?","ans":"Give it to a teacher","ans_hi":"उसे शिक्षक को दें","options":[{"en":"Throw it away","hi":"फेंक दें"},{"en":"Post the photo online","hi":"उसका फोटो ऑनलाइन डालें"},{"en":"Give it to a teacher","hi":"उसे शिक्षक को दें"},{"en":"Keep it secretly","hi":"चुपके से रख लें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action protects a garden sapling?","hi":"बगीचे के छोटे पौधे को किससे बचाया जा सकता है?","ans":"Avoid stepping on it","ans_hi":"उस पर पैर न रखें","options":[{"en":"Break its stem","hi":"तना तोड़ें"},{"en":"Avoid stepping on it","hi":"उस पर पैर न रखें"},{"en":"Cover it with litter","hi":"उस पर कूड़ा डालें"},{"en":"Pull its leaves","hi":"पत्तियाँ नोचें"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action keeps the classroom clean?","hi":"कक्षा को साफ रखने के लिए क्या करें?","ans":"Use the dustbin","ans_hi":"कूड़ादान प्रयोग करें","options":[{"en":"Mark desks with pen","hi":"मेज़ पर लिखें"},{"en":"Scatter papers","hi":"कागज़ बिखेरें"},{"en":"Drop wrappers on floor","hi":"रैपर नीचे फेंकें"},{"en":"Use the dustbin","hi":"कूड़ादान प्रयोग करें"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A stranger sends a link promising free toys. What should you do?","hi":"अनजान व्यक्ति मुफ्त खिलौनों का लिंक भेजे तो क्या करें?","ans":"Ask a trusted adult before opening","ans_hi":"खोलने से पहले विश्वसनीय बड़े से पूछें","options":[{"en":"Forward without checking","hi":"बिना जाँचे आगे