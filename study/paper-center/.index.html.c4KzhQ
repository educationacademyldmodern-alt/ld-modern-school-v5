","options":[{"en":"Tropic of Capricorn","hi":"मकर रेखा"},{"en":"Equator","hi":"भूमध्य रेखा"},{"en":"Tropic of Cancer","hi":"कर्क रेखा"},{"en":"Antarctica","hi":"अंटार्कटिका"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which online behaviour protects privacy?","hi":"ऑनलाइन गोपनीयता किस व्यवहार से सुरक्षित रहती है?","ans":"Limit personal information","ans_hi":"निजी जानकारी सीमित रखना","options":[{"en":"Limit personal information","hi":"निजी जानकारी सीमित रखना"},{"en":"Use refillable bottles","hi":"दोबारा भरी जाने वाली बोतलें"},{"en":"Check author and date","hi":"लेखक और तारीख जाँचें"},{"en":"Do not open it","hi":"उसे न खोलना"}],"correct":0,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which gas makes up most of Earth's atmosphere?","hi":"पृथ्वी के वायुमंडल में कौन-सी गैस सबसे अधिक है?","ans":"Nitrogen","ans_hi":"नाइट्रोजन","options":[{"en":"Nitrogen","hi":"नाइट्रोजन"},{"en":"Helium","hi":"हीलियम"},{"en":"Carbon dioxide","hi":"कार्बन डाइऑक्साइड"},{"en":"Oxygen","hi":"ऑक्सीजन"}],"correct":0,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which cell part contains most genetic information in many organisms?","hi":"कई जीवों की कोशिका में अधिकतर आनुवंशिक सूचना कहाँ होती है?","ans":"Nucleus","ans_hi":"केंद्रक","options":[{"en":"Carbohydrate","hi":"कार्बोहाइड्रेट"},{"en":"Nucleus","hi":"केंद्रक"},{"en":"Cell","hi":"कोशिका"},{"en":"Protein","hi":"प्रोटीन"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which gas is used by plants in photosynthesis?","hi":"प्रकाश-संश्लेषण में पौधे कौन-सी गैस लेते हैं?","ans":"Carbon dioxide","ans_hi":"कार्बन डाइऑक्साइड","options":[{"en":"Nitrogen","hi":"नाइट्रोजन"},{"en":"Helium","hi":"हीलियम"},{"en":"Ozone","hi":"ओज़ोन"},{"en":"Carbon dioxide","hi":"कार्बन डाइऑक्साइड"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 111 trees on Monday and 27 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 111 और मंगलवार को 27 पेड़ लगाए। कुल कितने पेड़?","ans":"138","ans_hi":"138","options":[{"en":"138","hi":"138"},{"en":"165","hi":"165"},{"en":"167","hi":"167"},{"en":"139","hi":"139"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 117 paper sheets and reused 16. How many were left unused?","hi":"कक्षा ने 117 कागज़ की शीट इकट्ठी कीं और 16 फिर उपयोग कीं। कितनी बचीं?","ans":"101","ans_hi":"101","options":[{"en":"119","hi":"119"},{"en":"101","hi":"101"},{"en":"102","hi":"102"},{"en":"99","hi":"99"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 21 rows with 4 flowers each. How many flowers?","hi":"बगीचे में 21 कतारें हैं और हर कतार में 4 फूल हैं। कुल कितने फूल?","ans":"84","ans_hi":"84","options":[{"en":"90","hi":"90"},{"en":"84","hi":"84"},{"en":"88","hi":"88"},{"en":"86","hi":"86"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"186 reusable bottles are shared equally among 6 groups. How many in each group?","hi":"186 दोबारा प्रयोग होने वाली बोतलें 6 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"31","ans_hi":"31","options":[{"en":"33","hi":"33"},{"en":"30","hi":"30"},{"en":"31","hi":"31"},{"en":"37","hi":"37"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 99 birds on a tree. 17 fly away. How many stay?","hi":"पेड़ पर 99 पक्षी थे, 17 उड़ गए। कितने बचे?","ans":"82","ans_hi":"82","options":[{"en":"82","hi":"82"},{"en":"84","hi":"84"},{"en":"99","hi":"99"},{"en":"101","hi":"101"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 25 pages each day for 5 days. How many pages?","hi":"विद्यार्थी 5 दिन तक रोज़ 25 पृष्ठ पढ़ता है। कुल कितने?","ans":"125","ans_hi":"125","options":[{"en":"125","hi":"125"},{"en":"127","hi":"127"},{"en":"132","hi":"132"},{"en":"250","hi":"250"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 14 litres of water a day for 7 days. How many litres?","hi":"कक्षा 7 दिनों तक प्रतिदिन 14 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"98","ans_hi":"98","options":[{"en":"107","hi":"107"},{"en":"98","hi":"98"},{"en":"84","hi":"84"},{"en":"196","hi":"196"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 102 pencils, and 36 are used. How many remain?","hi":"कुल 102 पेंसिल में 36 उपयोग हो गईं। कितनी बचीं?","ans":"66","ans_hi":"66","options":[{"en":"102","hi":"102"},{"en":"66","hi":"66"},{"en":"68","hi":"68"},{"en":"104","hi":"104"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 173 recyclable items in the morning and 31 in the evening. How many items?","hi":"टीम ने सुबह 173 और शाम 31 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"204","ans_hi":"204","options":[{"en":"204","hi":"204"},{"en":"203","hi":"203"},{"en":"206","hi":"206"},{"en":"408","hi":"408"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 108 seedlings. 15 more are planted. How many now?","hi":"पहले 108 पौध थे, 15 और लगाए गए। अब कुल कितने?","ans":"123","ans_hi":"123","options":[{"en":"123","hi":"123"},{"en":"125","hi":"125"},{"en":"246","hi":"246"},{"en":"138","hi":"138"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"An AI chatbot gives a medical fact without a source. What is responsible?","hi":"AI चैटबॉट चिकित्सा तथ्य बिना स्रोत दे तो क्या उचित है?","ans":"Verify with reliable sources and an adult","ans_hi":"विश्वसनीय स्रोत व बड़े से पुष्टि करें","options":[{"en":"Forward it as advice","hi":"सलाह बताकर फैलाएँ"},{"en":"Ignore experts","hi":"विशेषज्ञ को अनदेखा करें"},{"en":"Verify with reliable sources and an adult","hi":"विश्वसनीय स्रोत व बड़े से पुष्टि करें"},{"en":"Treat it as certain","hi":"बिना जाँच पूर्ण सच मान लें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which school project supports local biodiversity?","hi":"कौन-सी विद्यालय परियोजना स्थानीय जैव विविधता बचाएगी?","ans":"Grow and protect native plants","ans_hi":"स्थानीय पौधे उगाना और बचाना","options":[{"en":"Use litter as compost without sorting","hi":"बिना छाँटे कूड़ा डालना"},{"en":"Remove all small plants","hi":"सारे छोटे पौधे उखाड़ना"},{"en":"Destroy insect habitats","hi":"कीट आवास नष्ट करना"},{"en":"Grow and protect native plants","hi":"स्थानीय पौधे उगाना और बचाना"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A chart claims one medicine cures all illnesses. What is best?","hi":"चार्ट दावा करे एक दवा सभी रोग ठीक करती है। क्या उचित है?","ans":"Check with qualified health professionals","ans_hi":"योग्य स्वास्थ्य विशेषज्ञों से जाँचें","options":[{"en":"Accept as science","hi":"विज्ञान मान लें"},{"en":"Check with qualified health professionals","hi":"योग्य स्वास्थ्य विशेषज्ञों से जाँचें"},{"en":"Use without guidance","hi":"बिना सलाह उपयोग करें"},{"en":"Share as certain cure","hi":"पक्का उपचार बताकर फैलाएँ"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A presentation contains a copied photo. What should a student do?","hi":"प्रस्तुति में दूसरे का फोटो लिया गया हो तो क्या करें?","ans":"Credit the creator and check permission","ans_hi":"रचनाकार को श्रेय दें और अनुमति देखें","options":[{"en":"Claim personal ownership","hi":"अपना बताएं"},{"en":"Ignore permissions","hi":"अनुमति अनदेखी करें"},{"en":"Credit the creator and check permission","hi":"रचनाकार को श्रेय दें और अनुमति देखें"},{"en":"Erase a