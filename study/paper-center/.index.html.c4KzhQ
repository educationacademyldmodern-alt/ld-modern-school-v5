:"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which body part helps us hold a pencil?","hi":"शरीर के किस अंग से हम पेंसिल पकड़ते हैं?","ans":"Hand","ans_hi":"हाथ","options":[{"en":"Nose","hi":"नाक"},{"en":"Hand","hi":"हाथ"},{"en":"Eyes","hi":"आँखें"},{"en":"Teeth","hi":"दाँत"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What shines in the daytime sky?","hi":"दिन में आकाश में क्या चमकता है?","ans":"Sun","ans_hi":"सूर्य","options":[{"en":"Clouds","hi":"बादल"},{"en":"Sun","hi":"सूर्य"},{"en":"Moon","hi":"चंद्रमा"},{"en":"Wind","hi":"हवा"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Where do we learn with teachers?","hi":"हम अध्यापकों के साथ कहाँ पढ़ते हैं?","ans":"School","ans_hi":"विद्यालय","options":[{"en":"Library","hi":"पुस्तकालय"},{"en":"Market","hi":"बाज़ार"},{"en":"School","hi":"विद्यालय"},{"en":"Zoo","hi":"चिड़ियाघर"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which place lends us books?","hi":"कौन-सा स्थान किताबें उधार देता है?","ans":"Library","ans_hi":"पुस्तकालय","options":[{"en":"Zoo","hi":"चिड़ियाघर"},{"en":"Library","hi":"पुस्तकालय"},{"en":"Playground","hi":"खेल का मैदान"},{"en":"Hospital","hi":"अस्पताल"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What do we breathe to stay alive?","hi":"जीवित रहने के लिए हम क्या साँस में लेते हैं?","ans":"Air","ans_hi":"वायु","options":[{"en":"Air","hi":"वायु"},{"en":"Sun","hi":"सूर्य"},{"en":"Clouds","hi":"बादल"},{"en":"Plant","hi":"पौधा"}],"correct":0,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which body part helps us hear?","hi":"शरीर का कौन-सा अंग सुनने में सहायता करता है?","ans":"Ears","ans_hi":"कान","options":[{"en":"Teeth","hi":"दाँत"},{"en":"Ears","hi":"कान"},{"en":"Legs","hi":"पैर"},{"en":"Eyes","hi":"आँखें"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What removes dirt from hands when washing?","hi":"हाथ धोते समय गंदगी हटाने के लिए क्या उपयोगी है?","ans":"Soap","ans_hi":"साबुन","options":[{"en":"Soap","hi":"साबुन"},{"en":"Eraser","hi":"रबड़"},{"en":"Lamp","hi":"लैंप"},{"en":"Helmet","hi":"हेलमेट"}],"correct":0,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Where are many animals cared for and displayed?","hi":"कई जानवरों की देखभाल करके उन्हें कहाँ दिखाया जाता है?","ans":"Zoo","ans_hi":"चिड़ियाघर","options":[{"en":"Hospital","hi":"अस्पताल"},{"en":"Library","hi":"पुस्तकालय"},{"en":"Zoo","hi":"चिड़ियाघर"},{"en":"Post office","hi":"डाकघर"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 4 trees on Monday and 6 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 4 और मंगलवार को 6 पेड़ लगाए। कुल कितने पेड़?","ans":"10","ans_hi":"10","options":[{"en":"11","hi":"11"},{"en":"10","hi":"10"},{"en":"12","hi":"12"},{"en":"6","hi":"6"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 5 paper sheets and reused 3. How many were left unused?","hi":"कक्षा ने 5 कागज़ की शीट इकट्ठी कीं और 3 फिर उपयोग कीं। कितनी बचीं?","ans":"2","ans_hi":"2","options":[{"en":"3","hi":"3"},{"en":"4","hi":"4"},{"en":"2","hi":"2"},{"en":"7","hi":"7"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 3 rows with 3 flowers each. How many flowers?","hi":"बगीचे में 3 कतारें हैं और हर कतार में 3 फूल हैं। कुल कितने फूल?","ans":"9","ans_hi":"9","options":[{"en":"18","hi":"18"},{"en":"9","hi":"9"},{"en":"14","hi":"14"},{"en":"8","hi":"8"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"6 reusable bottles are shared equally among 2 groups. How many in each group?","hi":"6 दोबारा प्रयोग होने वाली बोतलें 2 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"3","ans_hi":"3","options":[{"en":"4","hi":"4"},{"en":"5","hi":"5"},{"en":"3","hi":"3"},{"en":"6","hi":"6"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 7 birds on a tree. 3 fly away. How many stay?","hi":"पेड़ पर 7 पक्षी थे, 3 उड़ गए। कितने बचे?","ans":"4","ans_hi":"4","options":[{"en":"8","hi":"8"},{"en":"3","hi":"3"},{"en":"5","hi":"5"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 4 pages each day for 3 days. How many pages?","hi":"विद्यार्थी 3 दिन तक रोज़ 4 पृष्ठ पढ़ता है। कुल कितने?","ans":"12","ans_hi":"12","options":[{"en":"11","hi":"11"},{"en":"12","hi":"12"},{"en":"14","hi":"14"},{"en":"13","hi":"13"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 4 litres of water a day for 2 days. How many litres?","hi":"कक्षा 2 दिनों तक प्रतिदिन 4 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"8","ans_hi":"8","options":[{"en":"16","hi":"16"},{"en":"6","hi":"6"},{"en":"9","hi":"9"},{"en":"8","hi":"8"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 7 pencils, and 5 are used. How many remain?","hi":"कुल 7 पेंसिल में 5 उपयोग हो गईं। कितनी बचीं?","ans":"2","ans_hi":"2","options":[{"en":"3","hi":"3"},{"en":"1","hi":"1"},{"en":"7","hi":"7"},{"en":"2","hi":"2"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 8 recyclable items in the morning and 4 in the evening. How many items?","hi":"टीम ने सुबह 8 और शाम 4 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"12","ans_hi":"12","options":[{"en":"24","hi":"24"},{"en":"14","hi":"14"},{"en":"13","hi":"13"},{"en":"12","hi":"12"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 3 seedlings. 1 more are planted. How many now?","hi":"पहले 3 पौध थे, 1 और लगाए गए। अब कुल कितने?","ans":"4","ans_hi":"4","options":[{"en":"6","hi":"6"},{"en":"1","hi":"1"},{"en":"2","hi":"2"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A classmate is sad. Which response shows kindness?","hi":"सहपाठी उदास हो तो कौन-सा व्यवहार अच्छा है?","ans":"Listen kindly and offer help","ans_hi":"प्यार से सुनें और मदद करें","options":[{"en":"Listen kindly and offer help","hi":"प्यार से सुनें और मदद करें"},{"en":"Spread rumours","hi":"अफवाह फैलाएँ"},{"en":"Call them names","hi":"बुरे नाम से बुलाएँ"},{"en":"Ignore them always","hi":"हमेशा अनदेखा करें"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Someone is being teased unfairly in class. What is right?","hi":"कक्षा में किसी को अनुचित रूप से चिढ़ाया जा रहा है। क्या सही है?","ans":"Support them and tell a teacher","ans_hi":"उसका साथ दें और शिक्षक को बताएँ","options":[{"en":"Record and mock them","hi":"वीडियो बनाकर मज़ाक करें"},{"en":"Keep encouraging teasing","hi":"चिढ़ाना बढ़ाएँ"},{"en":"Support them and tell a teacher","hi":"उसका साथ दें और शिक्षक को बताएँ"},{"en":"Join in teasing","hi":"चिढ़ाने में शामिल हों"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"You find another child's ID card. What should you do?","hi":"आपको दूसरे बच्चे का पहचानपत्र मिले तो क्या करें?","ans":"Give it to a teacher","ans_hi":"उसे शिक्षक को दें","options":[{"en":"Give it to a teacher","hi":"उसे शिक्षक को दें"},{"en":"Throw it away","hi":"फेंक दें"},{"en":"Post the photo online","hi":"उसका फोटो ऑनलाइन डालें"},{"en":"Keep it secretly","hi":"चुपके से रख लें"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action protects a garden sapling?","hi":"ब