बगीचे में 4 कतारें हैं और हर कतार में 3 फूल हैं। कुल कितने फूल?","ans":"12","ans_hi":"12","options":[{"en":"15","hi":"15"},{"en":"11","hi":"11"},{"en":"12","hi":"12"},{"en":"24","hi":"24"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"8 reusable bottles are shared equally among 2 groups. How many in each group?","hi":"8 दोबारा प्रयोग होने वाली बोतलें 2 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"4","ans_hi":"4","options":[{"en":"4","hi":"4"},{"en":"5","hi":"5"},{"en":"6","hi":"6"},{"en":"2","hi":"2"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 5 birds on a tree. 4 fly away. How many stay?","hi":"पेड़ पर 5 पक्षी थे, 4 उड़ गए। कितने बचे?","ans":"1","ans_hi":"1","options":[{"en":"1","hi":"1"},{"en":"7","hi":"7"},{"en":"0","hi":"0"},{"en":"2","hi":"2"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 4 pages each day for 3 days. How many pages?","hi":"विद्यार्थी 3 दिन तक रोज़ 4 पृष्ठ पढ़ता है। कुल कितने?","ans":"12","ans_hi":"12","options":[{"en":"13","hi":"13"},{"en":"24","hi":"24"},{"en":"11","hi":"11"},{"en":"12","hi":"12"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 2 litres of water a day for 2 days. How many litres?","hi":"कक्षा 2 दिनों तक प्रतिदिन 2 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"4","ans_hi":"4","options":[{"en":"8","hi":"8"},{"en":"5","hi":"5"},{"en":"4","hi":"4"},{"en":"6","hi":"6"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 9 pencils, and 5 are used. How many remain?","hi":"कुल 9 पेंसिल में 5 उपयोग हो गईं। कितनी बचीं?","ans":"4","ans_hi":"4","options":[{"en":"2","hi":"2"},{"en":"6","hi":"6"},{"en":"3","hi":"3"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 9 recyclable items in the morning and 1 in the evening. How many items?","hi":"टीम ने सुबह 9 और शाम 1 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"10","ans_hi":"10","options":[{"en":"10","hi":"10"},{"en":"1","hi":"1"},{"en":"13","hi":"13"},{"en":"12","hi":"12"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 3 seedlings. 3 more are planted. How many now?","hi":"पहले 3 पौध थे, 3 और लगाए गए। अब कुल कितने?","ans":"6","ans_hi":"6","options":[{"en":"4","hi":"4"},{"en":"8","hi":"8"},{"en":"6","hi":"6"},{"en":"5","hi":"5"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"Your friend falls while playing. What is the kind first step?","hi":"खेलते समय मित्र गिर जाए तो पहला अच्छा कदम क्या है?","ans":"Call a teacher and help","ans_hi":"शिक्षक को बुलाएँ और सहायता करें","options":[{"en":"Laugh at the friend","hi":"मित्र पर हँसें"},{"en":"Run away without telling","hi":"बिना बताए भाग जाएँ"},{"en":"Call a teacher and help","hi":"शिक्षक को बुलाएँ और सहायता करें"},{"en":"Push the friend again","hi":"फिर धक्का दें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"An unknown player asks for your home address. What should you do?","hi":"ऑनलाइन अनजान खिलाड़ी घर का पता माँगे तो क्या करें?","ans":"Do not share; tell a trusted adult","ans_hi":"पता न दें; विश्वसनीय बड़े को बताएँ","options":[{"en":"Send it in chat","hi":"चैट में भेज दें"},{"en":"Do not share; tell a trusted adult","hi":"पता न दें; विश्वसनीय बड़े को बताएँ"},{"en":"Give your school password too","hi":"स्कूल का पासवर्ड भी दें"},{"en":"Post the address publicly","hi":"पता सबको दिखाएँ"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A stranger sends a link promising free toys. What should you do?","hi":"अनजान व्यक्ति मुफ्त खिलौनों