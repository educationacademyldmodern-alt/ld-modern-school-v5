width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>10</b><span>　/　</span><b>1</b><span>　/　</span><b>2</b></div></div></div>","answer":"7, 8, 9, 10","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">7</span><span class=\"trace\">8</span><span class=\"trace\">9</span><span class=\"trace\">10</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 7, 8, 9, 10","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">2　<span class=\"blank\">_____</span>　4</div><div class=\"opt-line\">3　<span class=\"blank\">_____</span>　5</div><div class=\"opt-line\">4　<span class=\"blank\">_____</span>　6</div></div>","answer":"3, 4, 5","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>7 · 5 · 4 · 2 · 10</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 7, 5, 4, 2, 10","marks":4}]},"Nursery|3|10|EVS":{"grade":"Nursery","term":3,"year":10,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"चाँद, छाता, कार, कप","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) अगर कोई चोट लगे तो किसे बताएँ?<div class=\"tiny-options\"><div class=\"choices\"><b>विश्वसनीय बड़े को</b><span>　/　</span><b>किसी को नहीं</b><span>　/　</span><b>अजनबी को</b></div></div></div><div class=\"opt-line\">(2) गर्मी में कौन से कपड़े आरामदायक?<div class=\"tiny-options\"><div class=\"choices\"><b>हल्के सूती</b><span>　/　</span><b>बहुत भारी ऊनी</b><span>　/　</span><b>गीले कपड़े</b></div></div></div><div class=\"opt-line\">(3) पैदल सड़क कहाँ पार करें?<div class=\"tiny-options\"><div class=\"choices\"><b>ज़ेब्रा क्रॉसिंग पर</b><span>　/　</span><b>मोड़ के बीच</b><span>　/　</span><b>बिना देखे</b></div></div></div><div class=\"opt-line\">(4) दूध किससे मिलता है?<div class=\"tiny-options\"><div class=\"choices\"><b>गाय/भैंस</b><span>　/　</span><b>बस</b><span>　/　</span><b>पेड़</b></div></div></div></div>","answer":"विश्वसनीय बड़े को; हल्के सूती; ज़ेब्रा क्रॉसिंग पर; गाय/भैंस","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> किताब • पेड़ • बिल्ली • फूल</p>","answer":"फूल, बिल्ली, पेड़, किताब","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) हाथ के कितने पंजे होते हैं?</div><div class=\"opt-line\">(2) स्वच्छ पानी का उपयोग?</div><div class=\"opt-line\">(3) किसान कौन सा काम करता है?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>sun/सूर्य · banana/केला · book/किताब · water/पानी</b></p>","answer":"उत्तर: दो, पीना, फसल उगाता है; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|3|10|Art":{"grade":"Nursery","term":3,"year":10,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>star/तारा · circle/गोला · sun/सूर्य</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|3|10|Oral":{"grade":"Nursery","term":3,"year":10,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — कहानी सुनकर प्रश्न समझना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न समझना। उदाहरण सामग्री/संवाद: <b>मनपसंद रंग</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — रंग/आकृति पहचानना","body":"<p>अध्यापक निर्देश: रंग/आकृति पहचानना। उदाहरण सामग्री/संवाद: <b>घर की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — आयु-अनुसार गिनती/जोड़","body":"<p>अध्यापक निर्देश: आयु-अनुसार गिनती/जोड़। उदाहरण सामग्री/संवाद: <b>पेंसिलें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — स्वच्छता की एक आदत बताना","body":"<p>अध्यापक निर्देश: स्वच्छता की एक आदत बताना। उदाहरण सामग्री/संवाद: <b>फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — साथियों से सहयोग करना","body":"<p>अध्यापक निर्देश: साथियों से सहयोग करना। उदाहरण सामग्री/संवाद: <b>कृपया</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>My teacher / मेरे शिक्षक | Share toys / खिलौने बाँटना | Water / पानी</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"LKG|0|1|Hindi":{"grade":"LKG","term":0,"year":1,"subject":"Hindi","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अक्षरों को सुंदर लिखावट में दो-दो बार लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">अ</span><span class=\"trace\">आ</span><span class=\"trace\">इ</span><span class=\"trace\">ई</span><span class=\"trace\">उ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षर: अ, आ, इ, ई, उ","marks":5},{"title":"चित्र देखकर उसका पहला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"blank\">________</span></div></div>","answer":"आम → आ, कमल → क, गेंद → ग, घर → घ","marks":5},{"title":"स्वर और व्यंजन देखकर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">आ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">इ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ई : <span class=\"blank\">________________</span></div><div class=\"opt-line\">उ : <span class=\"blank\">________________</span></div></div>","answer":"अक्षर सही लिखना।","marks":5},{"title":"खाली स्थान में सही अगला अक्षर भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">उ　 <span class=\"blank\">_____</span>　ए</div><div class=\"opt-line\">ऊ　 <span class=\"blank\">_____</span>　ऐ</div><div class=\"opt-line\">ए　 <span class=\"blank\">_____</span>　ओ</div><div class=\"opt-line\">ऐ　 <span class=\"blank\">_____</span>　औ</div></div>","answer":"ऊ, ए, ऐ, ओ","marks":5},{"title":"नीचे लिखे अक्षरों को पढ़कर कोई तीन अक्षर लिखिए।","body":"<p class=\"spaced\"><div class=\"choices\"><b>ऐ</b><span>　/　</span><b>ओ</b><span>　/　</span><b>औ</b><span>　/　</span><b>क</b></div></p><div class=\"answer-lines\"><i></i><i></i><i></i></div>","answer":"चार में से कोई तीन सही अक्षर।","marks":5}]},"LKG|0|1|English":{"grade":"LKG","term":0,"year":1,"subject":"English","marks":25,"duration":"35–40 मिनट","qs":[{"title":"Write small letters for these capital letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><b>A</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>B</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>C</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>D</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>E</b>　→　<span class=\"blank\">__________</span></div></div>","answer":"a, b, c, d, e","marks":5},{"title":"Fill in the missing alphabet.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">A　<span class=\"blank\">____</span>　C</div><div class=\"opt-line\">B　<span class=\"blank\">____</span>　D</div><div class=\"opt-line\">C　<span class=\"blank\">____</span>　E</div><div class=\"opt-line\">D　<span class=\"blank\">____</span>　F</div></div>","answer":"B, C, D, E","marks":5},{"title":"Write the first English letter of each picture.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">__________</span></div></div>","answer":"Mango: M, Lotus: L, Ball: B, Fish: F","marks":5},{"title":"Match capital letters to small letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">F　→　<div class=\"choices\"><b>f</b><span>　/　</span><b>g</b></div></div><div class=\"opt-line\">G　→　<div class=\"choices\"><b>g</b><span>　/　</span><b>h</b></div></div><div class=\"opt-line\">H　→　<div class=\"choices\"><b>h</b><span>　/　</span><b>i</b></div></div><div class=\"opt-line\">I　→　<div class=\"choices\"><b>i</b><span>　/　</span><b>j</b></div></div></div>","answer":"F→f, G→g, H→h, I→i","marks":5},{"title":"Copy any three capital letters neatly.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">J　<span class=\"blank\">________________</span></div><div class=\"opt-line\">K　<span class=\"blank\">________________</span></div><div class=\"opt-line\">L　<span class=\"blank\">________________</span></div></div>","answer":"Correctly copied letters: J, K, L","marks":5}]},"LKG|0|1|Maths":{"grade":"LKG","term":0,"year":1,"subject":"Maths","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अंक देखकर लिखिए और पढ़िए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">4　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">7　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">10　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">13　→　<span class=\"blank\">__________</span></div></div>","answer":"अंक: 1, 4, 7, 10, 13","marks":5},{"title":"खाली स्थान भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1　<span class=\"blank\">______</span>　3</div><div class=\"opt-line\">6　<span class=\"blank\">______</span>　8</div><div class=\"opt-line\">11　<span class=\"blank\">______</span>　13</div><div class=\"opt-line\">16　<span class=\"blank\">______</span>　18</div></div>","answer":"2, 7, 12, 17","marks":5},{"title":"संख्या पहचानकर दिए अंकों में छोटे अंक को घेरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1 और 2　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">3 और 7　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">5 और 6　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">7 और 11　→　<span class=\"blank\">_____</span></div></div>","answer":"1, 3, 5, 7","marks":5},{"title":"सही बड़ा या छोटा चिन्ह ( &gt; / &lt; / = ) भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1　____　3</div><div class=\"opt-line\">6　____　5</div><div class=\"opt-line\">11　____　13</div><div class=\"opt-line\">16　____　15</div></div>","answer":"<, >, <, >","marks":5},{"title":"गिनकर संख्या लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div></div>","answer":"2, 3, 4","marks":5}]},"LKG|0|1|EVS":{"grade":"LKG","term":0,"year":1,"subject":"EVS","marks":25,"duration":"35–40 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"आम, कमल, गेंद, मछली","marks":5},{"title":"सही उत्तर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) शरीर के किस अंग से देखते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>आँख</b><span>　/　</span><b>कान</b><span>　/　</span><b>पैर</b></div></div></div><div class=\"opt-line\">(2) सुनने के लिए क्या उपयोग होता है?<div class=\"tiny-options\"><div class=\"choices\"><b>कान</b><span>　/　</span><b>आँख</b><span>　/　</span><b>हाथ</b></div></div></div><div class=\"opt-line\">(3) सूँघने के लिए क्या उपयोग होता है?<div class=\"tiny-options\"><div class=\"choices\"><b>नाक</b><span>　/　</span><b>पैर</b><span>　/　</span><b>कान</b></div></div></div><div class=\"opt-line\">(4) दाँत साफ किससे करते हैं?<div class=\"tiny-options\"><div class=\"choices\"><b>ब्रश</b><span>　/　</span><b>कंघी</b><span>　/　</span><b>जूता</b></div></div></div></div>","answer":"आँख; कान; नाक; ब्रश","marks":5},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":5},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> पेड़ • बिल्ली • फूल • सूरज</p>","answer":"सूरज, फूल, बिल्ली, पेड़","marks":5},{"title":"एक/दो शब्दों में उत्तर दीजिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) स्कूल में कौन पढ़ाता है? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(2) सूर्य कब दिखाई देता है? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(3) घर में हमें कौन प्यार करता है? <span class=\"blank\">______________________</span></div></div>","answer":"उत्तर: शिक्षक, दिन, परिवार","marks":5}]},"LKG|0|1|Art":{"grade":"LKG","term":0,"year":1,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।","marks":4}]},"LKG|0|1|Oral":{"grade":"LKG","term":0,"year":1,"subject":"Oral","marks":25,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — 5 अक्षर/letters पहचानना","body":"<p>अध्यापक निर्देश: 5 अक्षर/letters पहचानना। उदाहरण सामग्री/संवाद: <b>मनपसंद फल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 2 — नाम और एक पसंद बताना","body":"<p>अध्यापक निर्देश: नाम और एक पसंद बताना। उदाहरण सामग्री/संवाद: <b>कक्षा की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 3 — 1–20 वस्तु संख्या मिलाना","body":"<p>अध्यापक निर्देश: 1–20 वस्तु संख्या मिलाना। उदाहरण सामग्री/संवाद: <b>गेंदें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 4 — कहानी सुनकर प्रश्न बताना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न बताना। उदाहरण सामग्री/संवाद: <b>सूरज</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 5 — एक आकृति खींचना","body":"<p>अध्यापक निर्देश: एक आकृति खींचना। उदाहरण सामग्री/संवाद: <b>धन्यवाद</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5}]},"LKG|0|2|Hindi":{"grade":"LKG","term":0,"year":2,"subject":"Hindi","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अक्षरों को सुंदर लिखावट में दो-दो बार लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">ई</span><span class=\"trace\">उ</span><span class=\"trace\">ऊ</span><span class=\"trace\">ए</span><span class=\"trace\">ऐ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षर: ई, उ, ऊ, ए, ऐ","marks":5},{"title":"चित्र देखकर उसका पहला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg> <span class=\"blank\">________</span></div></div>","answer":"घर → घ, किताब → क, चाँद → च, छाता → छ","marks":5},{"title":"स्वर और व्यंजन देखकर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">उ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ऊ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ए : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ऐ : <span class=\"blank\">________________</span></div></div>","answer":"अक्षर सही लिखना।","marks":5},{"title":"खाली स्थान में सही अगला अक्षर भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ऐ　 <span class=\"blank\">_____</span>　औ</div><div class=\"opt-line\">ओ　 <span class=\"blank\">_____</span>　क</div><div class=\"opt-line\">औ　 <span class=\"blank\">_____</span>　ख</div><div class=\"opt-line\">क　 <span class=\"blank\">_____</span>　ग</div></div>","answer":"ओ, औ, क, ख","marks":5},{"title":"नीचे लिखे अक्षरों को पढ़कर कोई तीन अक्षर लिखिए।","body":"<p class=\"spaced\"><div class=\"choices\"><b>क</b><span>　/　</span><b>ख</b><span>　/　</span><b>ग</b><span>　/　</span><b>घ</b></div></p><div class=\"answer-lines\"><i></i><i></i><i></i></div>","answer":"चार में से कोई तीन सही अक्षर।","marks":5}]},"LKG|0|2|English":{"grade":"LKG","term":0,"year":2,"subject":"English","marks":25,"duration":"35–40 मिनट","qs":[{"title":"Write small letters for these capital letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><b>D</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>E</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>F</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>G</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>H</b>　→　<span class=\"blank\">__________</span></div></div>","answer":"d, e, f, g, h","marks":5},{"title":"Fill in the missing alphabet.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">D　<span class=\"blank\">____</span>　F</div><div class=\"opt-line\">E　<span class=\"blank\">____</span>　G</div><div class=\"opt-line\">F　<span class=\"blank\">____</span>　H</div><div class=\"opt-line\">G　<span class=\"blank\">____</span>　I</div></div>","answer":"E, F, G, H","marks":5},{"title":"Write the first English letter of each picture.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">__________</span></div></div>","answer":"Fish: F, House: H, Sun: S, Flower: F","marks":5},{"title":"Match capital letters to small letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">I　→　<div class=\"choices\"><b>i</b><span>　/　</span><b>j</b></div></div><div class=\"opt-line\">J　→　<div class=\"choices\"><b>j</b><span>　/　</span><b>k</b></div></div><div class=\"opt-line\">K　→　<div class=\"choices\"><b>k</b><span>　/　</span><b>l</b></div></div><div class=\"opt-line\">L　→　<div class=\"choices\"><b>l</b><span>　/　</span><b>m</b></div></div></div>","answer":"I→i, J→j, K→k, L→l","marks":5},{"title":"Copy any three capital letters neatly.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">M　<span class=\"blank\">________________</span></div><div class=\"opt-line\">N　<span class=\"blank\">________________</span></div><div class=\"opt-line\">O　<span class=\"blank\">________________</span></div></div>","answer":"Correctly copied letters: M, N, O","marks":5}]},"LKG|0|2|Maths":{"grade":"LKG","term":0,"year":2,"subject":"Maths","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अंक देखकर लिखिए और पढ़िए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">13　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">16　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">19　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">2　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">5　→　<span class=\"blank\">__________</span></div></div>","answer":"अंक: 13, 16, 19, 2, 5","marks":5},{"title":"खाली स्थान भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">10　<span class=\"blank\">______</span>　12</div><div class=\"opt-line\">15　<span class=\"blank\">______</span>　17</div><div class=\"opt-line\">2　<span class=\"blank\">______</span>　4</div><div class=\"opt-line\">7　<span class=\"blank\">______</span>　9</div></div>","answer":"11, 16, 3, 8","marks":5},{"title":"संख्या पहचानकर दिए अंकों में छोटे अंक को घेरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">4 और 8　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">6 और 7　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">8 और 12　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">1 और 2　→　<span class=\"blank\">_____</span></div></div>","answer":"4, 6, 8, 1","marks":5},{"title":"सही बड़ा या छोटा चिन्ह ( &gt; / &lt; / = ) भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">4　____　6</div><div class=\"opt-line\">9　____　8</div><div class=\"opt-line\">14　____　16</div><div class=\"opt-line\">19　____　18</div></div>","answer":"<, >, <, >","marks":5},{"title":"गिनकर संख्या लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div></div>","answer":"5, 6, 2","marks":5}]},"LKG|0|2|EVS":{"grade":"LKG","term":0,"year":2,"subject":"EVS","marks":25,"duration":"35–40 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"मछली, घर, सूरज, फूल","marks":5},{"title":"सही उत्तर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) सूर्य कब दिखाई देता है?<div class=\"tiny-options\"><div class=\"choices\"><b>दिन</b><span>　/　</span><b>रात</b><span>　/　</span><b>आधी रात</b></div></div></div><div class=\"opt-line\">(2) घर में हमें कौन प्यार करता है?<div class=\"tiny-options\"><div class=\"choices\"><b>परिवार</b><span>　/　</span><b>गाड़ी</b><span>　/　</span><b>पेड़</b></div></div></div><div class=\"opt-line\">(3) हरी घास का रंग क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>हरा</b><span>　/　</span><b>लाल</b><span>　/　</span><b>नीला</b></div></div></div><div class=\"opt-line\">(4) आसमान का सामान्य रंग क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>नीला</b><span>　/　</span><b>पीला</b><span>　/　</span><b>काला</b></div></div></div></div>","answer":"दिन; परिवार; हरा; नीला","marks":5},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">खाने से पहले हाथ धोना अच्छा है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें कूड़ा सड़क पर फेंकना चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":5},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> छाता • चाँद • किताब • पेड़</p>","answer":"पेड़, किताब, चाँद, छाता","marks":5},{"title":"एक/दो शब्दों में उत्तर दीजिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) बारिश में क्या लेते हैं? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(2) सेब क्या है? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(3) कक्षा को कैसा रखना चाहिए? <span class=\"blank\">______________________</span></div></div>","answer":"उत्तर: छाता, फल, साफ","marks":5}]},"LKG|0|2|Art":{"grade":"LKG","term":0,"year":2,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"kite\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 12L82 42 50 76 18 42Z M50 12v64 M18 42h64 M50 76q-15 6 -9 16 q13 -6 9 -16\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।","marks":4}]},"LKG|0|2|Oral":{"grade":"LKG","term":0,"year":2,"subject":"Oral","marks":25,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — 5 अक्षर/letters पहचानना","body":"<p>अध्यापक निर्देश: 5 अक्षर/letters पहचानना। उदाहरण सामग्री/संवाद: <b>मनपसंद रंग</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 2 — नाम और एक पसंद बताना","body":"<p>अध्यापक निर्देश: नाम और एक पसंद बताना। उदाहरण सामग्री/संवाद: <b>घर की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 3 — 1–20 वस्तु संख्या मिलाना","body":"<p>अध्यापक निर्देश: 1–20 वस्तु संख्या मिलाना। उदाहरण सामग्री/संवाद: <b>पेंसिलें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 4 — कहानी सुनकर प्रश्न बताना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न बताना। उदाहरण सामग्री/संवाद: <b>फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 5 — एक आकृति खींचना","body":"<p>अध्यापक निर्देश: एक आकृति खींचना। उदाहरण सामग्री/संवाद: <b>कृपया</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5}]},"LKG|0|3|Hindi":{"grade":"LKG","term":0,"year":3,"subject":"Hindi","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अक्षरों को सुंदर लिखावट में दो-दो बार लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">ए</span><span class=\"trace\">ऐ</span><span class=\"trace\">ओ</span><span class=\"trace\">औ</span><span class=\"trace\">क</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षर: ए, ऐ, ओ, औ, क","marks":5},{"title":"चित्र देखकर उसका पहला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"blank\">________</span></div></div>","answer":"छाता → छ, कार → क, कप → क, आम → आ","marks":5},{"title":"स्वर और व्यंजन देखकर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">ऐ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ओ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">औ : <span class=\"blank\">________________</span></div><div class=\"opt-line\">क : <span class=\"blank\">________________</span></div></div>","answer":"अक्षर सही लिखना।","marks":5},{"title":"खाली स्थान में सही अगला अक्षर भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">क　 <span class=\"blank\">_____</span>　ग</div><div class=\"opt-line\">ख　 <span class=\"blank\">_____</span>　घ</div><div class=\"opt-line\">ग　 <span class=\"blank\">_____</span>　च</div><div class=\"opt-line\">घ　 <span class=\"blank\">_____</span>　छ</div></div>","answer":"ख, ग, घ, च","marks":5},{"title":"नीचे लिखे अक्षरों को पढ़कर कोई तीन अक्षर लिखिए।","body":"<p class=\"spaced\"><div class=\"choices\"><b>घ</b><span>　/　</span><b>च</b><span>　/　</span><b>छ</b><span>　/　</span><b>ज</b></div></p><div class=\"answer-lines\"><i></i><i></i><i></i></div>","answer":"चार में से कोई तीन सही अक्षर।","marks":5}]},"LKG|0|3|English":{"grade":"LKG","term":0,"year":3,"subject":"English","marks":25,"duration":"35–40 मिनट","qs":[{"title":"Write small letters for these capital letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><b>G</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>H</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>I</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>J</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>K</b>　→　<span class=\"blank\">__________</span></div></div>","answer":"g, h, i, j, k","marks":5},{"title":"Fill in the missing alphabet.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">G　<span class=\"blank\">____</span>　I</div><div class=\"opt-line\">H　<span class=\"blank\">____</span>　J</div><div class=\"opt-line\">I　<span class=\"blank\">____</span>　K</div><div class=\"opt-line\">J　<span class=\"blank\">____</span>　L</div></div>","answer":"H, I, J, K","marks":5},{"title":"Write the first English letter of each picture.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　<span class=\"blank\">__________</span></div></div>","answer":"Flower: F, Cat: C, Tree: T, Book: B","marks":5},{"title":"Match capital letters to small letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">L　→　<div class=\"choices\"><b>l</b><span>　/　</span><b>m</b></div></div><div class=\"opt-line\">M　→　<div class=\"choices\"><b>m</b><span>　/　</span><b>n</b></div></div><div class=\"opt-line\">N　→　<div class=\"choices\"><b>n</b><span>　/　</span><b>o</b></div></div><div class=\"opt-line\">O　→　<div class=\"choices\"><b>o</b><span>　/　</span><b>p</b></div></div></div>","answer":"L→l, M→m, N→n, O→o","marks":5},{"title":"Copy any three capital letters neatly.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">P　<span class=\"blank\">________________</span></div><div class=\"opt-line\">Q　<span class=\"blank\">________________</span></div><div class=\"opt-line\">R　<span class=\"blank\">________________</span></div></div>","answer":"Correctly copied letters: P, Q, R","marks":5}]},"LKG|0|3|Maths":{"grade":"LKG","term":0,"year":3,"subject":"Maths","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अंक देखकर लिखिए और पढ़िए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">5　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">8　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">11　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">14　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">17　→　<span class=\"blank\">__________</span></div></div>","answer":"अंक: 5, 8, 11, 14, 17","marks":5},{"title":"खाली स्थान भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1　<span class=\"blank\">______</span>　3</div><div class=\"opt-line\">6　<span class=\"blank\">______</span>　8</div><div class=\"opt-line\">11　<span class=\"blank\">______</span>　13</div><div class=\"opt-line\">16　<span class=\"blank\">______</span>　18</div></div>","answer":"2, 7, 12, 17","marks":5},{"title":"संख्या पहचानकर दिए अंकों में छोटे अंक को घेरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">7 और 8　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">9 और 13　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">2 और 3　→　<span class=\"blank\">_____</span></div><div class=\"opt-line\">4 और 8　→　<span class=\"blank\">_____</span></div></div>","answer":"7, 9, 2, 4","marks":5},{"title":"सही बड़ा या छोटा चिन्ह ( &gt; / &lt; / = ) भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">7　____　9</div><div class=\"opt-line\">12　____　11</div><div class=\"opt-line\">17　____　19</div><div class=\"opt-line\">2　____　1</div></div>","answer":"<, >, <, >","marks":5},{"title":"गिनकर संख्या लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><circle cx=\"10\" cy=\"10\" r=\"6\"/></g></svg></span>　 <span class=\"blank\">______</span></div></div>","answer":"3, 4, 5","marks":5}]},"LKG|0|3|EVS":{"grade":"LKG","term":0,"year":3,"subject":"EVS","marks":25,"duration":"35–40 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cat\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42L22 18 42 32 Q50 28 58 32 L78 18 76 42 Q90 69 70 79 Q50 87 30 79 Q10 69 24 42 Z\"/><circle cx=\"40\" cy=\"55\" r=\"3\"/><circle cx=\"60\" cy=\"55\" r=\"3\"/><path d=\"M46 66h8l-4 4z M25 64L8 59 M25 69L8 69 M75 64l17 -5 M75 69h17\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"फूल, बिल्ली, पेड़, किताब","marks":5},{"title":"सही उत्तर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) सेब क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>फल</b><span>　/　</span><b>जानवर</b><span>　/　</span><b>खिलौना</b></div></div></div><div class=\"opt-line\">(2) कक्षा को कैसा रखना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>साफ</b><span>　/　</span><b>गंदा</b><span>　/　</span><b>गीला</b></div></div></div><div class=\"opt-line\">(3) हमें रोज क्या करना चाहिए?<div class=\"tiny-options\"><div class=\"choices\"><b>नहाना</b><span>　/　</span><b>झूठ बोलना</b><span>　/　</span><b>कूड़ा फेंकना</b></div></div></div><div class=\"opt-line\">(4) लाल रंग किसका होता है?<div class=\"tiny-options\"><div class=\"choices\"><b>टमाटर</b><span>　/　</span><b>आसमान</b><span>　/　</span><b>घास</b></div></div></div></div>","answer":"फल; साफ; नहाना; टमाटर","marks":5},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">स्कूल में सबकी सहायता करनी चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें रोज दाँत साफ नहीं करने चाहिए। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":5},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> सेब • कप • कार • छाता</p>","answer":"छाता, कार, कप, सेब","marks":5},{"title":"एक/दो शब्दों में उत्तर दीजिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) सुनने के लिए क्या उपयोग होता है? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(2) सूँघने के लिए क्या उपयोग होता है? <span class=\"blank\">______________________</span></div><div class=\"opt-line\">(3) दाँत साफ किससे करते हैं? <span class=\"blank\">______________________</span></div></div>","answer":"उत्तर: कान, नाक, ब्रश","marks":5}]},"LKG|0|3|Art":{"grade":"LKG","term":0,"year":3,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"flower\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"37\" r=\"10\"/><ellipse cx=\"50\" cy=\"18\" rx=\"10\" ry=\"12\"/><ellipse cx=\"31\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"69\" cy=\"32\" rx=\"12\" ry=\"10\"/><ellipse cx=\"37\" cy=\"53\" rx=\"11\" ry=\"10\"/><ellipse cx=\"63\" cy=\"53\" rx=\"11\" ry=\"10\"/><path d=\"M50 48v38 M50 72q-17 -22 -23 -8 q5 18 23 15 M50 69q15 -17 24 -11 q-4 16 -24 18\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"kite\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 12L82 42 50 76 18 42Z M50 12v64 M18 42h64 M50 76q-15 6 -9 16 q13 -6 9 -16\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।","marks":4}]},"LKG|0|3|Oral":{"grade":"LKG","term":0,"year":3,"subject":"Oral","marks":25,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — 5 अक्षर/letters पहचानना","body":"<p>अध्यापक निर्देश: 5 अक्षर/letters पहचानना। उदाहरण सामग्री/संवाद: <b>मनपसंद खिलौना</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 2 — नाम और एक पसंद बताना","body":"<p>अध्यापक निर्देश: नाम और एक पसंद बताना। उदाहरण सामग्री/संवाद: <b>बगीचे की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 3 — 1–20 वस्तु संख्या मिलाना","body":"<p>अध्यापक निर्देश: 1–20 वस्तु संख्या मिलाना। उदाहरण सामग्री/संवाद: <b>ढक्कन</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 4 — कहानी सुनकर प्रश्न बताना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न बताना। उदाहरण सामग्री/संवाद: <b>घर</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5},{"title":"गतिविधि 5 — एक आकृति खींचना","body":"<p>अध्यापक निर्देश: एक आकृति खींचना। उदाहरण सामग्री/संवाद: <b>नमस्ते</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":5}]},"LKG|0|4|Hindi":{"grade":"LKG","term":0,"year":4,"subject":"Hindi","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अक्षरों को सुंदर लिखावट में दो-दो बार लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">औ</span><span class=\"trace\">क</span><span class=\"trace\">ख</span><span class=\"trace\">ग</span><span class=\"trace\">घ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षर: औ, क, ख, ग, घ","marks":5},{"title":"चित्र देखकर उसका पहला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"ball\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"32\"/><path d=\"M20 42q30 -24 60 0 M22 65q28 -24 56 0 M50 18q-24 30 0 64 M50 18q24 30 0 64\"/></g></svg> <span class=\"blank\">________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"48\" height=\"48\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"blank\">________</span></div></div>","answer":"आम → आ, कमल → क, गेंद → ग, घर → घ","marks":5},{"title":"स्वर और व्यंजन देखकर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">क : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ख : <span class=\"blank\">________________</span></div><div class=\"opt-line\">ग : <span class=\"blank\">________________</span></div><div class=\"opt-line\">घ : <span class=\"blank\">________________</span></div></div>","answer":"अक्षर सही लिखना।","marks":5},{"title":"खाली स्थान में सही अगला अक्षर भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">घ　 <span class=\"blank\">_____</span>　छ</div><div class=\"opt-line\">च　 <span class=\"blank\">_____</span>　ज</div><div class=\"opt-line\">छ　 <span class=\"blank\">_____</span>　झ</div><div class=\"opt-line\">ज　 <span class=\"blank\">_____</span>　ट</div></div>","answer":"च, छ, ज, झ","marks":5},{"title":"नीचे लिखे अक्षरों को पढ़कर कोई तीन अक्षर लिखिए।","body":"<p class=\"spaced\"><div class=\"choices\"><b>ज</b><span>　/　</span><b>झ</b><span>　/　</span><b>ट</b><span>　/　</span><b>ठ</b></div></p><div class=\"answer-lines\"><i></i><i></i><i></i></div>","answer":"चार में से कोई तीन सही अक्षर।","marks":5}]},"LKG|0|4|English":{"grade":"LKG","term":0,"year":4,"subject":"English","marks":25,"duration":"35–40 मिनट","qs":[{"title":"Write small letters for these capital letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><b>J</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>K</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>L</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>M</b>　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\"><b>N</b>　→　<span class=\"blank\">__________</span></div>