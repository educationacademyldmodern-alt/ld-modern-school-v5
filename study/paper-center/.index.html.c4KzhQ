i":"साबुन और स्वच्छ पानी"},{"en":"A dirty cloth","hi":"गंदा कपड़ा"},{"en":"Only dry soil","hi":"केवल सूखी मिट्टी"},{"en":"Only coloured paint","hi":"केवल रंग"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Which action protects a garden sapling?","hi":"बगीचे के छोटे पौधे को किससे बचाया जा सकता है?","ans":"Avoid stepping on it","ans_hi":"उस पर पैर न रखें","options":[{"en":"Pull its leaves","hi":"पत्तियाँ नोचें"},{"en":"Avoid stepping on it","hi":"उस पर पैर न रखें"},{"en":"Cover it with litter","hi":"उस पर कूड़ा डालें"},{"en":"Break its stem","hi":"तना तोड़ें"}],"correct":1,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A tap is left running after use. What is the best action?","hi":"उपयोग के बाद नल खुला रह गया। क्या करें?","ans":"Turn it off safely","ans_hi":"सुरक्षित रूप से नल बंद करें","options":[{"en":"Waste more water","hi":"और पानी बहाएँ"},{"en":"Leave it running","hi":"चलने दें"},{"en":"Turn it off safely","hi":"सुरक्षित रूप से नल बंद करें"},{"en":"Break the tap","hi":"नल तोड़ दें"}],"correct":2,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"A classmate is sad. Which response shows kindness?","hi":"सहपाठी उदास हो तो कौन-सा व्यवहार अच्छा है?","ans":"Listen kindly and offer help","ans_hi":"प्यार से सुनें और मदद करें","options":[{"en":"Spread rumours","hi":"अफवाह फैलाएँ"},{"en":"Ignore them always","hi":"हमेशा अनदेखा करें"},{"en":"Call them names","hi":"बुरे नाम से बुलाएँ"},{"en":"Listen kindly and offer help","hi":"प्यार से सुनें और मदद करें"}],"correct":3,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"},{"en":"Someone is being teased unfairly in class. What is right?","hi":"कक्षा में किसी को अनुचित रूप से चिढ़ाया जा रहा है। क्या सही है?","ans":"Support them and tell a teacher","ans_hi":"उसका साथ दें और शिक्षक को बताएँ","options":[{"en":"Support them and tell a teacher","hi":"उसका साथ दें और शिक्षक को बताएँ"},{"en":"Join in teasing","hi":"चिढ़ाने में शामिल हों"},{"en":"Record and mock them","hi":"वीडियो बनाकर मज़ाक करें"},{"en":"Keep encouraging teasing","hi":"चिढ़ाना बढ़ाएँ"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"}],"structure":"Core learning + digital/environment + applied reasoning / मूल + आधुनिक + तर्क","paper_code":"GK-2-4-10"},"3|0|1|GK":{"grade":"3","term":0,"year":1,"subject":"GK","kind":"gk","marks":50,"duration":"75 minutes / 75 मिनट","qs":[{"en":"Which nutrient helps build and repair body tissues?","hi":"शरीर के ऊतकों को बनाने और सुधारने में कौन-सा पोषक तत्त्व मदद करता है?","ans":"Protein","ans_hi":"प्रोटीन","options":[{"en":"Protein","hi":"प्रोटीन"},{"en":"Fibre","hi":"रेशा"},{"en":"Vitamin C","hi":"विटामिन सी"},{"en":"Iron","hi":"आयरन"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"food"},{"en":"Which mineral is important for strong bones and teeth?","hi":"मजबूत हड्डियों और दाँतों के लिए कौन-सा खनिज आवश्यक है?","ans":"Calcium","ans_hi":"कैल्शियम","options":[{"en":"Calcium","hi":"कैल्शियम"},{"en":"Fat","hi":"वसा"},{"en":"Iron","hi":"आयरन"},{"en":"Vitamin D","hi":"विटामिन डी"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"food"},{"en":"What is the process of changing water to water vapour called?","hi":"पानी के जलवाष्प बनने की प्रक्रिया क्या कहलाती है?","ans":"Evaporation","ans_hi":"वाष्पीकरण","options":[{"en":"Sublimation","hi":"उर्ध्वपातन"},{"en":"Evaporation","hi":"वाष्पीकरण"},{"en":"Photosynthesis","hi":"प्रकाश-संश्लेषण"},{"en":"Pollination","hi":"परागण"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"processes"},{"en":"What is the opposite process of evaporation called?","hi":"जलवाष्प के द्रव पानी में बदलने की प्रक्रिया क्या कहलाती है?","ans":"Condensation","ans_hi":"संघनन","options":[{"en":"Fermentation","hi":"किण्वन"},{"en":"Condensation","hi":"संघनन"},{"en":"Sublimation","hi":"उर्ध्वपातन"},{"en":"Evaporation","hi":"वाष्पीकरण"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"processes"},{"en":"What do we call substances needed by the body from food?","hi":"खाद्य पदार्थों से शरीर को मिलने वाले आवश्यक तत्त्व क्या कहलाते हैं?","ans":"Nutrients","ans_hi":"पोषक तत्त्व","options":[{"en":"Germs","hi":"कीटाणु"},{"en":"Waste substances","hi":"अपशिष्ट पदार्थ"},{"en":"Nutrients","hi":"पोषक तत्त्व"},{"en":"Dust","hi":"धूल"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"CURATED_ANSWER"},{"en":"Which organ pumps blood through the body?","hi":"शरीर में रक्त पंप करने वाला अंग कौन-सा है?","ans":"Heart","ans_hi":"हृदय","options":[{"en":"Pancreas","hi":"अग्न्याशय"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Liver","hi":"यकृत"},{"en":"Heart","hi":"हृदय"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"organs"},{"en":"Which organs help us breathe?","hi":"साँस लेने में कौन-से अंग मदद करते हैं?","ans":"Lungs","ans_hi":"फेफड़े","options":[{"en":"Lungs","hi":"फेफड़े"},{"en":"Gallbladder","hi":"पित्ताशय"},{"en":"Small intestine","hi":"छोटी आँत"},{"en":"Stomach","hi":"आमाशय"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"organs"},{"en":"Which organ controls thinking and body movements?","hi":"सोच और शारीरिक गतिविधियों को नियंत्रित कौन-सा अंग करता है?","ans":"Brain","ans_hi":"मस्तिष्क","options":[{"en":"Skull","hi":"खोपड़ी"},{"en":"Pancreas","hi":"अग्न्याशय"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Brain","hi":"मस्तिष्क"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"organs"},{"en":"What is the hardest substance in the human body?","hi":"मानव शरीर का सबसे कठोर पदार्थ कौन-सा है?","ans":"Tooth enamel","ans_hi":"दाँतों का इनेमल","options":[{"en":"Hair","hi":"बाल"},{"en":"Cartilage","hi":"उपास्थि"},{"en":"Tooth enamel","hi":"दाँतों का इनेमल"},{"en":"Skin","hi":"त्वचा"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"CURATED_ANSWER"},{"en":"Which sense organ is linked to taste?","hi":"स्वाद का अनुभव किस इंद्रिय से होता है?","ans":"Tongue","ans_hi":"जीभ","options":[{"en":"Teeth","hi":"दाँत"},{"en":"Liver","hi":"यकृत"},{"en":"Tongue","hi":"जीभ"},{"en":"Brain","hi":"मस्तिष्क"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"body"},{"en":"Which vitamin is made in the skin with adequate sunlight?","hi":"पर्याप्त धूप मिलने पर त्वचा में कौन-सा विटामिन बनता है?","ans":"Vitamin D","ans_hi":"विटामिन डी","options":[{"en":"Vitamin D","hi":"विटामिन डी"},{"en":"Carbohydrates","hi":"कार्बोहाइड्रेट"},{"en":"Vitamin C","hi":"विटामिन सी"},{"en":"Fibre","hi":"रेशा"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"food"},{"en":"What do we call the change from solid ice to liquid water?","hi":"ठोस बर्फ से द्रव पानी बनने को क्या कहते हैं?","ans":"Melting","ans_hi":"पिघलना","options":[{"en":"Fermentation","hi":"किण्वन"},{"en":"Sublimation","hi":"उर्ध्वपातन"},{"en":"Pollination","hi":"परागण"},{"en":"Melting","hi":"पिघलना"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"processes"},{"en":"What is the main function of the skeleton?","hi":"कंकाल का मुख्य काम क्या है?","ans":"Support and protect the body","ans_hi":"शरीर को सहारा और सुरक्षा देना","options":[{"en":"Make food by photosynthesis","hi":"प्रकाश-संश्लेषण से भोजन बनाना"},{"en":"Support and protect the body","hi":"शरीर को सहारा और सुरक्षा देना"},{"en":"Pump blood","hi":"रक्त पंप करना"},{"en":"Digest starch","hi":"स्टार्च पचाना"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"CURATED_ANSWER"},{"en":"Which type of food is rich in fibre?","hi":"किस प्रकार के भोजन में रेशा अधिक होता है?","ans":"Fruits and vegetables","ans_hi":"फल एवं सब्जियाँ","options":[{"en":"Protein","hi":"प्रोटीन"},{"en":"Vitamin D","hi":"विटामिन डी"},{"en":"Fibre","hi":"रेशा"},{"en":"Fruits and vegetables","hi":"फल एवं सब्जियाँ"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"food"},{"en":"What should we do if we discover a small fire?","hi":"छोटी आग दिखने पर बच्चों को क्या करना चाहिए?","ans":"Alert an adult","ans_hi":"किसी बड़े को तुरंत बताना","options":[{"en":"Ignore the flames","hi":"लपटों को अनदेखा करना"},{"en":"Throw random chemicals","hi":"कोई भी रसायन फेंकना"},{"en":"Hide the fire","hi":"आग छिपाना"},{"en":"Alert an adult","hi":"किसी बड़े को तुरंत बताना"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"CURATED_ANSWER"},{"en":"What is a balanced diet?","hi":"संतुलित आहार क्या है?","ans":"Food with nutrients in suitable proportions","ans_hi":"उचित अनुपात में पोषक तत्त्व देने वाला आहार","options":[{"en":"Food with nutrients in suitable proportions","hi":"उचित अनुपात में पोषक तत्त्व देने वाला आहार"},{"en":"Only one type of food","hi":"केवल एक तरह का भोजन"},{"en":"Only fats","hi":"केवल वसा"},{"en":"Only sugary snacks","hi":"केवल मीठे स्नैक्स"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"CURATED_ANSWER"},{"en":"How many hours are in two days?","hi":"दो दिनों में कितने घंटे होते हैं?","ans":"48","ans_hi":"48","options":[{"en":"Ten","hi":"दस"},{"en":"Two","hi":"दो"},{"en":"48","hi":"48"},{"en":"Five","hi":"पाँच"}],"correct":2,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"quantities"},{"en":"What organ helps break down food using acid?","hi":"अम्ल की सहायता से भोजन का पाचन कौन-सा अंग करता है?","ans":"Stomach","ans_hi":"आमाशय","options":[{"en":"Skull","hi":"खोपड़ी"},{"en":"Stomach","hi":"आमाशय"},{"en":"Kidneys","hi":"गुर्दे"},{"en":"Liver","hi":"यकृत"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"organs"},{"en":"Which vitamin in citrus fruits helps prevent scurvy?","hi":"खट्टे फलों में कौन-सा विटामिन स्कर्वी से बचाव में मदद करता है?","ans":"Vitamin C","ans_hi":"विटामिन C","options":[{"en":"Calcium","hi":"कैल्शियम"},{"en":"Vitamin C","hi":"विटामिन C"},{"en":"Iron","hi":"आयरन"},{"en":"Carbohydrates","hi":"कार्बोहाइड्रेट"}],"correct":1,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"food"},{"en":"Which part of a tooth is visible above the gum?","hi":"मसूड़े के ऊपर दिखने वाला दाँत का भाग क्या कहलाता है?","ans":"Crown","ans_hi":"मुकुट","options":[{"en":"Legs","hi":"पैर"},{"en":"Eyes","hi":"आँखें"},{"en":"Lungs","hi":"फेफड़े"},{"en":"Crown","hi":"मुकुट"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"body"},{"en":"Which organ helps us hear?","hi":"सुनने में कौन-सा अंग मदद करता है?","ans":"Ears","ans_hi":"कान","options":[{"en":"Brain","hi":"मस्तिष्क"},{"en":"Ears","hi":"कान"},{"en":"Heart","hi":"हृदय"},{"en":"Eyes","hi":"आँखें"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which organ digests much of our food?","hi":"भोजन के अधिकांश पाचन में कौन-सा अंग महत्वपूर्ण है?","ans":"Small intestine","ans_hi":"छोटी आँत","options":[{"en":"Ears","hi":"कान"},{"en":"Heart","hi":"हृदय"},{"en":"Eyes","hi":"आँखें"},{"en":"Small intestine","hi":"छोटी आँत"}],"correct":3,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which direction is opposite to East?","hi":"पूर्व के विपरीत कौन-सी दिशा है?","ans":"West","ans_hi":"पश्चिम","options":[{"en":"South-West","hi":"दक्षिण-पश्चिम"},{"en":"West","hi":"पश्चिम"},{"en":"South","hi":"दक्षिण"},{"en":"South-East","hi":"दक्षिण-पूर्व"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which process causes rainwater to move downhill?","hi":"वर्षा का पानी ढलान पर किस कारण बहता है?","ans":"Gravity","ans_hi":"गुरुत्वाकर्षण","options":[{"en":"Sunlight","hi":"सूर्यप्रकाश"},{"en":"Rain gauge","hi":"वर्षामापी"},{"en":"Gravity","hi":"गुरुत्वाकर्षण"},{"en":"Melting","hi":"पिघलना"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which natural resource makes shadows in daylight?","hi":"दिन में परछाई बनाने वाला प्राकृतिक प्रकाश स्रोत कौ