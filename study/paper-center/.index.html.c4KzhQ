=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　<span class=\"blank\">__________</span></div></div>","answer":"Book: B, Moon: M, Umbrella: U, Car: C","marks":5},{"title":"Match capital letters to small letters.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">O　→　<div class=\"choices\"><b>o</b><span>　/　</span><b>p</b></div></div><div class=\"opt-line\">P　→　<div class=\"choices\"><b>p</b><span>　/　</span><b>q</b></div></div><div class=\"opt-line\">Q　→　<div class=\"choices\"><b>q</b><span>　/　</span><b>r</b></div></div><div class=\"opt-line\">R　→　<div class=\"choices\"><b>r</b><span>　/　</span><b>s</b></div></div></div>","answer":"O→o, P→p, Q→q, R→r","marks":5},{"title":"Copy any three capital letters neatly.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">S　<span class=\"blank\">________________</span></div><div class=\"opt-line\">T　<span class=\"blank\">________________</span></div><div class=\"opt-line\">U　<span class=\"blank\">________________</span></div></div>","answer":"Correctly copied letters: S, T, U","marks":5}]},"LKG|0|4|Maths":{"grade":"LKG","term":0,"year":4,"subject":"Maths","marks":25,"duration":"35–40 मिनट","qs":[{"title":"अंक देखकर लिखिए और पढ़िए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">17　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">20　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">3　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">6　→　<span class=\"blank\">__________</span></div><div class=\"opt-line\">9　→　<span class=\"blank\">__________</span></div></div>","answer":"अंक: 17, 20, 3, 6, 9","marks":5},{"title":"खाली स्थान भरिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">10　<span class=\"blank\">______</span>　12</div><di