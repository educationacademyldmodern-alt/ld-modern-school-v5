10","hi":"10"},{"en":"7","hi":"7"},{"en":"9","hi":"9"},{"en":"8","hi":"8"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"12 reusable bottles are shared equally among 3 groups. How many in each group?","hi":"12 दोबारा प्रयोग होने वाली बोतलें 3 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"4","ans_hi":"4","options":[{"en":"3","hi":"3"},{"en":"8","hi":"8"},{"en":"5","hi":"5"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 3 birds on a tree. 6 fly away. How many stay?","hi":"पेड़ पर 3 पक्षी थे, 6 उड़ गए। कितने बचे?","ans":"-3","ans_hi":"-3","options":[{"en":"5","hi":"5"},{"en":"0","hi":"0"},{"en":"3","hi":"3"},{"en":"-3","hi":"-3"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 2 pages each day for 3 days. How many pages?","hi":"विद्यार्थी 3 दिन तक रोज़ 2 पृष्ठ पढ़ता है। कुल कितने?","ans":"6","ans_hi":"6","options":[{"en":"7","hi":"7"},{"en":"8","hi":"8"},{"en":"6","hi":"6"},{"en":"11","hi":"11"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 4 litres of water a day for 2 days. How many litres?","hi":"कक्षा 2 दिनों तक प्रतिदिन 4 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"8","ans_hi":"8","options":[{"en":"12","hi":"12"},{"en":"4","hi":"4"},{"en":"7","hi":"7"},{"en":"8","hi":"8"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 4 pencils, and 5 are used. How many remain?","hi":"कुल 4 पेंसिल में 5 उपयोग हो गईं। कितनी बचीं?","ans":"-1","ans_hi":"-1","options":[{"en":"-1","hi":"-1"},{"en":"1","hi":"1"},{"en":"6","hi":"6"},{"en":"0","hi":"0"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 6 recyclable items in the morning