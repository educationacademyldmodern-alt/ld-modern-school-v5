en":"Eyes","hi":"आँखें"},{"en":"Skull","hi":"खोपड़ी"},{"en":"Nose","hi":"नाक"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What protects our head on a bicycle?","hi":"साइकिल पर हमारे सिर की रक्षा क्या करता है?","ans":"Helmet","ans_hi":"हेलमेट","options":[{"en":"Eraser","hi":"रबड़"},{"en":"Soap","hi":"साबुन"},{"en":"Helmet","hi":"हेलमेट"},{"en":"Lamp","hi":"लैंप"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What can grow from a seed?","hi":"बीज से क्या उग सकता है?","ans":"Plant","ans_hi":"पौधा","options":[{"en":"Air","hi":"वायु"},{"en":"Plant","hi":"पौधा"},{"en":"Wind","hi":"हवा"},{"en":"Clouds","hi":"बादल"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"Which body part protects our head?","hi":"शरीर का कौन-सा भाग सिर की सुरक्षा करता है?","ans":"Skull","ans_hi":"खोपड़ी","options":[{"en":"Skull","hi":"खोपड़ी"},{"en":"Teeth","hi":"दाँत"},{"en":"Eyes","hi":"आँखें"},{"en":"Nose","hi":"नाक"}],"correct":0,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What helps us see in the dark indoors?","hi":"कमरे में अँधेरे में देखने के लिए क्या मदद करता है?","ans":"Lamp","ans_hi":"लैंप","options":[{"en":"Zebra crossing","hi":"ज़ेब्रा क्रॉसिंग"},{"en":"Lamp","hi":"लैंप"},{"en":"Clean water","hi":"स्वच्छ पानी"},{"en":"Umbrella","hi":"छाता"}],"correct":1,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"What may fall from clouds?","hi":"बादलों से क्या गिर सकता है?","ans":"Rain","ans_hi":"वर्षा","options":[{"en":"Water","hi":"पानी"},{"en":"Plant","hi":"पौधा"},{"en":"Rain","hi":"वर्षा"},{"en":"Air","hi":"वायु"}],"correct":2,"kind":"modern","marks":1,"topic":"Grade-level modern GK / कक्षा-स्तरीय ज्ञान"},{"en":"The eco-club planted 6 trees on Monday and 5 on Tuesday. How many trees?","hi":"ईको-क्लब ने सोमवार को 6 और मंगलवार को 5 पेड़ लगाए। कुल कितने पेड़?","ans":"11","ans_hi":"11","options":[{"en":"10","hi":"10"},{"en":"18","hi":"18"},{"en":"11","hi":"11"},{"en":"16","hi":"16"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A class collected 7 paper sheets and reused 1. How many were left unused?","hi":"कक्षा ने 7 कागज़ की शीट इकट्ठी कीं और 1 फिर उपयोग कीं। कितनी बचीं?","ans":"6","ans_hi":"6","options":[{"en":"9","hi":"9"},{"en":"8","hi":"8"},{"en":"7","hi":"7"},{"en":"6","hi":"6"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A garden has 4 rows with 2 flowers each. How many flowers?","hi":"बगीचे में 4 कतारें हैं और हर कतार में 2 फूल हैं। कुल कितने फूल?","ans":"8","ans_hi":"8","options":[{"en":"9","hi":"9"},{"en":"4","hi":"4"},{"en":"8","hi":"8"},{"en":"16","hi":"16"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"6 reusable bottles are shared equally among 3 groups. How many in each group?","hi":"6 दोबारा प्रयोग होने वाली बोतलें 3 समूहों में बराबर बाँटी गईं। हर समूह में कितनी?","ans":"2","ans_hi":"2","options":[{"en":"2","hi":"2"},{"en":"1","hi":"1"},{"en":"5","hi":"5"},{"en":"7","hi":"7"}],"correct":0,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 9 birds on a tree. 1 fly away. How many stay?","hi":"पेड़ पर 9 पक्षी थे, 1 उड़ गए। कितने बचे?","ans":"8","ans_hi":"8","options":[{"en":"16","hi":"16"},{"en":"10","hi":"10"},{"en":"8","hi":"8"},{"en":"9","hi":"9"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A student reads 2 pages each day for 2 days. How many pages?","hi":"विद्यार्थी 2 दिन तक रोज़ 2 पृष्ठ पढ़ता है। कुल कितने?","ans":"4","ans_hi":"4","options":[{"en":"2","hi":"2"},{"en":"5","hi":"5"},{"en":"4","hi":"4"},{"en":"6","hi":"6"}],"correct":2,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"The class saves 3 litres of water a day for 3 days. How many litres?","hi":"कक्षा 3 दिनों तक प्रतिदिन 3 लीटर पानी बचाती है। कुल कितने लीटर?","ans":"9","ans_hi":"9","options":[{"en":"14","hi":"14"},{"en":"9","hi":"9"},{"en":"11","hi":"11"},{"en":"8","hi":"8"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 7 pencils, and 3 are used. How many remain?","hi":"कुल 7 पेंसिल में 3 उपयोग हो गईं। कितनी बचीं?","ans":"4","ans_hi":"4","options":[{"en":"8","hi":"8"},{"en":"6","hi":"6"},{"en":"2","hi":"2"},{"en":"4","hi":"4"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"A team collects 4 recyclable items in the morning and 2 in the evening. How many items?","hi":"टीम ने सुबह 4 और शाम 2 पुनर्चक्रण योग्य वस्तुएँ जुटाईं। कुल कितनी?","ans":"6","ans_hi":"6","options":[{"en":"8","hi":"8"},{"en":"2","hi":"2"},{"en":"10","hi":"10"},{"en":"6","hi":"6"}],"correct":3,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"There are 8 seedlings. 3 more are planted. How many now?","hi":"पहले 8 पौध थे, 3 और लगाए गए। अब कुल कितने?","ans":"11","ans_hi":"11","options":[{"en":"16","hi":"16"},{"en":"11","hi":"11"},{"en":"12","hi":"12"},{"en":"3","hi":"3"}],"correct":1,"kind":"applied","marks":1,"topic":"Sustainable living & reasoning / पर्यावरण और तर्क"},{"en":"Someone is being teased unfairly in class. What is right?","hi":"कक्षा में किसी को अनुचित रूप से चिढ़ाया जा रहा है। क्या सही है?","ans":"Support them and tell a teacher","ans_hi":"उसका साथ दें और शिक्षक को बताएँ","options":[{"en":"Support them and tell a teacher","hi":"उसका साथ दें और शिक्षक को बताएँ"},{"en":"Record and mock them","hi":"वीडियो बनाकर मज़ाक करें"},{"en":"Join in teasing","hi":"चिढ़ाने में शामिल हों"},{"en":"Keep encouraging teasing","hi":"चिढ़ाना बढ़ाएँ"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारि