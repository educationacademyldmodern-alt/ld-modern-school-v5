h. What do you use?","hi":"भोजन से पहले हाथ धोने के लिए क्या उपयोग करें?","ans":"Soap and clean water","ans_hi":"साबुन और स्वच्छ पानी","options":[{"en":"Soap and clean water","hi":"साबुन और स्वच्छ पानी"},{"en":"Only dry soil","hi":"केवल सूखी मिट्टी"},{"en":"Only coloured paint","hi":"केवल रंग"},{"en":"A dirty cloth","hi":"गंदा कपड़ा"}],"correct":0,"kind":"case","marks":1,"topic":"Practical decisions / व्यवहारिक निर्णय"}],"structure":"Core learning + digital/environment + applied reasoning / मूल + आधुनिक + तर्क","paper_code":"GK-1-4-06"},"1|3|7|GK":{"grade":"1","term":3,"year":7,"subject":"GK","kind":"gk","marks":50,"duration":"60 minutes / 60 मिनट","qs":[{"en":"How many days are in one week?","hi":"एक सप्ताह में कितने दिन होते हैं?","ans":"Seven","ans_hi":"सात","options":[{"en":"Seven","hi":"सात"},{"en":"Six","hi":"छह"},{"en":"Twelve","hi":"बारह"},{"en":"Two","hi":"दो"}],"correct":0,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"quantities"},{"en":"How many months are in one year?","hi":"एक वर्ष में कितने महीने होते हैं?","ans":"Twelve","ans_hi":"बारह","options":[{"en":"24","hi":"24"},{"en":"60","hi":"60"},{"en":"Three","hi":"तीन"},{"en":"Twelve","hi":"बारह"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"quantities"},{"en":"Which day comes after Monday?","hi":"सोमवार के बाद कौन-सा दिन आता है?","ans":"Tuesday","ans_hi":"मंगलवार","options":[{"en":"Friday","hi":"शुक्रवार"},{"en":"Wednesday","hi":"बुधवार"},{"en":"Sunday","hi":"रविवार"},{"en":"Tuesday","hi":"मंगलवार"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"days"},{"en":"Which day comes before Sunday?","hi":"रविवार से पहले कौन-सा दिन आता है?","ans":"Saturday","ans_hi":"शनिवार","options":[{"en":"Monday","hi":"सोमवार"},{"en":"Sunday","hi":"रविवार"},{"en":"Wednesday","hi":"बुधवार"},{"en":"Saturday","hi":"शनिवार"}],"correct":3,"kind":"core","topic":"Core GK / मूल ज्ञान","marks":1,"_domain":"days"},{"en":"What do we use to see the time?","