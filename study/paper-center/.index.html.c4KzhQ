<!DOCTYPE html>
<html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>SKY SIR · LDM V16 Bilingual English-Medium Exam Studio — GK Booklet & Double OMR</title>
<style>
:root{--navy:#14273e;--blue:#203c5b;--teal:#087c83;--gold:#e0b354;--bg:#f2f6fa;--line:#dbe3ed;--ink:#192940;--muted:#667789}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:"Noto Sans Devanagari","Mangal","Kohinoor Devanagari",system-ui,Arial,sans-serif;margin:0;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.5}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #d9a949;outline-offset:2px}button:disabled{opacity:.45;cursor:not-allowed}a{color:#086a85}
.header{background:linear-gradient(112deg,#10243a,#224763 72%,#087b7f);padding:18px max(14px,calc((100vw - 1160px)/2));color:white;box-shadow:0 8px 18px #152d431f}.brand{display:flex;align-items:center;gap:12px}.mark{flex:0 0 52px;height:52px;border-radius:14px;background:linear-gradient(140deg,#f2d587,#ce9428);display:grid;place-items:center;color:#19344f;font-size:19px;font-weight:950}.eyebrow{font-size:10px;color:#c4e4e6;font-weight:850;letter-spacing:1px}.header h1{font-size:clamp(18px,3vw,26px);margin:1px 0 2px;line-height:1.3}.header p{font-size:12px;color:#e1edf6;margin:0}.wrap{max-width:1180px;padding:18px 15px 65px;margin:auto}.quicknav{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-bottom:15px}.quicknav button{padding:9px 13px;border-radius:11px;border:1px solid #c6d7e4;color:#23455c;background:white;font-size:13px;font-weight:850;min-height:42px}.quicknav .last{margin-left:auto;font-size:12px;color:#557185}.main-panel{background:white;border:1px solid var(--line);border-radius:17px;padding:20px;margin-bottom:15px;box-shadow:0 7px 22px #122f4909}.main-panel h2{font-size:21px;margin:0 0 5px}.muted{color:var(--muted)}.hint{margin:6px 0 16px;font-size:13px;color:#617588}.hero-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.module{border:1px solid var(--line);border-radius:16px;padding:22px;text-align:left;background:linear-gradient(150deg,#fff,#f8fbfe);box-shadow:0 6px 20px #253f560a;color:var(--ink);min-height:175px}.module .emoji{font-size:28px;display:block}.module strong{display:block;font-size:18px;margin:10px 0 4px}.module span{font-size:12px;color:#516a7e}.module:active,.module:hover{border-color:#208b91;background:#effafa}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin:15px 0}.stat{padding:15px;background:white;border:1px solid var(--line);border-radius:12px}.stat b{font-size:26px;color:var(--navy);display:block}.stat span{font-size:12px;color:var(--muted)}.notice{padding:11px 14px;background:#eaf7f7;border-left:4px solid #07848a;border-radius:8px;color:#235465;font-size:13px;margin:14px 0}.warning{padding:11px 13px;background:#fff8e9;border-left:4px solid #d5a53c;border-radius:8px;color:#715213;font-size:13px;margin:12px 0}.form-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.field{display:grid;gap:5px;min-width:0}.field label{font-weight:850;font-size:12px;color:#46617a}.field select,.field input{border-radius:10px;border:1px solid #bdcedc;padding:10px 12px;width:100%;min-width:0;min-height:45px;background:white;font-size:16px}.button-row{display:flex;flex-wrap:wrap;gap:9px;margin:15px 0 0}.btn{padding:11px 15px;border-radius:11px;border:1px solid var(--teal);background:var(--teal);color:white;font-weight:800;min-height:43px}.btn.primary{background:var(--navy);border-color:var(--navy)}.btn.light{background:white;border-color:#c7d8e4;color:#163c5d}.btn.gold{background:#fff6df;border-color:#eddaa4;color:#76571d}.btn.sm{padding:7px 10px;font-size:12px;min-height:34px}.actions-top{display:flex;align-items:center;flex-wrap:wrap;justify-content:space-between;gap:8px}.actions-top h3{font-size:17px;margin:0}.pill{display:inline-block;background:#e3f2f5;color:#216075;font-weight:800;font-size:11px;border-radius:20px;padding:5px 10px}.subnav{display:flex;gap:7px;flex-wrap:wrap}.chip{background:#edf4f7;padding:6px 11px;border:1px solid #dae6ec;border-radius:25px;font-size:12px;color:#3c5c74}.empty{text-align:center;padding:25px;border:1px dashed #d1b168;border-radius:10px}.teacher-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.week{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:#fbfdff;break-inside:avoid}.week-top{display:flex;justify-content:space-between;gap:12px;align-items:center}.week-top strong{font-size:13px;color:#1a5268}.week .topic{font-size:12px;padding:5px 0;border-bottom:1px dotted #e1e8ed}.week .topic:last-child{border:0}.week input{height:17px;width:17px;accent-color:var(--teal)}.week label{font-size:11px;display:flex;align-items:center;gap:5px;color:#557184}.teacher-list .week .topic b{color:#264968}.plan-progress{height:10px;background:#dee8ee;border-radius:14px;overflow:hidden;margin:8px 0}.plan-progress b{height:100%;display:block;background:var(--teal)}.foot{text-align:center;font-size:11px;color:#63788a;padding:25px 10px}.no-screen{display:none}.screen-preview{border:1px solid #bfccda;border-radius:10px;background:#e9eef4;padding:14px;overflow:auto}.paper{width:100%;max-width:790px;margin:0 auto;background:white;color:#121922;box-shadow:0 4px 18px #101e2a16;padding:19px 23px;font-family:"Noto Sans Devanagari","Mangal",Arial,sans-serif;line-height:1.35;font-size:12px}.paper-school{text-align:center;border-bottom:2px solid #283442;padding-bottom:5px}.paper-school h2{font-size:17px;margin:0;line-height:1.35;color:#121b28}.paper-school p{font-size:9px;margin:3px 0}.paper-school h3{font-size:13px;margin:4px 0 0}.paper-info{display:grid;grid-template-columns:1fr 1fr;gap:2px 10px;font-size:10px;font-weight:750;padding:6px 0;border-bottom:1px solid #aeb8c2}.student-row{display:flex;gap:7px;justify-content:space-between;font-size:10px;padding:7px 0;flex-wrap:wrap}.paper-guide{font-size:9.7px;border:1px solid #d6dce1;background:#f5f7f8;border-radius:4px;padding:5px 7px;margin-bottom:7px}.preq-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 10px;align-items:start}.preq{padding:6px 3px;border-bottom:1px dashed #d5dade;break-inside:avoid;min-width:0}.preq h4{margin:0 0 5px;font-size:11px;line-height:1.45}.preq .exam-qbody{font-size:11px}.preq .exam-qbody p{margin:3px 0}.preq svg{max-height:53px;max-width:67px;vertical-align:middle}.preq .blank-art{height:65px;border:1px solid #c9d3db;flex:1;min-width:65px}.preq .blank-art.tall{height:92px}.preq .art-example{display:flex;align-items:center;gap:5px}.preq .practice-dots{line-height:1.15;font-size:15px;letter-spacing:2px}.preq .trace{font-size:25px;display:inline-block;margin:3px;border-bottom:1px dotted gray}.preq .shape-row{display:flex;gap:7px}.preq .shape-row svg{max-height:43px}.preq .shape-tile{display:flex;flex-direction:column;align-items:center}.preq .shape-tile small{font-size:8px}.preq .opt-line{display:flex;align-items:center;gap:6px;min-height:18px;margin:2px 0;flex-wrap:wrap}.preq .questions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 7px}.preq .choices{font-size:10px;display:inline-flex;gap:4px}.preq .traces{display:flex;gap:6px;flex-wrap:wrap}.preq .answer-lines{display:flex;flex-direction:column;gap:6px}.preq .answer-lines i{height:5px;border-bottom:1px solid #aaa}.preq .big-writing{margin:4px 0}.preq .rubric-row{font-size:10px;padding:4px;border:1px solid #ddd}.preq .counters{display:inline-flex;flex-wrap:wrap;max-width:125px}.preq .microtask{font-size:9px;color:#172e46;border-top:1px dashed #c8d4de;margin:4px 0 0}.preq .exam-question{break-inside:avoid}.paper-bottom{display:flex;justify-content:space-between;gap:8px;font-size:9px;border-top:1px solid #bbb;margin-top:10px;padding-top:5px}.gk-paper .qa-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}.gk-q{break-inside:avoid;border-bottom:1px dotted #d1d6db;padding:4px 0 7px}.gk-q b{font-size:10.8px}.gk-q p{font-size:10px;margin:2px 0}.gk-q .answer-line{border-bottom:1px solid #a8a8a8;height:15px;margin:4px 0 1px}.teacher-key{padding:10px 0;border-bottom:1px dotted #cfdbe3;break-inside:avoid;font-size:11px}.teacher-key strong{display:block}.drawing-q{border-bottom:1px solid #ced7df;padding:9px 0;break-inside:avoid}.drawing-q strong{font-size:12px}.drawing-q p{margin:4px 0;font-size:10.5px}.draw-space{height:115px;border:1px solid #d0d7dc;border-radius:3px;margin-top:5px}.draw-paper .drawing-q:last-of-type{border-bottom:0}.draw-paper .draw-space{height:116px}.draw-paper .drawing-q:nth-child(3) .draw-space{height:90px}.drawing-rubric{font-size:10px;background:#f1f5f8;padding:7px;margin-top:8px;border:1px solid #dae4e9}.print-sheet,.paper.print-paper{background:white}.teacher-sheet{background:white;color:#161a22;padding:14px;font-size:11px;line-height:1.34}.teacher-sheet h2{font-size:16px;margin:0 0 3px}.teacher-sheet h3{font-size:12px;margin:7px 0 4px}.teacher-title{text-align:center;border-bottom:2px solid #1a2d3d;padding-bottom:6px}.teacher-title b{font-size:15px}.teacher-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;padding:7px 0;font-size:10px}.teacher-compact{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.teacher-box{border:1px solid #dde3e8;padding:8px;border-radius:6px;break-inside:avoid}.teacher-box b{font-size:10.5px}.teacher-box ol{padding-left:17px;margin:4px 0}.teacher-box li{font-size:9.1px;margin:1px 0}.teacher-row{border-bottom:1px dotted #ddd;padding:4px 0;break-inside:avoid;font-size:10.5px}.teacher-row b{color:#204d6c}.teacher-row small{display:block;font-size:9.5px}.teacher-note{padding:5px;border:1px solid #abbfc6;background:#f8fafb;font-size:10px}.screen-preview .teacher-sheet{max-width:800px;margin:auto}.duplex-preview{display:grid;grid-template-columns:1fr 1fr;gap:8px}.half-paper{padding:9px;background:white;border-right:1px dashed #c1cbd5;min-width:0}.half-paper:last-child{border:0}.half-paper .paper{padding:2px;box-shadow:none}.half-paper .draw-paper .draw-space{height:80px}.half-paper .paper-school h2{font-size:12px}.half-paper .paper-school h3{font-size:10px}.half-paper .paper-info{font-size:8px}.half-paper .student-row{font-size:8px}.half-paper .drawing-q strong{font-size:9px}.half-paper .drawing-q p{font-size:8px}.half-paper .drawing-rubric{font-size:7px}.half-paper .paper-guide{font-size:8px}.half-paper .paper-bottom{font-size:7px}
@media(max-width:800px){.form-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-cards{grid-template-columns:1fr 1fr}.stats{grid-template-columns:1fr 1fr}.teacher-list{grid-template-columns:1fr}}@media(max-width:560px){.header{padding:14px}.mark{flex-basis:44px;height:44px}.wrap{padding:12px 9px}.main-panel{padding:13px}.hero-cards{grid-template-columns:1fr}.module{min-height:125px;padding:15px}.form-grid{gap:9px}.button-row .btn{flex:1}.quicknav .last{width:100%;margin-left:0}.paper{padding:9px 10px;font-size:11px}.paper-school h2{font-size:13px}.paper-info{font-size:8px}.student-row{font-size:8px}.preq-grid,.gk-paper .qa-grid{grid-template-columns:1fr}.preq{padding:5px 1px}.screen-preview{padding:6px}.teacher-compact{grid-template-columns:1fr}.duplex-preview{grid-template-columns:1fr}.form-grid .field select{padding:8px 7px}.stats .stat{padding:10px}}
@page{size:A4 portrait;margin:7mm}
@media print{
html,body{background:white!important;color:black!important;margin:0!important;padding:0!important;-webkit-print-color-adjust:exact;print-color-adjust:exact}.header,.wrap,.foot{display:none!important}
#printRoot{display:block!important;margin:0!important;width:100%!important;padding:0!important;visibility:visible!important;position:static!important}
#printRoot .paper{width:100%!important;max-width:none!important;box-shadow:none!important;padding:0!important;margin:0!important}
#printRoot .paper-school h2{font-size:14px!important}#printRoot .paper-school h3{font-size:12px!important}#printRoot .paper-school p{font-size:9px!important}
#printRoot .preq-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px 10px}#printRoot .preq{padding:3px 2px!important}#printRoot .preq h4{font-size:10.3px!important}#printRoot .preq .exam-qbody{font-size:10px!important}#printRoot .preq svg{max-height:48px!important;max-width:57px!important}#printRoot .preq .blank-art{height:50px!important}#printRoot .preq .blank-art.tall{height:70px!important}
#printRoot .preq .practice-dots{font-size:13px!important}#printRoot .gk-paper .qa-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:6px 16px}#printRoot .gk-q{font-size:10px!important}#printRoot .draw-paper .draw-space{height:41mm!important}
#printRoot .print-page{break-after:page;page-break-after:always;break-inside:avoid}#printRoot .print-page:last-child{break-after:auto;page-break-after:auto}
#printRoot .teacher-sheet{padding:0!important;font-size:10px!important}#printRoot .teacher-compact{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}#printRoot .teacher-box{padding:5px!important}#printRoot .teacher-box li{font-size:8.1px!important}#printRoot .teacher-row{font-size:9.7px!important}
#printRoot .side-by-side{width:100%!important;display:grid!important;grid-template-columns:1fr 1fr!important;gap:0!important;min-height:180mm!important;max-height:none!important}#printRoot .half-paper{padding:4mm!important;border-right:1px dashed #999!important;min-width:0!important}#printRoot .half-paper:last-child{border:0!important}#printRoot .half-paper .paper{padding:0!important}#printRoot .half-paper .draw-paper .draw-space{height:22mm!important} #printRoot .half-paper .duplex-front .draw-space{height:35mm!important}#printRoot .half-paper .drawing-q{padding:4mm 0!important}
#printRoot .half-paper .paper-school h2{font-size:11px!important}#printRoot .half-paper .paper-school h3{font-size:9px!important}#printRoot .half-paper .paper-school p{font-size:6.8px!important}#printRoot .half-paper .paper-info,#printRoot .half-paper .student-row{font-size:7.5px!important}#printRoot .half-paper .drawing-q strong{font-size:9px!important}#printRoot .half-paper .drawing-q p{font-size:8px!important}#printRoot .half-paper .drawing-rubric{font-size:7.3px!important}#printRoot .half-paper .paper-bottom{font-size:7px!important}
#printRoot .paper.duplex-back .draw-space{height:125mm!important}#printRoot .side-by-side .duplex-back .draw-space{height:120mm!important}
}

/* SKY SIR V11.2 · readable bilingual MCQs and option-based drawing */
.gk-mcq-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;align-items:start}
.gk-mcq{break-inside:avoid;border:1px solid #dce3e9;border-radius:4px;padding:5px 6px;font-size:9.8px;line-height:1.28;background:#fff}
.gk-stem b{font-size:10px;display:block;font-weight:780;color:#16293e}
.gk-stem small{font-size:9px;display:block;color:#394b60;margin:2px 0 3px}
.gk-opts{display:grid;grid-template-columns:1fr 1fr;gap:2px 6px}
.gk-option{font-size:9px;display:flex;gap:3px;align-items:flex-start;flex-wrap:wrap;overflow-wrap:anywhere}
.gk-option small{font-size:8.7px;color:#445263}
.gk-option .tick{font-size:13px;line-height:1}
.gk-section-title{display:flex;justify-content:space-between;align-items:center;font-size:10px;border-bottom:1px solid #96a8bb;padding:4px 0}
.gk-guide{font-size:9px;line-height:1.3;margin:4px 0 8px}
.gk-tail{display:flex;justify-content:space-between;gap:10px;margin-top:5px;font-size:9px}
.gk-sheet{background:white}
.teacher-answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px 9px}
.teacher-answer-grid .teacher-key{font-size:9px;padding:4px 0}
.teacher-answer-grid .teacher-key b{font-size:9.5px}
.teacher-answer-grid .teacher-key small{display:block;font-size:8.6px}
.art-choices p{margin:2px 0!important;line-height:1.35;font-size:10px}
.art-choices small{display:block;font-size:9.5px}
.art-choices .or-separator{font-size:10px;font-weight:800;text-align:center;margin:1px auto;background:#eef4fa;border-radius:4px;max-width:80px}
.draw-qtop{display:flex;align-items:center;justify-content:space-between;gap:8px}
.draw-space{position:relative;background:repeating-linear-gradient(0deg,#fff,#fff 18px,#fafbfd 19px);height:180px!important}
.draw-space small{position:absolute;top:2px;left:6px;color:#b8c1ca;font-size:8px}
.draw-paper .drawing-q:nth-child(1) .draw-space{height:250px!important}
.draw-paper .drawing-q:nth-child(2) .draw-space{height:170px!important}
.draw-paper .drawing-q{padding:5px 0}
@media(max-width:700px){.gk-mcq-grid,.teacher-answer-grid{grid-template-columns:1fr}.gk-mcq{font-size:10px}.gk-option{font-size:9.5px}}
@media print{
#printRoot .gk-sheet{break-inside:avoid!important;page-break-inside:avoid!important;break-after:page!important;page-break-after:always!important}
#printRoot .gk-sheet:last-child{break-after:auto!important;page-break-after:auto!important}
#printRoot .gk-paper .gk-mcq-grid{grid-template-columns:1fr 1fr!important;gap:2mm 3mm!important}
#printRoot .gk-mcq{padding:1.2mm 1.5mm!important;font-size:8.6px!important}
#printRoot .gk-stem b{font-size:9.2px!important}
#printRoot .gk-stem small{font-size:8.4px!important}
#printRoot .gk-option{font-size:8.4px!important}
#printRoot .gk-option small{font-size:8.0px!important}
#printRoot .gk-opts{gap:1mm 1.5mm!important}
#printRoot .gk-option .tick{font-size:11px!important}
#printRoot .teacher-answer-grid{grid-template-columns:1fr 1fr!important;gap:1mm 3mm!important}
#printRoot .teacher-answer-grid .teacher-key{padding:1.5mm!important;font-size:8.9px!important}
#printRoot .teacher-answer-grid .teacher-key small{font-size:8.5px!important}
#printRoot .draw-paper .drawing-q:nth-child(1) .draw-space{height:69mm!important}
#printRoot .draw-paper .drawing-q:nth-child(2) .draw-space{height:39mm!important}
#printRoot .half-paper .draw-paper .drawing-q:nth-child(1) .draw-space{height:37mm!important}
#printRoot .half-paper .draw-paper .drawing-q:nth-child(2) .draw-space{height:29mm!important}
#printRoot .half-paper .duplex-front .drawing-q:nth-child(1) .draw-space{height:75mm!important}
#printRoot .half-paper .duplex-back .drawing-q:nth-child(1) .draw-space{height:75mm!important}
#printRoot .half-paper .art-choices p{font-size:8.4px!important}
#printRoot .half-paper .art-choices small{font-size:7.6px!important}
#printRoot .half-paper .drawing-rubric{font-size:8.5px!important}
#printRoot .draw-paper .art-choices p{font-size:10px!important}
#printRoot .draw-paper .drawing-q{break-inside:avoid!important;padding:2mm 0!important}
}

/* V12: bilingual English-medium modern assessment & proofing */
.v12-head{border-bottom:2px solid #163c54;padding:5px 0 8px;margin:0 0 8px}
.v12-head b{display:block;letter-spacing:.6px;color:#152d43;font-size:16px}
.v12-title{font-size:14px;font-weight:900;color:#18324a}
.v12-note{font-size:10px;color:#3b5468;margin:4px 0 9px}
.v12-draw-q{margin:8px 0 12px;border:1px solid #c2d0dc;padding:9px;border-radius:5px;break-inside:avoid}
.v12-draw-q h3{margin:0 0 7px;font-size:14px}
.v12-draw-q .option{margin:5px 0;padding:6px;border:1px dashed #cbd7de;border-radius:4px;font-size:11px}
.v12-draw-q .option strong{color:#172e44}
.v12-draw-q .option small{font-size:10px;display:block;color:#425566}
.v12-draw-space{border:1px solid #a8b8c9;background:repeating-linear-gradient(0deg,#fff 0,#fff 24px,#f0f3f5 25px);height:92px;position:relative;margin-top:6px}
.v12-draw-space.big{height:150px}
.v12-draw-space::after{content:'DRAW HERE / यहाँ चित्र बनाएँ';font-size:9px;color:#98a5ae;position:absolute;top:5px;left:7px}
.v12-rubric{border:1px solid #cdd7de;background:#f6f9fb;padding:8px;margin-top:9px;font-size:10px}
.v12-sheet-frame{border:1.3px solid #778ca0;height:88mm;margin:8px 0 12px;position:relative}
.v12-sheet-frame.tall{height:121mm}
.v12-sheet-frame small{position:absolute;top:6px;left:8px;color:#637689}
.v12-omr{font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif;font-size:11px;line-height:1.4}
.v12-omr-header{text-align:center;margin:0 0 9px}
.v12-omr-header h2{font-size:17px;margin:0;color:#112e45}
.v12-omr-header h3{font-size:13px;margin:4px 0}
.v12-omr-meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;border:1px solid #9caeba;padding:8px;margin-bottom:9px}
.v12-omr-meta div{font-size:10px}
.v12-omr-guide{font-size:10px;margin:8px 0;border-left:3px solid #1c5678;background:#f3f7f9;padding:7px}
.v12-omr-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:repeat(10,1fr);grid-auto-flow:column;gap:4px 7px;margin-top:10px}
.v12-omr-item{display:flex;align-items:center;justify-content:space-between;gap:3px;border-bottom:1px dotted #c4cdd2;min-width:0;padding:5px 3px;font-size:10px}
.v12-bubbles{display:flex;gap:5px;align-items:center}
.v12-bubble{display:inline-flex;align-items:center;justify-content:center;min-width:15px;min-height:15px;border-radius:50%;border:1.2px solid #222;color:#222;font-size:9px;font-weight:700;line-height:1}
.v12-choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.v12-choice-card{border:1px solid #b7c7d2;border-radius:5px;padding:9px;min-height:50px}
.v12-choice-line{display:flex;align-items:center;gap:16px;font-size:13px;margin:9px 0}.v12-choice-line b{display:inline-block;border:1px solid #90a2af;padding:8px 15px;border-radius:5px;min-width:75px;text-align:center}
.v12-markbox{display:inline-block;width:38px;border:1px solid #8ca0b0;height:23px;vertical-align:middle;margin:0 4px}
.v12-small{font-size:10px;color:#475d70}
.v12-actionbox{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.v12-lbl{display:inline-block;font-weight:800;color:#31586c;padding:3px 7px;border:1px solid #cfe0e7;border-radius:5px;background:#f2f8fb}
.v12-prev-stack{display:grid;gap:12px}
.v12-prev-stack>.print-page{border:1px solid #c4d2dd;box-shadow:0 3px 14px #1e3b5a14;background:white;margin:0 auto 13px;width:100%}
.v12-preview-landscape .print-page{max-width:1080px}
.v12-preview-portrait .print-page{max-width:790px}
.v12-preview-landscape .paper{max-width:1080px}
.v12-current-preview .v12-omr-grid{grid-template-columns:repeat(5,minmax(0,1fr))}
@media(max-width:700px){.v12-omr-grid{gap:2px 2px}.v12-omr-item{font-size:8px;padding:3px 1px}.v12-bubbles{gap:1px}.v12-bubble{font-size:7px;min-width:12px;min-height:12px}.v12-omr-meta{grid-template-columns:1fr 1fr}.v12-preview-landscape .paper{min-width:740px}.v12-current-preview{overflow-x:auto}.v12-choice-grid{grid-template-columns:1fr}}
@media print{
 #printRoot .v12-current-preview,.v12-actionbox{display:none!important}
 #printRoot .v12-omr .paper-school h2{font-size:16px!important}
 #printRoot .v12-omr-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important;grid-template-rows:repeat(10,1fr)!important;grid-auto-flow:column!important;gap:1.2mm 1.7mm!important}
 #printRoot .v12-omr-item{padding:1.2mm 1mm!important;font-size:9px!important}
 #printRoot .v12-bubble{min-width:5.8mm;min-height:5.8mm;font-size:9px!important}
 #printRoot .v12-draw-q{margin:2mm 0 3mm!important;padding:2mm!important}
 #printRoot .v12-draw-space{height:28mm!important}
 #printRoot .v12-draw-space.big{height:50mm!important}
 #printRoot .v12-draw-q h3{font-size:12px!important;margin:0 0 2mm!important}
 #printRoot .v12-sheet-frame{height:70mm!important;margin:2mm 0 3mm!important}
 #printRoot .v12-sheet-frame.tall{height:95mm!important}
 #printRoot .v12-omr-header{margin-bottom:2mm!important}
 #printRoot .v12-omr-meta{padding:2mm!important;margin-bottom:2mm!important}
 #printRoot .v12-omr-guide{font-size:9px!important;margin:1.5mm 0!important;padding:1.5mm!important}
 #printRoot .v12-choice-card{min-height:30mm!important}
 #printRoot .v12-art-omr{font-size:10px!important}
 #printRoot .v12-art-omr .v12-choice-card{min-height:25mm!important}
 #printRoot .v12-art-omr .v12-rubric{margin-top:3mm!important}
 #printRoot .v12-art-omr .v12-small{font-size:9px!important}
 #printRoot .gk-mcq-grid{gap:1.3mm 3mm!important}
 #printRoot .gk-mcq{padding:1.2mm 1.7mm!important}
 #printRoot .gk-stem b{font-size:9.4px!important}
 #printRoot .gk-stem small{font-size:8.4px!important}
 #printRoot .gk-option{font-size:8.5px!important}
 #printRoot .gk-option small{font-size:8px!important}
}

/* V13 GK A5 foldable booklet / portrait Art Section B 20 options */
.v13-booklet-sheet{position:relative;background:#fff;margin:0 auto 12px;padding:0;width:100%;max-width:1080px;overflow:hidden}
.v13-booklet-imposed{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));position:relative}
.v13-booklet-half{position:relative;min-width:0;display:flex;flex-direction:column;border:1px solid #b6c2cf;padding:10px 11px 8px;background:#fff;color:#182b3e;font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif;min-height:510px}
.v13-booklet-half+.v13-booklet-half{border-left:1.4px dashed #607e92}
.v13-booklet-head{border-bottom:1px solid #243f52;text-align:center;padding-bottom:4px;display:grid;gap:1px}
.v13-booklet-head b{font-size:11px;line-height:1.1}.v13-booklet-head small{font-size:8px;color:#273e50}
.v13-booklet-direction{font-size:7px;margin:4px 0;border-bottom:1px dotted #bccbd3;padding-bottom:2px}
.v13-booklet-items{display:flex;flex-direction:column;gap:4px;flex:1}
.v13-booklet-question{border-bottom:1px dotted #d8e0e4;padding-bottom:2px;break-inside:avoid}
.v13-booklet-stem b{font-size:9px;line-height:1.2;display:block}
.v13-booklet-stem small{font-size:8px;display:block;line-height:1.15;color:#485865}
.v13-booklet-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px 4px;margin-top:2px}
.v13-booklet-options span{font-size:7.9px;line-height:1.15;overflow-wrap:anywhere}
.v13-booklet-options b{margin-right:2px}
.v13-booklet-options small{color:#586c79;display:inline;font-size:7.4px;margin-left:2px}
.v13-booklet-foot{font-size:7px;display:flex;justify-content:space-between;border-top:1px solid #8ea5b6;margin-top:3px;padding-top:3px}
.v13-booklet-fold{display:none}.v13-booklet-side{font-size:9px;text-align:center;color:#617588}
.v13-compact .v13-booklet-stem b{font-size:7.2px}.v13-compact .v13-booklet-stem small{font-size:6.8px}.v13-compact .v13-booklet-options span{font-size:6.5px}.v13-compact .v13-booklet-options small{font-size:6.1px}.v13-compact .v13-booklet-items{gap:2px}
.v13-art-section{border:1px solid #b6c7d5;border-radius:5px;padding:7px;margin:6px 0;break-inside:avoid}
.v13-art-section h3{font-size:12px;color:#192f47;margin:0 0 5px;display:flex;justify-content:space-between;gap:4px}
.v13-art-section h3 span{white-space:nowrap}
.v13-art-section p{margin:3px 0;font-size:10px;line-height:1.3}
.v13-art-section small{display:block;font-size:9px;color:#435567}
.v13-art-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 6px}
.v13-art-option{display:flex;gap:5px;break-inside:avoid;font-size:9px;border-bottom:1px dotted #d9e1e5;padding:2px 0;line-height:1.2;min-width:0}
.v13-art-option b{font-size:9px;min-width:26px}
.v13-art-option small{margin-top:1px;font-size:8px}
.v13-art-instruction{background:#f1f5fa;padding:5px}
.v13-art-choice-bubbles{display:grid;grid-template-columns:repeat(5,1fr);gap:7px 4px;margin:9px 0}
.v13-art-choice-bubbles>span{font-size:10px;white-space:nowrap}
.v13-art-choice-bubbles .v12-bubble{width:15px;height:15px;margin-right:2px;vertical-align:middle}
.v13-syllabus-art-bank{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}
.v13-syllabus-art-bank>div{border:1px dotted #a9bbca;padding:4px;font-size:9px;line-height:1.25}
.v13-syllabus-art-bank small{display:block;color:#465d6e;font-size:8.5px}
@media(max-width:650px){.v13-booklet-half{min-width:390px}.v13-booklet-sheet{overflow:auto}.v13-art-options{grid-template-columns:1fr}.v13-art-choice-bubbles{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media print{
 #printRoot .v13-booklet-sheet{width:100%!important;height:196mm!important;max-width:unset!important;min-height:0!important;overflow:hidden!important;break-after:page!important;page-break-after:always!important;margin:0!important;padding:0!important}
 #printRoot .v13-booklet-sheet:last-child{break-after:auto!important;page-break-after:auto!important}
 #printRoot .v13-booklet-imposed{display:grid!important;grid-template-columns:repeat(2,1fr)!important;height:194mm!important;width:100%!important}
 #printRoot .v13-booklet-half{height:194mm!important;min-height:0!important;overflow:hidden!important;border:none!important;border-right:1px dashed #81909d!important;padding:3mm 3.2mm 2mm!important}
 #printRoot .v13-booklet-half+.v13-booklet-half{border-right:0!important;border-left:0!important}
 #printRoot .v13-booklet-fold{display:block!important;position:absolute;left:50%;top:0;bottom:0;border-left:0.4mm dashed #90a6af;color:#768d9b;pointer-events:none}
 #printRoot .v13-booklet-fold span{position:absolute;top:50%;left:-20px;transform:rotate(-90deg);display:none}
 #printRoot .v13-booklet-side{display:none!important}
 #printRoot .v13-booklet-head{padding-bottom:1mm!important}
 #printRoot .v13-booklet-head b{font-size:10px!important}
 #printRoot .v13-booklet-head small{font-size:7.7px!important}
 #printRoot .v13-booklet-direction{font-size:7px!important;margin:1mm 0!important}
 #printRoot .v13-booklet-items{gap:.9mm!important}
 #printRoot .v13-booklet-stem b{font-size:8.7px!important;line-height:1.12!important}
 #printRoot .v13-booklet-stem small{font-size:7.8px!important;line-height:1.1!important}
 #printRoot .v13-booklet-options{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:.6mm 1mm!important}
 #printRoot .v13-booklet-options span{font-size:7.8px!important;line-height:1.12!important}
 #printRoot .v13-booklet-options small{font-size:7px!important}
 #printRoot .v13-booklet-question{padding-bottom:.3mm!important}
 #printRoot .v13-booklet-foot{font-size:7px!important;margin-top:1mm!important}
 #printRoot .v13-compact .v13-booklet-items{gap:.3mm!important}
 #printRoot .v13-compact .v13-booklet-stem b{font-size:7px!important;line-height:1.03!important}
 #printRoot .v13-compact .v13-booklet-stem small{font-size:6.4px!important;line-height:1.03!important}
 #printRoot .v13-compact .v13-booklet-options span{font-size:6.2px!important;line-height:1.02!important}
 #printRoot .v13-compact .v13-booklet-options small{font-size:5.9px!important}
 #printRoot .v13-compact .v13-booklet-direction{font-size:6px!important}
 #printRoot .v13-art-option{font-size:8.6px!important;padding:1mm 0!important}
 #printRoot .v13-art-option b{font-size:8.5px!important}
 #printRoot .v13-art-option small{font-size:7.8px!important}
 #printRoot .v13-art-options{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:1mm 2mm!important}
 #printRoot .v13-art-section{break-inside:avoid!important;margin:2mm 0!important;padding:2mm!important}
 #printRoot .v13-art-section h3{font-size:11px!important;margin:0 0 1mm!important}
 #printRoot .v13-art-section p{font-size:9px!important;padding:1mm!important}
 #printRoot .v13-draw-paper .v12-rubric{font-size:9px!important;margin-top:2mm!important;padding:1.4mm!important}
 #printRoot .v13-art-choice-bubbles{grid-template-columns:repeat(5,minmax(0,1fr))!important}
 #printRoot .v13-syllabus-art-bank{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}

/* Final proof: maximize legibility of folded A5 sheets without shrinking bilingual options. */
@media print{
 #printRoot .v13-booklet-items{gap:1.8mm!important}
 #printRoot .v13-booklet-question{padding-bottom:.9mm!important}
 #printRoot .v13-booklet-head b{font-size:12px!important}
 #printRoot .v13-booklet-head small{font-size:9px!important}
 #printRoot .v13-booklet-direction{font-size:8.5px!important}
 #printRoot .v13-booklet-stem b{font-size:11px!important;line-height:1.2!important}
 #printRoot .v13-booklet-stem small{font-size:10px!important;line-height:1.12!important}
 #printRoot .v13-booklet-options{gap:1.1mm 1.6mm!important;margin-top:1mm!important}
 #printRoot .v13-booklet-options span{font-size:9.6px!important;line-height:1.15!important}
 #printRoot .v13-booklet-options small{font-size:8.7px!important}
 #printRoot .v13-compact .v13-booklet-items{gap:.6mm!important}
 #printRoot .v13-compact .v13-booklet-question{padding-bottom:.4mm!important}
 #printRoot .v13-compact .v13-booklet-stem b{font-size:8.7px!important;line-height:1.10!important}
 #printRoot .v13-compact .v13-booklet-stem small{font-size:7.8px!important;line-height:1.10!important}
 #printRoot .v13-compact .v13-booklet-options span{font-size:7.6px!important;line-height:1.10!important}
 #printRoot .v13-compact .v13-booklet-options small{font-size:7.0px!important}
 #printRoot .v13-compact .v13-booklet-direction{font-size:7.4px!important}
}

/* V14: accurate 4-page booklets and two A5 OMRs on one Landscape A4 */
.v14-art-booklet .v14-art-leaf{font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif;background:white;color:#101d2a;overflow:hidden;display:flex;flex-direction:column}
.v14-art-leafhead{display:flex;flex-direction:column;border-bottom:2px solid #203a55;padding-bottom:6px;margin-bottom:7px;line-height:1.3;text-align:center}
.v14-art-leafhead>b{font-size:11px;color:#162c48}.v14-art-leafhead>span{font-size:9px;color:#294762}
.v14-art-bigtitle{text-align:center;font-size:13px;font-weight:800;color:#1b3654;border-bottom:1px solid #bdccd9;margin:4px 0 10px;padding:4px}.v14-art-bigtitle small{font-size:10px;font-weight:600;display:block}
.v14-art-candidates{border:1px solid #93aabd;border-radius:5px;padding:9px;font-size:12px;line-height:1.9;margin-bottom:10px}
.v14-art-rule{border:1px solid #99aec1;border-radius:5px;padding:10px;margin:8px 0;break-inside:avoid}
.v14-art-rule>b{font-size:11px;display:block;color:#183b5f}.v14-art-rule p{font-size:12px;line-height:1.3;margin:8px 0}.v14-art-rule small{display:block;font-size:10px;margin:2px 0 4px;color:#445e76}
.v14-or{text-align:center;font-size:12px;font-weight:800;color:#203b54;margin:9px auto;border-top:1px dotted #879fb3;border-bottom:1px dotted #879fb3;padding:3px}
.v14-art-note{font-size:10px;line-height:1.4;color:#456178;background:#f0f6fa;padding:9px;border-radius:4px}
.v14-art-questions{display:flex;flex-direction:column;gap:8px;flex:1}
.v14-art-qa{break-inside:avoid;border-bottom:1px dotted #c5d2dd;padding-bottom:5px;}
.v14-art-q-stem{font-size:12pt!important;font-weight:700;line-height:1.18;letter-spacing:-.12px}
.v14-art-q-stem em{font-size:8pt;font-weight:500;font-style:normal;white-space:nowrap}
.v14-art-q-hi{font-size:9.4pt;line-height:1.18;color:#42596b;margin-top:2px}
.v14-art-qopts{display:grid;grid-template-columns:1fr 1fr;gap:2px 7px;margin-top:3px}
.v14-art-qopts span{font-size:9pt;line-height:1.2;overflow-wrap:anywhere}
.v14-art-qopts b{color:#1d4461}
.v14-two-omr{position:relative;background:#fff;margin:0 auto;max-width:1120px;overflow:auto}
.v14-duo{display:grid;grid-template-columns:1fr 1fr;position:relative}
.v14-omr-half{background:#fff;padding:12px;border:1px solid #91abc0;color:#172f46;min-width:0}
.v14-omr-half+.v14-omr-half{border-left:1px dashed #687f91}
.v14-omr-header{text-align:center;display:flex;flex-direction:column;line-height:1.2;border-bottom:2px solid #243f5a;padding-bottom:5px}
.v14-omr-header strong{font-size:12px}.v14-omr-header span{font-size:10px;font-weight:700}.v14-omr-header small{font-size:9px}
.v14-omr-info{border-bottom:1px solid #adc3d4;padding:5px 0;font-size:10px;line-height:1.7}
.v14-omr-rule{font-size:9px;line-height:1.3;margin:5px 0;color:#32526c}
.v14-omr-rows{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.v14-omr-row{display:flex;align-items:center;gap:2px;height:23px;font-size:9px;border-bottom:1px dotted #d8e0e8;padding:0 1px}
.v14-omr-row>b{font-size:9px;min-width:15px}
.v14-bubble{display:flex;align-items:center;gap:2px;font-size:8px}
.v14-bubble i{display:inline-block;width:10px;height:10px;border:1px solid #1d3b56;border-radius:50%;background:white}
.v14-omr-end{display:flex;justify-content:space-between;align-items:center;gap:4px;font-size:8px;margin-top:8px;border-top:1px solid #91abbc;padding-top:5px}.v14-omr-end small{font-size:8px}
.v14-cut-line{position:absolute;top:0;bottom:0;left:50%;border-left:1px dashed #273e51;pointer-events:none}.v14-cut-line span{position:absolute;top:15px;left:-28px;font-size:7px;background:#fff;color:#40576b;transform:rotate(-90deg)}
.v14-art-omr-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:12px;margin:10px 0}
.v14-art-omr-grid>div{border:1px solid #b7cbd9;padding:8px}
.v14-art-omr-15{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin-top:5px}
.v14-art-omr-row{display:flex;gap:3px;align-items:center;font-size:8px}.v14-art-omr-row span{display:flex;gap:1px;align-items:center}
.v14-art-omr-row i{height:9px;width:9px;border:1px solid #26455c;border-radius:50%}
.v14-portrait-mcq{break-inside:avoid;page-break-inside:avoid;border-bottom:1px dotted #c4d0db;padding:7px 0}
.v14-portrait-mcq>b{font-size:12pt!important;display:flex;justify-content:space-between;gap:4px}
.v14-portrait-mcq>small{font-size:10pt;display:block}
.v14-portrait-mcq>div{display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:10pt;margin-top:4px}
.v14-art-instructions{font-size:11pt;line-height:1.5}
.v14-art-section-title{font-size:13pt;font-weight:800;border-bottom:1px solid #385c78;margin-top:18px}
.v14-art-alternatives small{display:block;color:#365670}
@media print{
 #printRoot .v14-art-leaf{font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif!important;padding:3mm 3.8mm 2mm!important;}
 #printRoot .v14-art-leafhead{padding-bottom:1.2mm!important;margin-bottom:1.8mm!important}
 #printRoot .v14-art-leafhead>b{font-size:10px!important}
 #printRoot .v14-art-leafhead>span{font-size:8px!important}
 #printRoot .v14-art-bigtitle{font-size:12px!important;margin:1mm 0 2mm!important;padding:1mm!important}
 #printRoot .v14-art-bigtitle small{font-size:9px!important}
 #printRoot .v14-art-candidates{font-size:10px!important;line-height:1.6!important;padding:2mm!important;margin-bottom:3mm!important}
 #printRoot .v14-art-rule{padding:3mm!important;margin:2mm 0!important}
 #printRoot .v14-art-rule>b{font-size:11px!important}
 #printRoot .v14-art-rule p{font-size:11px!important;line-height:1.3!important;margin:2mm 0!important}
 #printRoot .v14-art-rule small{font-size:9px!important}
 #printRoot .v14-or{margin:2mm auto!important;padding:.5mm!important}
 #printRoot .v14-art-note{font-size:9px!important;line-height:1.3!important;padding:2mm!important}
 #printRoot .v14-art-questions{gap:1.6mm!important}
 #printRoot .v14-art-qa{padding-bottom:1.1mm!important}
 #printRoot .v14-art-q-stem{font-size:12pt!important;line-height:1.1!important}
 #printRoot .v14-art-q-hi{font-size:9pt!important;line-height:1.12!important;margin-top:.6mm!important}
 #printRoot .v14-art-qopts{gap:.6mm 1mm!important;margin-top:.6mm!important}
 #printRoot .v14-art-qopts span{font-size:8.3pt!important;line-height:1.1!important}
 #printRoot .v14-two-omr{width:100%!important;height:194mm!important;break-after:auto!important;max-width:none!important;overflow:hidden!important;margin:0!important;padding:0!important}
 #printRoot .v14-duo{width:100%!important;height:194mm!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}
 #printRoot .v14-omr-half{height:194mm!important;min-height:0!important;max-height:194mm!important;overflow:hidden!important;padding:3.8mm 3mm!important;border:none!important}
 #printRoot .v14-omr-half+.v14-omr-half{border-left:none!important}
 #printRoot .v14-omr-header strong{font-size:10px!important}
 #printRoot .v14-omr-header span{font-size:9px!important}
 #printRoot .v14-omr-header small{font-size:8px!important}
 #printRoot .v14-omr-info{font-size:8.5px!important;line-height:1.5!important;padding:1.2mm 0!important}
 #printRoot .v14-omr-rule{font-size:7.5px!important;margin:1.1mm 0!important}
 #printRoot .v14-omr-rows{gap:2mm!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}
 #printRoot .v14-omr-row{height:5.65mm!important;gap:.7mm!important;padding:0!important;font-size:8px!important}
 #printRoot .v14-omr-row>b{font-size:8px!important;min-width:3mm!important}
 #printRoot .v14-bubble{font-size:7px!important;gap:.3mm!important}
 #printRoot .v14-bubble i{width:2.8mm!important;height:2.8mm!important;min-width:2.8mm!important}
 #printRoot .v14-omr-end{font-size:7.5px!important;margin-top:2mm!important;padding-top:1mm!important}
 #printRoot .v14-cut-line{left:50%!important;display:block!important}
 #printRoot .v14-art-omr-grid{grid-template-columns:1fr 1.2fr!important}
 #printRoot .v14-portrait-mcq{break-inside:avoid!important;page-break-inside:avoid!important}
 #printRoot .v14-portrait-mcq>b{font-size:12pt!important}
}

/* V15: school-style English-medium Visual Arts question paper; black & white print-ready. */
.v15-art-leaf{font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif!important;color:#111f2e;background:white;}
.v15-examhead{border:1.5px solid #142c45;border-top:4px solid #142c45;text-align:center;padding:6px 7px 5px;margin-bottom:7px;}
.v15-school{font-size:12.3px;font-weight:900;letter-spacing:.35px;line-height:1.12;text-transform:uppercase;}
.v15-address{font-size:8px;line-height:1.2;margin:2px 0 4px;}
.v15-examtitle{font-size:10px;font-weight:900;border-top:1px solid #a8b9c6;padding-top:4px;letter-spacing:.15px;}
.v15-metabar{display:flex;justify-content:space-between;gap:6px;border-top:1px dotted #b1bdc9;font-size:8.2px;font-weight:700;margin-top:4px;padding-top:3px;}
.v15-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 9px;font-size:10px;line-height:1.3;margin:4px 0 7px;padding:7px;border:1px solid #b6c3d0;}
.v15-instructions{border:1px solid #b6c3d0;padding:7px 10px 6px;margin-bottom:9px;}
.v15-instructions b{font-size:10px;}
.v15-instructions ol{padding-left:17px;margin:4px 0;}
.v15-instructions li{font-size:9.5px;line-height:1.28;margin:2px 0;}
.v15-instructions small{display:block;font-size:8.8px;color:#3a4e62;}
.v15-art-panel{border:1px solid #9dafc0;border-radius:2px;margin:6px 0;padding:0;}
.v15-panel-title{background:#e8eef3;color:#1b334a;font-size:10px;font-weight:800;line-height:1.25;padding:5px 7px;border-bottom:1px solid #a4b4c1;}
.v15-panel-body{padding:8px;font-size:11.1px;line-height:1.3;}
.v15-panel-body p{margin:4px 0 7px;}
.v15-panel-body small{font-size:9px;color:#3f576a;display:block;}
.v15-option-card{font-size:12pt;line-height:1.28;border-left:3px solid #465b6e;padding:4px 5px;margin:5px 0;font-weight:500;}
.v15-option-card small{font-size:9px;color:#44576a;font-weight:400;}
.v15-or{font-size:10px;letter-spacing:.6px;font-weight:900;text-align:center;margin:7px 0;}
.v15-skill{font-size:9px!important;line-height:1.3!important;color:#3a4e5f;background:#f1f4f7;padding:5px;border-left:2px solid #99aab9;}
.v15-section-intro{font-size:11px;font-weight:700;background:#e8eef3;padding:8px;border:1px solid #adbdca;margin:6px 0;}
.v15-section-intro small{display:block;font-size:9px;font-weight:400;}
.v15-rubric{font-size:9.4px!important;color:#41566b;line-height:1.35!important;}
.v15-criterion{font-size:10.2px;line-height:1.4;background:#eef3f7;border:1px solid #bac9d6;padding:9px;margin:8px 0;}
.v15-tonalbar{display:flex;align-items:center;justify-content:center;gap:4px;font-size:8px;margin:12px auto;}
.v15-tonalbar i{display:block;width:27px;height:18px;border:1px solid #777;background:#fff;}
.v15-tonalbar i:nth-of-type(2){background:#ddd}.v15-tonalbar i:nth-of-type(3){background:#aaa}.v15-tonalbar i:nth-of-type(4){background:#666}.v15-tonalbar i:nth-of-type(5){background:#222}
.v15-mcqtitle{font-size:12px;font-weight:900;text-align:center;border-bottom:1.5px solid #263d55;padding:5px 0;margin:4px 0 9px;}
.v15-mcqtitle small{display:block;font-size:9px;font-weight:500;}
.v15-quizgrid{gap:4px;}
.v15-art-leaf .v14-art-q-stem{font-size:12pt!important;line-height:1.22;}
.v15-art-leaf .v14-art-q-hi{font-size:8pt!important;line-height:1.15;}
.v15-art-leaf .v14-art-qopts{gap:2px 6px;}
.v15-art-leaf .v14-art-qopts span{font-size:8.65pt;line-height:1.17;}
.v15-art-leaf .v14-art-qa{padding-bottom:2px;}
.v15-mcqending{font-size:8px;margin-top:6px;text-align:center;color:#4c6272;}
.v15-booklet-footer{margin-top:auto;padding-top:4px;}
@media print{#printRoot .v15-examhead{-webkit-print-color-adjust:exact;print-color-adjust:exact}}

/* V16: Every student-facing Art and GK option is English + Hindi. Print-friendly split. */
.v16-qenglish{display:block;font-size:inherit;font-weight:700}.v16-qhindi{display:block;font-size:.87em;font-weight:500;line-height:1.27;color:#39526a;margin-top:1.5px}
.v16-hi-instructions{border-top:1px dotted #b5c5d4;padding-top:3px;margin-top:4px}.v16-hi-instructions b{font-size:9px}.v16-hi-instructions ol{margin:3px 0;padding-left:17px}
.v16-hi-instructions li{font-size:8.6px;line-height:1.22!important;margin:1px 0!important}
.v14-art-qopts .v16-art-option-hi{font-weight:400;display:block;font-size:7.4pt;color:#455e73;line-height:1.1;margin-left:12px}
.v14-portrait-mcq span small{display:block;color:#3f566e;font-size:9px}
.v15-art-leaf .v14-art-q-hi{font-size:8.4pt!important;line-height:1.14!important;font-weight:500}
.v15-art-leaf .v14-art-q-stem{font-size:12pt!important;line-height:1.14!important}
.v15-art-leaf .v14-art-qopts span{font-size:8.3pt!important;line-height:1.12!important}
.v15-art-leaf .v14-art-qa{padding-bottom:2px!important}
.v15-art-leaf .v14-art-questions{gap:2.4px!important}
@media print {
 #printRoot .v15-art-leaf .v14-art-q-stem{font-size:12pt!important;line-height:1.1!important}
 #printRoot .v15-art-leaf .v14-art-q-hi{font-size:8.25pt!important;line-height:1.1!important}
 #printRoot .v15-art-leaf .v14-art-qopts span{font-size:8.0pt!important;line-height:1.08!important}
 #printRoot .v15-art-leaf .v16-art-option-hi{font-size:7.1pt!important;line-height:1.05!important;margin-left:8px!important}
 #printRoot .v15-art-leaf .v14-art-questions{gap:1.2mm!important}
 #printRoot .v16-hi-instructions li{font-size:8px!important;line-height:1.12!important}
}

/* V16 press-proof: larger bilingual choices in readable 8-page Art booklet. */
.v15-art-leaf .v14-art-qopts span{font-size:9.6pt!important;line-height:1.24!important}
.v15-art-leaf .v14-art-q-hi{font-size:9.3pt!important;line-height:1.24!important}
.v15-art-leaf .v16-art-option-hi{font-size:9.05pt!important;line-height:1.18!important;margin-left:11px!important}
@media print{
 #printRoot .v15-art-leaf .v14-art-qopts span{font-size:9.35pt!important;line-height:1.17!important}
 #printRoot .v15-art-leaf .v14-art-q-hi{font-size:9.1pt!important;line-height:1.19!important}
 #printRoot .v15-art-leaf .v16-art-option-hi{font-size:8.8pt!important;line-height:1.14!important;margin-left:8px!important}
}

.v17-compact{padding:8px 9px 6px}
.v17-examhead .v15-examtitle{font-size:14px}
.v17-miniinfo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 8px;font-size:11px;margin:6px 0 8px}
.v17-note,.v17-footnote,.v17-footerfill{font-size:11px;line-height:1.32;border:1px solid #d5e0ea;background:#f8fbff;padding:6px 7px;border-radius:8px;margin:6px 0}
.v17-box{border:1px solid #cad7e6;border-radius:10px;padding:8px;margin:6px 0;background:#fff}
.v17-title{font-weight:800;font-size:12px;margin-bottom:6px;color:#14324d}
.v17-option{font-size:12px;line-height:1.34;margin:6px 0;padding:5px 6px;border:1px solid #dde7f0;border-radius:8px;background:#fcfdff}
.v17-option small,.v17-rubric small,.v17-opts small{display:block;font-size:10.3px;color:#445566;line-height:1.28;margin-top:1px}
.v17-or{text-align:center;font-weight:800;font-size:11px;color:#8b2f2f;margin:4px 0}
.v17-skill,.v17-rubric{font-size:10.8px;line-height:1.3;margin-top:6px;color:#234}
.v17-mcqhead{font-weight:800;font-size:12px;background:#edf4fb;border:1px solid #d6e3f1;padding:6px 7px;border-radius:8px;margin:5px 0 7px;color:#12324d}
.v17-miniqa{border:1px solid #dde6ef;border-radius:8px;padding:5px 6px;margin:5px 0;background:#fff}
.v17-qen{font-size:11.2px;line-height:1.25;font-weight:700}
.v17-qhi{font-size:10.1px;line-height:1.22;color:#425466;margin:1px 0 3px}
.v17-opts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2px 8px}
.v17-opts span{font-size:10.2px;line-height:1.2}


.v17-compact .v15-examhead,.v17-compact .v17-mcqhead,.v17-compact .v17-box,.v17-compact .v17-note,.v17-compact .v17-footnote,.v17-compact .v17-footerfill{break-inside:avoid}
.v17-compact .v13-booklet-foot,.v17-compact .v15-booklet-footer{margin-top:auto;position:sticky;bottom:0;background:#fff}
.v17-compact{min-height:100%;display:flex;flex-direction:column}
.v17-compact .v17-miniqa{padding:4px 5px;margin:3px 0}
.v17-compact .v17-qen{font-size:10.3px;line-height:1.18}
.v17-compact .v17-qhi{font-size:9.1px;line-height:1.13;margin:1px 0 2px}
.v17-compact .v17-opts{gap:1px 6px}
.v17-compact .v17-opts span{font-size:9.0px;line-height:1.12}
.v17-compact .v17-miniinfo{font-size:10.3px;gap:3px 7px}
.v17-compact .v17-title{font-size:11.4px}
.v17-compact .v17-option{font-size:11px;line-height:1.24;padding:4px 5px;margin:4px 0}
.v17-compact .v17-option small,.v17-compact .v17-rubric small{font-size:9.5px}
.v17-compact .v17-rubric,.v17-compact .v17-skill,.v17-compact .v17-note,.v17-compact .v17-footnote,.v17-compact .v17-footerfill{font-size:9.8px;line-height:1.18}
.v17-compact .v15-examhead .v15-school{font-size:14px}
.v17-compact .v15-examhead .v15-address{font-size:9.3px}
.v17-compact .v15-examhead .v15-metabar{font-size:9.3px}


/* V19: fixed header/footer per A5 booklet page (one A4 landscape, two-up duplex). */
.v19-leaf{display:flex;flex-direction:column;position:relative;min-width:0;box-sizing:border-box;background:#fff;color:#13283f;overflow:hidden}
.v19-head{flex:0 0 auto;border-top:4px solid #173a59;border-bottom:1.5px solid #90adc1;text-align:center;background:linear-gradient(180deg,#eef5fa,#fff);padding:4px 5px 3px}
.v19-school{font-size:12.2px;font-weight:900;letter-spacing:.2px;line-height:1.12}
.v19-address{font-size:8.3px;color:#476078;line-height:1.15;margin:2px 0}
.v19-exam{font-size:9.3px;font-weight:800;line-height:1.15}
.v19-subhead{display:flex;justify-content:space-between;gap:4px;margin-top:3px;font-size:8.2px;font-weight:800;border-top:1px dotted #b7c7d4;padding-top:2px}
.v19-body{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;padding:3px 0 4px}
.v19-fixed-foot{flex:0 0 auto;display:flex;justify-content:space-between;gap:4px;background:#fff;border-top:1px solid #547a9b;padding:3px 0 1px;font-size:7.2px;color:#244b69;line-height:1.1;font-weight:700;margin-top:auto}
.v19-student{display:flex;flex-wrap:wrap;gap:2px 9px;font-size:8.9px;font-weight:700;border-bottom:1px dotted #cedce7;padding:2px 0 4px;margin-bottom:4px}
.v19-instruction,.v19-choice,.v19-assessment{font-size:9.6px;line-height:1.22;margin:3px 0 6px}
.v19-task{border:1px solid #acc2d5;border-radius:5px;padding:7px 7px 5px;margin:5px 0;background:#fff}
.v19-task-title{font-size:11px;line-height:1.25;display:block;background:#eaf2f8;margin:-7px -7px 5px;padding:5px 7px}
.v19-option{font-size:11px;line-height:1.3;margin:5px 0;padding:4px 4px;background:#f9fcff}
.v19-option small{font-size:10px;line-height:1.22;display:block;color:#3b5269;margin-left:14px}
.v19-or{text-align:center;font-weight:900;font-size:9px;margin:2px auto}
.v19-skill{font-size:9.6px;margin:5px 0 2px}
.v19-sketchpad{flex:1;min-height:55px;margin:8px 1px 0;border:1px dashed #a7bccd;border-radius:6px;padding:8px;display:flex;flex-direction:column;gap:5px;background:#fbfdff}.v19-sketchpad>b{font-size:9px;color:#34506a}.v19-sketchpad>small{font-size:8.2px;color:#65788a}.v19-sketch-lines{flex:1;min-height:35px;background:repeating-linear-gradient(transparent,transparent 23px,#e1eaf2 24px)}
.v19-mcq-head{display:flex;justify-content:space-between;gap:4px;align-items:center;border-bottom:1px solid #afc5d6;font-size:9.5px;font-weight:800;margin:2px 0 3px;padding-bottom:3px}
.v19-mcq-head small{font-size:8.4px;font-weight:500;max-width:44%;text-align:right}
.v19-qa-list{display:flex;flex-direction:column;flex:1;justify-content:space-between;gap:1px}
.v19-qa{border-bottom:1px dotted #d0dde8;padding:2px 0;break-inside:avoid}
.v19-qa:last-child{border:0}
.v19-stem{font-size:9.65px;line-height:1.18;font-weight:750}
.v19-stem span{float:right;font-size:7.8px;color:#456278}
.v19-stem small{display:block;font-size:9px;font-weight:500;color:#43586a;line-height:1.15;margin-top:1px}
.v19-answers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:5px;row-gap:1px;margin:2px 0 1px}
.v19-answers span{font-size:8.8px;line-height:1.12;min-width:0;overflow-wrap:anywhere}
.v19-answers small{display:inline;font-size:8.35px;color:#43586a;line-height:1.1}
@media print{
  #printRoot .v19-leaf{height:194mm!important;min-height:0!important;max-height:194mm!important;overflow:hidden!important;box-sizing:border-box!important;padding:2.6mm 3.25mm 2.6mm!important}
  #printRoot .v19-head{padding:1mm 1mm .7mm!important}
  #printRoot .v19-body{padding:.6mm 0!important}
  #printRoot .v19-qa-list{gap:0!important}
  #printRoot .v19-qa{padding:.4mm 0!important}
  #printRoot .v19-fixed-foot{margin-top:auto!important;position:relative!important;bottom:0!important}
}


/* V21 independent fixed portrait sheet. Only the pre-primary module uses these rules. */
.v20-pre-print-page{width:194mm;max-width:194mm;min-width:194mm;height:278mm;margin:0 auto 14px;background:#fff;color:#172536;box-sizing:border-box;box-shadow:0 4px 22px #102b4516;overflow:visible}
.v20-pre-sheet{height:278mm;width:194mm;box-sizing:border-box;padding:3mm 3mm 3mm;display:flex;flex-direction:column;background:#fff;font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif;overflow:visible}
.v20-pre-head{flex:0 0 auto;text-align:center;border-bottom:1.8px solid #344c61;padding:0 0 6px}
.v20-school{font-size:17px;line-height:1.15;font-weight:800;letter-spacing:.25px}
.v20-school-address{font-size:10px;color:#4b5d70;margin:3px 0}
.v20-examname{font-size:12.5px;letter-spacing:.35px;line-height:1.25;font-weight:800;margin-top:4px;padding:5px 6px;background:#eaf1f8;border-top:1px solid #bfcbd8;border-bottom:1px solid #bfcbd8}
.v20-meta{display:flex;flex-wrap:wrap;justify-content:center;column-gap:13px;row-gap:3px;font-size:9px;margin-top:6px}
.v20-student{display:flex;justify-content:space-between;gap:7px;flex-wrap:wrap;font-size:9px;text-align:left;padding:6px 0 1px}
.v20-pre-guide{border:1px solid #d6e0ec;background:#f8fafc;padding:5px 7px;margin:6px 0 4px;font-size:9.2px;line-height:1.25;flex:0 0 auto}
.v20-level{margin-top:3px;color:#324e67;font-size:8.7px}
.v20-preq-grid{flex:1 1 0;min-height:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:max-content;align-content:space-evenly;align-items:start;gap:7px 9px;overflow:visible;padding:1px 0}
.v20-preq{break-inside:avoid;page-break-inside:avoid;border:1px solid #dbe4ee;border-radius:7px;padding:9px 10px 10px;font-size:13.2px;line-height:1.35;min-width:0;overflow-wrap:anywhere;background:#fff}
.v20-preq h4{font-size:14px;line-height:1.35;margin:0 0 7px;font-weight:700;position:relative;padding-right:31px}
.v20-preq h4 .v16-qenglish{display:block}
.v20-preq h4 .v16-qhindi{display:block;color:#455c6d;font-size:12px;font-weight:500}
.v20-marks{font-size:11.5px;position:absolute;top:0;right:0}
.v20-preq .exam-qbody{font-size:13.2px;line-height:1.35}
.v20-preq .exam-qbody p{margin:2px 0}
.v20-preq svg{max-height:53px;max-width:67px;vertical-align:middle}
.v20-preq .blank-art{height:61px;border:1px dashed #aebccc;flex:1;min-width:60px}
.v20-preq .blank-art.tall{height:84px}
.v20-preq .art-example{display:flex;align-items:center;gap:5px}
.v20-preq .practice-dots{font-size:15px;line-height:1.15}
.v20-preq .trace{font-size:24px;display:inline-flex;margin:3px 6px;border-bottom:1px dotted #738495;min-width:19px;justify-content:center}
.v20-preq .shape-row svg{max-height:45px}
.v20-pre-footer{flex:0 0 auto;margin-top:auto;display:flex;justify-content:space-between;gap:7px;align-items:center;border-top:1.5px solid #344c61;min-height:10mm;padding-top:5px;font-size:8.7px;font-weight:600}
.v20-page-measurer{position:absolute;left:-20000px;top:0;width:194mm;visibility:hidden;pointer-events:none;z-index:-1}
.v20-dense .v20-preq-grid{gap:3px 5px;align-content:space-evenly}
.v20-dense .v20-preq{padding:6px 7px;font-size:11.8px;line-height:1.29}
.v20-dense .v20-preq h4{font-size:12px;margin-bottom:3px;line-height:1.24}
.v20-dense .v20-preq .exam-qbody{font-size:11.8px;line-height:1.28}
.v20-dense .v20-preq .blank-art{height:48px}
.v20-dense .v20-preq .blank-art.tall{height:67px}
@media(max-width:740px){.v20-pre-print-page{transform-origin:top left;max-width:194mm}}
@media print{
 #printRoot .v20-pre-print-page{width:194mm!important;max-width:194mm!important;min-width:194mm!important;height:278mm!important;margin:0!important;padding:0!important;overflow:visible!important;box-shadow:none!important;transform:none!important;break-inside:avoid!important;page-break-inside:avoid!important}
 #printRoot .v20-pre-sheet{height:278mm!important;width:194mm!important;padding:3mm 3mm 3mm!important;overflow:visible!important}
 #printRoot .v20-preq-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px 9px!important;align-content:space-evenly!important}
 #printRoot .v20-dense .v20-preq-grid{gap:3px 5px!important}
 #printRoot .v20-preq{padding:9px 10px 10px!important}
 #printRoot .v20-dense .v20-preq{padding:6px 7px!important}
 #printRoot .v20-preq h4{font-size:14px!important}
 #printRoot .v20-dense .v20-preq h4{font-size:12px!important}
 #printRoot .v20-preq .exam-qbody{font-size:13.2px!important}
 #printRoot .v20-dense .v20-preq .exam-qbody{font-size:11.8px!important}
 #printRoot .v20-preq .blank-art{height:61px!important}
 #printRoot .v20-dense .v20-preq .blank-art{height:48px!important}
 #printRoot .v20-preq .blank-art.tall{height:84px!important}
 #printRoot .v20-dense .v20-preq .blank-art.tall{height:67px!important}
}


/* V21 all subject preparation sheets: fixed A4 portrait; footer anchored to bottom. */
.v21-plan-page{width:194mm;max-width:194mm;min-width:194mm;height:278mm;box-sizing:border-box;margin:0 auto 14px;background:#fff;color:#1b2c3b;box-shadow:0 5px 20px #1a2b4015}
.v21-plan-sheet{width:100%;height:100%;box-sizing:border-box;padding:4mm;display:flex;flex-direction:column;background:white;overflow:hidden;font-family:Arial,'Noto Sans Devanagari','Mangal',sans-serif}
.v21-plan-head{border-bottom:2px solid #1b4260;text-align:center;flex-shrink:0;padding-bottom:8px}
.v21-plan-head strong{display:block;font-size:17px;line-height:1.2}
.v21-plan-head small{display:block;font-size:9px;color:#526477;margin:2px 0}
.v21-plan-head h2{font-size:13px;background:#ebf2f8;padding:5px 3px;margin:4px 0;font-weight:800}
.v21-plan-meta{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;font-size:9.5px;font-weight:700}
.v21-plan-summary{flex-shrink:0;font-size:10px;line-height:1.4;padding:7px 8px;background:#f6f9fd;border:1px solid #dce5ee;border-radius:7px;margin:7px 0}
.v21-overview-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:repeat(3,minmax(0,1fr));gap:7px;flex:1;min-height:0}
.v21-plan-card{border:1px solid #dae4ec;border-radius:8px;padding:7px 9px;overflow:hidden;min-width:0}
.v21-plan-card h3{font-size:11px;margin:0 0 4px;padding-bottom:3px;border-bottom:1px solid #edf1f5;display:flex;justify-content:space-between}
.v21-plan-card h3 small{font-size:8px;color:#46617b}
.v21-plan-card>b{font-size:9px;color:#204d6c;display:block;margin-top:3px}
.v21-plan-card ol,.v21-plan-card ul{font-size:9px;line-height:1.28;padding-left:15px;margin:3px 0}
.v21-plan-card li{margin:2px 0;overflow-wrap:anywhere}
.v21-subheading{font-size:11.2px;background:#edf3f9;margin:7px 0 4px;padding:5px 7px}
.v21-week-list{display:grid;grid-template-columns:1fr 1fr;gap:7px 8px;flex:1 1 auto;align-content:space-evenly}
.v21-week-row{display:flex;align-items:flex-start;gap:5px;border:1px solid #e0e6ec;border-radius:5px;font-size:11px;padding:8px}
.v21-week-row strong{white-space:nowrap;font-size:9px;color:#24466c}
.v21-week-row span{flex:1;min-width:0}
.v21-week-row i{display:block;font-style:normal;font-size:8px;color:#607386}
.v21-competency-list{display:grid;grid-template-columns:1fr 1fr;gap:7px 8px;flex:1 1 auto;align-content:space-evenly}
.v21-competency{border:1px solid #e0e6ec;border-radius:5px;padding:9px;display:flex;gap:6px;font-size:11px}
.v21-competency span{flex:1;min-width:0}
.v21-competency small{display:block;font-size:9px;margin-top:2px;color:#506276;line-height:1.25;overflow-wrap:anywhere}
.v21-competency em{font-size:9px;white-space:nowrap;color:#556a7e}
.v21-plan-instruction{font-size:9.7px;line-height:1.35;padding:7px;border:1px solid #dce4ed;margin:8px 0 0}
.v21-plan-footer{margin-top:auto;flex-shrink:0;border-top:1.5px solid #1b4260;padding-top:7px;display:flex;justify-content:space-between;align-items:center;gap:7px;font-size:8.5px;font-weight:700}
@media print{
 #printRoot .v21-plan-page{width:194mm!important;max-width:194mm!important;min-width:194mm!important;height:278mm!important;margin:0!important;padding:0!important;break-inside:avoid!important;page-break-inside:avoid!important;box-shadow:none!important;overflow:hidden!important}
 #printRoot .v21-plan-sheet{width:100%!important;height:100%!important;padding:4mm!important}
}


/* RESTORED CLASSIC PRE-PRIMARY A4 STYLE (derived from original first release) */
.v22-classic-page{box-sizing:border-box;width:194mm;max-width:194mm;height:278mm;margin:0 auto 12px;background:#fff;color:#111827;box-shadow:0 5px 26px #071b331a;overflow:visible}
.v22-classic-sheet{width:194mm;height:278mm;box-sizing:border-box;padding:4mm 5mm 3.2mm;display:flex;flex-direction:column;font-family:'Noto Sans Devanagari','Mangal',Arial,sans-serif;line-height:1.37;background:#fff}
.v22-classic-header{text-align:center;border-bottom:2px solid #182a3b;padding:2px 0 7px;flex:0 0 auto}
.v22-classic-header h1{font-size:20px;line-height:1.15;margin:0 0 3px;color:#111827;font-weight:800}
.v22-classic-header p{font-size:10.8px;margin:1px 0 7px;color:#344354}
.v22-classic-header h2{font-size:14px;font-weight:760;line-height:1.3;margin:4px 0}
.v22-classic-header h3{font-size:13px;font-weight:800;margin:3px 0}
.v22-classic-meta{display:grid;grid-template-columns:1fr 1fr;gap:4px 20px;padding:9px 2px;border-bottom:1px solid #97a4b2;font-size:12px;flex:0 0 auto}
.v22-classic-ident{display:grid;grid-template-columns:1.4fr 1fr;gap:8px 15px;font-size:11.7px;padding:13px 2px 10px;flex:0 0 auto}
.v22-classic-instructions{border:1px solid #cbd4db;background:#f5f7f9;border-radius:4px;padding:8px 9px;font-size:11px;line-height:1.35;margin:0 0 7px;flex:0 0 auto}
.v22-classic-questions{display:flex;flex:1 1 0;min-height:0;flex-direction:column;justify-content:space-evenly;gap:7px;padding:4px 1px 5px;overflow:visible}
.v22-exam-question{flex:0 0 auto;padding:10px 3px;border-top:1px dashed #b5c2cd;break-inside:avoid;page-break-inside:avoid;min-width:0}
.v22-exam-question h3{font-size:14px;line-height:1.34;margin:0 0 9px;font-weight:750;color:#111827}
.v22-qmarks{float:right;font-size:11.6px;margin-left:4px;white-space:nowrap}
.v22-exam-question .exam-qbody{font-size:13px;line-height:1.46}
.v22-exam-question .exam-qbody p{margin:6px 0}
.v22-exam-question .questions-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 18px}
.v22-exam-question .opt-line{display:flex;gap:9px;align-items:center;min-height:25px;flex-wrap:wrap;margin:4px 0}
.v22-exam-question .choices{display:inline-flex;gap:6px;align-items:center;flex-wrap:wrap}
.v22-exam-question svg{max-width:82px;max-height:65px;vertical-align:middle;flex-shrink:0}
.v22-exam-question .shape-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.v22-exam-question .shape-tile{display:flex;align-items:center;flex-direction:column}
.v22-exam-question .traces{display:flex;gap:12px;justify-content:space-around;margin:8px 0;flex-wrap:wrap}
.v22-exam-question .trace{font-size:32px;color:#abb3bc;border-bottom:1px dotted #89939e;min-width:40px;text-align:center}
.v22-exam-question .answer-lines{display:flex;flex-direction:column;gap:8px;margin:8px 0}
.v22-exam-question .answer-lines i{border-bottom:1px solid #a1aab5;height:9px}
.v22-exam-question .blank-art{min-height:72px;border:1px solid #c2ccd7;flex:1;min-width:100px}
.v22-exam-question .blank-art.tall{min-height:98px}
.v22-exam-question .art-example{display:flex;gap:8px;align-items:center}
.v22-exam-question .practice-dots{font-size:18px;letter-spacing:2px}
.v22-exam-question .counters{display:inline-flex;max-width:170px;flex-wrap:wrap}
.v22-exam-question .microtask{font-size:10.5px;color:#284059;margin:5px 0 0;border-top:1px dashed #bcc8d3}
.v22-classic-footer{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px;border-top:1px solid #8e9aa7;padding-top:7px;margin-top:auto;font-size:10.7px;color:#354658;min-height:16px}
.v22-classic-measure{position:absolute;left:-20000px;top:0;visibility:hidden;pointer-events:none;z-index:-1;width:194mm}
.v22-compact .v22-classic-header h1{font-size:18px}
.v22-compact .v22-classic-ident{padding:8px 2px}
.v22-compact .v22-classic-instructions{font-size:10px;padding:5px 7px;margin:0 0 4px}
.v22-compact .v22-classic-questions{gap:2px;padding:0 1px}
.v22-compact .v22-exam-question{padding:6px 3px}
.v22-compact .v22-exam-question h3{font-size:12.5px;margin-bottom:5px}
.v22-compact .v22-exam-question .exam-qbody{font-size:11.8px;line-height:1.3}
.v22-compact .v22-exam-question .opt-line{min-height:20px;margin:2px 0}
.v22-compact .v22-exam-question svg{max-width:69px;max-height:49px}
.v22-compact .v22-exam-question .blank-art{min-height:52px}
.v22-compact .v22-exam-question .blank-art.tall{min-height:76px}
.v22-compact .v22-exam-question .trace{font-size:25px}
@media print{
 #printRoot .v22-classic-page{width:194mm!important;max-width:194mm!important;min-width:194mm!important;height:278mm!important;min-height:278mm!important;max-height:278mm!important;margin:0!important;padding:0!important;box-shadow:none!important;break-after:page;page-break-after:always;break-inside:avoid;page-break-inside:avoid}
 #printRoot .v22-classic-page:last-child{break-after:auto;page-break-after:auto}
 #printRoot .v22-classic-sheet{height:278mm!important;width:194mm!important;padding:4mm 5mm 3.2mm!important}
 #printRoot .v22-classic-questions{display:flex!important;flex-direction:column!important;justify-content:space-evenly!important;gap:7px!important}
 #printRoot .v22-compact .v22-classic-questions{gap:2px!important}
 #printRoot .v22-classic-header,#printRoot .v22-classic-footer{display:block!important}
 #printRoot .v22-classic-footer{display:flex!important}
}
@media(max-width:740px){.v22-classic-page{max-width:100%;width:194mm;overflow:visible}}

/* Mild tightening only when the restored full-size paper cannot fit A4. */
.v22-tight .v22-classic-questions{gap:1px}
.v22-tight .v22-exam-question{padding:3px 3px}
.v22-tight .v22-exam-question h3{margin-bottom:3px}
.v22-tight .v22-exam-question .exam-qbody{font-size:11.5px;line-height:1.24}
.v22-tight .v22-exam-question .opt-line{min-height:18px;margin:1px 0}
.v22-tight .v22-exam-question .questions-grid{gap:3px 14px}
.v22-tight .v22-exam-question svg{max-height:44px;max-width:62px}
.v22-tight .v22-exam-question .traces{margin:4px 0}
.v22-tight .v22-exam-question .trace{font-size:23px}
.v22-tight .v22-exam-question .blank-art{min-height:44px}
.v22-tight .v22-exam-question .blank-art.tall{min-height:65px}
@media print{#printRoot .v22-tight .v22-classic-questions{gap:1px!important}}

.v24-compare-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:12px 0}
.v24-compare-col{border:1px solid #c9d9e5;border-radius:14px;padding:10px;background:#fff;min-width:0}
.v24-compare-col h3{font-size:14px;line-height:1.3;margin:0 0 12px;color:#183853}
.v24-compare-q{border-bottom:1px solid #e0e9f1;padding:9px 2px;font-size:12px;line-height:1.42;overflow-wrap:anywhere}
.v24-compare-q b{display:block;color:#123a5a}
.v24-compare-q div{margin-top:4px}
.v24-tag{font-weight:600}
.v24-picture{max-width:100%;overflow:hidden}
.v24-final-exercise{margin-top:5px;border-top:1px dashed #ccd9e5;padding-top:4px;font-size:11px;line-height:1.25}
.v24-pair-shapes{display:flex;gap:8px;align-items:center}.v24-pair-shapes svg{max-width:43%;height:30px}
@media(max-width:850px){.v24-compare-grid{grid-template-columns:1fr}}
@media print{.v24-compare-grid{display:none}}

.v25-practice-rows{display:grid;grid-template-columns:1fr 1fr;gap:4px 12px;margin:5px 0}
.v25-practice-row{font-size:inherit;line-height:1.5;min-width:0}
.v25-answer-space{display:flex;flex-direction:column;gap:6px;margin:7px 0 4px;white-space:nowrap;overflow:hidden}
.v25-answer-space span{letter-spacing:1.2px;color:#8592a1}
.v25-sketch-box{height:56px;border:1px solid #9caebe;border-radius:6px;margin:5px 0;text-align:center;color:#6c8398;display:flex;align-items:center;justify-content:center;font-size:10px}
.v25-oral-score{border:1px dashed #bbc9d7;border-radius:6px;padding:5px;margin:5px 0;font-size:10px}
.v22-classic-page[data-pre-grade="LKG"] .v25-practice-row,.v22-classic-page[data-pre-grade="UKG"] .v25-practice-row{font-size:12px}
@media print{.v25-answer-space span{letter-spacing:1px}.v25-sketch-box{break-inside:avoid}}

.v25-plan-goals{display:flex;flex:1 1 auto;flex-direction:column;justify-content:space-evenly;gap:8px;min-height:0;padding:6px 0}
.v25-plan-goal{border:1px solid #d8e2eb;border-radius:9px;padding:9px 11px;font-size:12px;line-height:1.38;break-inside:avoid}
.v25-plan-goal b{display:block;font-size:12px;color:#153d5e}
.v25-plan-goal p{margin:4px 0 0;font-size:10.5px;color:#31455a}

/* V26: age-appropriate visual Art; preserve V22 single-column A4 classic layout. */
.v26-settings-card{border:1px solid #c7d8e8;background:#f3f8ff;padding:14px;border-radius:14px;grid-column:1/-1;margin:3px 0 7px}
.v26-settings-head{display:flex;gap:6px;flex-direction:column;font-size:14px;color:#16344e}
.v26-settings-head small,.v26-settings-help{font-size:11px;color:#475f72}
.v26-settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:12px 0}
.v26-settings-grid label{font-size:12px;font-weight:700}.v26-settings-grid input{display:block;width:100%;margin-top:4px;padding:9px;border:1px solid #adbfce;border-radius:8px;font-size:16px}
.v26-art-picture{display:flex;justify-content:center;align-items:center;min-height:62px}
.v26-art-svg{max-width:95%;height:auto;max-height:95px;width:auto;display:block}
.v26-art-choice{display:flex;justify-content:space-around;gap:8px;align-items:center}
.v26-art-choice .v26-art-svg{flex:1;min-width:0;max-height:53px}
.v26-art-space{height:92px;border:1.5px dashed #a5b3bf;border-radius:7px;display:flex;justify-content:center;align-items:flex-start;padding:3px;font-size:9px;color:#60717f}
.v26-art-pattern{text-align:center;font-size:23px;letter-spacing:2px;padding:8px}
.v22-classic-page[data-pre-subject="Art"] .v22-exam-question{break-inside:avoid}
@media print{.v26-settings-card{display:none!important}}

/* Art illustrations must remain large in compact fit modes */
.v22-classic-page[data-pre-subject="Art"] .v22-exam-question svg.v26-art-svg,
.v22-classic-page[data-pre-subject="Art"].v22-compact .v22-exam-question svg.v26-art-svg,
.v22-classic-page[data-pre-subject="Art"].v22-tight .v22-exam-question svg.v26-art-svg{max-height:112px;max-width:230px;width:230px;height:auto}
.v22-classic-page[data-pre-subject="Art"] .v26-art-choice svg.v26-art-svg,
.v22-classic-page[data-pre-subject="Art"].v22-compact .v26-art-choice svg.v26-art-svg{max-width:150px;max-height:78px;width:150px;height:auto}
.v22-classic-page[data-pre-subject="Art"] .v26-art-picture{height:103px;overflow:hidden}
</style><style id="ldm-v283-modern-paper-ui">
@media screen{
body{background:#edf4fa;color:#17304b;font-family:system-ui,-apple-system,"Noto Sans Devanagari",sans-serif}
.header{padding-top:22px;padding-bottom:22px;background:linear-gradient(110deg,#0c2d56,#145c9a 70%,#148283)}
.header h1{font-size:clamp(18px,3vw,25px);line-height:1.25}
.wrap{max-width:1140px;padding:18px 12px 55px}
.paper-hub-back{display:inline-flex;align-items:center;min-height:42px;font-size:13px;font-weight:850;border:1px solid #c8d9e7;background:#fff;padding:9px 14px;border-radius:11px;color:#214b68;text-decoration:none}
.main-panel{border-radius:22px;padding:clamp(18px,3vw,26px);box-shadow:0 14px 34px #163c6110;border-color:#d8e4ed}
.main-panel h2{font-size:clamp(20px,2.7vw,25px);line-height:1.3}
.hero-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}
.module{min-height:191px;display:flex;flex-direction:column;justify-content:flex-start;border-radius:19px;padding:21px;box-shadow:0 12px 23px #183c5b10;background:linear-gradient(145deg,#fff,#f1f8ff);border:1px solid #d9e6ef;transition:transform .15s ease,border-color .15s ease}
.module .emoji{font-size:28px;border-radius:14px;padding:7px 11px;background:#e4f1ff;width:max-content}
.module strong{font-size:17px;line-height:1.4;margin:12px 0 7px}
.module span:last-child{color:#61748d;font-size:12px;line-height:1.5}
.module:hover{transform:translateY(-2px);border-color:#81b9dd}
.module:nth-child(2){background:linear-gradient(145deg,#fff,#f7f0ff)}
.module:nth-child(3){background:linear-gradient(145deg,#fff,#effaf6)}
.stats{gap:10px}.stat{border-radius:14px;box-shadow:0 5px 20px #14395b0b}
.stat b{font-size:23px}
.quicknav{align-items:center}
#app > .main-panel:nth-of-type(1){margin-top:2px}
@media(max-width:720px){.hero-cards{grid-template-columns:1fr;gap:10px}.module{min-height:126px;padding:16px}.module strong{margin:6px 0 4px}.module .emoji{font-size:23px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.header p{font-size:11px}.header .brand{align-items:flex-start}.mark{flex-basis:45px;height:45px}}
@media(prefers-reduced-motion:reduce){.module{transition:none}}
}
</style></head>
<body>
<header class="header"><div class="brand"><div class="mark">LDM</div><div><div class="eyebrow">SKY SIR · ENGLISH MEDIUM SCHOOL · OFFLINE EXAM STUDIO</div><h1>SKY SIR · Modern Exam Paper Studio V26</h1><p>Nursery–UKG Portrait · Drawing Paper Portrait + OMR Landscape · GK Paper + OMR Landscape</p></div></div></header>
<main class="wrap"><nav class="quicknav" aria-label="पेज मार्गदर्शन"><a class="paper-hub-back" href="../hub.html">← Study Hub</a><button id="navBack">← Back / पिछला</button><button id="navHome">⌂ Home / मुख्य</button><span class="last" id="breadcrumb">मुख्य पृष्ठ</span></nav>
