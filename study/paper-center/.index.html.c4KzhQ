\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div></div>","answer":"2, 3, 4, 5","marks":4},{"title":"गिनती सुनिए और सही संख्या पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>5</b><span>　/　</span><b>6</b><span>　/　</span><b>7</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>6</b><span>　/　</span><b>7</b><span>　/　</span><b>8</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>7</b><span>　/　</span><b>8</b><span>　/　</span><b>9</b></div></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><rect x=\"4\" y=\"4\" width=\"12\" height=\"12\"/></g></svg></span>　<div class=\"choices\"><b>8</b><span>　/　</span><b>9</b><span>　/　</span><b>10</b></div></div></div>","answer":"5, 6, 7, 8","marks":4},{"title":"इन अंकों को देखकर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">5</span><span class=\"trace\">6</span><span class=\"trace\">7</span><span class=\"trace\">8</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अंक: 5, 6, 7, 8","marks":4},{"title":"खाली स्थान में अगला अंक लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">6　<span class=\"blank\">_____</span>　8</div><div class=\"opt-line\">7　<span class=\"blank\">_____</span>　9</div><div class=\"opt-line\">8　<span class=\"blank\">_____</span>　10</div></div>","answer":"7, 8, 9","marks":4},{"title":"आकृतियों को पहचानकर नाम बोलिए और गोले को रंगिए।","body":"<div class=\"shape-row\"><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><circle cx=\"35\" cy=\"35\" r=\"25\"/></g></svg><small>गोला / Circle</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><rect x=\"10\" y=\"10\" width=\"50\" height=\"50\"/></g></svg><small>वर्ग / Square</small></span><span class=\"shape-tile\"><svg width=\"65\" height=\"65\" viewBox=\"0 0 70 70\"><g stroke=\"#222\" stroke-width=\"2.3\" fill=\"none\"><path d=\"M35 8L64 61H6Z\"/></g></svg><small>त्रिभुज / Triangle</small></span></div><p class=\"microtask\">Read / पढ़िए: <b>1 · 6 · 5 · 2 · 3</b></p>","answer":"आकृति: circle/गोला, square/वर्ग, triangle/त्रिभुज; गोले को रंगा।; number reading: 1, 6, 5, 2, 3","marks":4}]},"Nursery|3|6|EVS":{"grade":"Nursery","term":3,"year":6,"subject":"EVS","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्र पहचानकर नाम लिखिए / बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"apple\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 27Q35 15 22 32 Q6 57 27 79Q40 93 50 83Q61 93 74 79Q95 56 77 32Q65 16 50 27Z M50 27q-3 -15 8 -20 M53 20q17 -16 30 -5q-9 13 -30 5\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"leaf\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 83Q18 19 83 15Q90 73 13 83Z M13 83Q49 48 83 15 M46 52l-2 -25 M46 52l25 4\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"mango\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M54 24 Q25 14 18 46 Q8 81 39 88 Q69 93 80 61 Q90 31 54 24Z M53 24 Q51 14 58 10 M57 19Q71 8 83 20 Q70 28 57 19Z\"/></g></svg>　<span class=\"blank\">________________</span></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"49\" height=\"49\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"lotus\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 76Q29 56 50 17Q71 56 50 76Z M50 76Q15 58 26 31Q49 43 50 76Z M50 76Q85 58 74 31Q51 43 50 76Z M50 76Q11 83 8 51 Q31 48 50 76Z M50 76Q89 83 92 51Q69 48 50 76Z M12 85h76\"/></g></svg>　<span class=\"blank\">________________</span></div></div>","answer":"सेब, पत्ता, आम, कमल","marks":4},{"title":"अध्यापक प्रश्न पढ़ें; बच्चा सही उत्तर पर गोला लगाए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) कक्षा में किसकी बात सुनें?<div class=\"tiny-options\"><div class=\"choices\"><b>शिक्षक की</b><span>　/　</span><b>टीवी की ही</b><span>　/　</span><b>केवल बाहर की</b></div></div></div><div class=\"opt-line\">(2) किस जानवर की देखभाल करें?<div class=\"tiny-options\"><div class=\"choices\"><b>पालतू जानवर की</b><span>　/　</span><b>केवल खिलौने की</b><span>　/　</span><b>किसी की नहीं</b></div></div></div><div class=\"opt-line\">(3) भारत हमारा क्या है?<div class=\"tiny-options\"><div class=\"choices\"><b>देश</b><span>　/　</span><b>खिलौना</b><span>　/　</span><b>फल</b></div></div></div><div class=\"opt-line\">(4) रात के बाद क्या आता है?<div class=\"tiny-options\"><div class=\"choices\"><b>दिन</b><span>　/　</span><b>हमेशा रात</b><span>　/　</span><b>सिर्फ वर्षा</b></div></div></div></div>","answer":"शिक्षक की; पालतू जानवर की; देश; दिन","marks":4},{"title":"सही (✓) या गलत (✗) लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">पौधों को पानी की ज़रूरत होती है। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">लाल ट्रैफिक लाइट पर दौड़ना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">हमें दोस्तों के साथ अच्छा व्यवहार करना चाहिए। <span class=\"blank\">(　　)</span></div><div class=\"opt-line\">गंदा पानी पीना सुरक्षित है। <span class=\"blank\">(　　)</span></div></div>","answer":"सही, गलत, सही, गलत","marks":4},{"title":"चित्रों को उनके सही नाम से मिलाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">1. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">2. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">3. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"car\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 53h76v24H12Z M29 53l10 -23h26l12 23 M39 34v19 M64 34v19\"/><circle cx=\"29\" cy=\"78\" r=\"9\"/><circle cx=\"72\" cy=\"78\" r=\"9\"/></g></svg>　→　<span class=\"blank\">_________________</span></div><div class=\"opt-line\">4. <svg class=\"drawing\" width=\"40\" height=\"40\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg>　→　<span class=\"blank\">_________________</span></div></div><p><b>नाम:</b> कप • कार • छाता • चाँद</p>","answer":"चाँद, छाता, कार, कप","marks":4},{"title":"तीन मौखिक प्रश्नों का उत्तर बोलिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1) बगीचा साफ रखने का तरीका?</div><div class=\"opt-line\">(2) हमें पौधों के लिए क्या बचाना चाहिए?</div><div class=\"opt-line\">(3) भोजन से पहले क्या करें?</div></div><p class=\"microtask\">Name any two pictures/objects / दो नाम बोलिए: <b>tree/पेड़ · flower/फूल · water/पानी · apple/सेब</b></p>","answer":"उत्तर: कचरा कूड़ेदान में, पानी, हाथ धोएँ; किसी दो वस्तुओं का नाम सही बताना","marks":4}]},"Nursery|3|6|Art":{"grade":"Nursery","term":3,"year":6,"subject":"Art","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"प्रदर्शित चित्र में साफ-सुथरा रंग भरिए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"125\" height=\"125\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"umbrella\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 48 Q14 8 50 10 Q85 10 88 48 Q78 40 68 48 Q58 40 50 48 Q40 40 30 48 Q20 40 12 48 Z M50 48v34q0 16 -17 6\"/></g></svg></div>","answer":"रंग सीमाओं में, प्रयास और साफ-सफाई के आधार पर मूल्यांकन।","marks":4},{"title":"दी हुई आकृति देखकर वैसी ही आकृति बनाइए।","body":"<div class=\"art-example\"><svg class=\"drawing\" width=\"95\" height=\"95\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"cup\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 29h51v50H20Z M71 37h7q22 0 8 23q-6 9 -15 6 M12 84h67\"/></g></svg><div class=\"blank-art\"></div></div>","answer":"मिलती-जुलती आकृति, आकार और हाथ के नियंत्रण को देखें।","marks":4},{"title":"बिंदुओं/रेखाओं को जोड़कर अभ्यास कीजिए।","body":"<div class=\"practice-dots\">● · · · ● · · · ●<br>· · · ● · · · ● · · · ●<br>● · · · ● · · · ●</div>","answer":"बिंदुओं को रेखा से जोड़ने का प्रयास।","marks":4},{"title":"अपने मन से एक सरल चित्र बनाकर रंग भरिए।","body":"<div class=\"blank-art tall\"></div>","answer":"रचनात्मकता, रंग-चयन और प्रयास; एक ही उत्तर अनिवार्य नहीं।","marks":4},{"title":"अध्यापक को अपने चित्र के बारे में दो वाक्य बोलिए।","body":"<div class=\"answer-lines\"><i></i><i></i></div><p class=\"microtask\">Name these shapes/objects before drawing / चित्र बनाने से पहले पहचानें: <b>triangle/त्रिभुज · circle/गोला · flower/फूल</b></p>","answer":"बच्चा चित्र का विषय और उपयोग किए रंग बता सके।; वस्तुओं/आकृतियों का सही नाम और स्वतंत्र प्रयास","marks":4}]},"Nursery|3|6|Oral":{"grade":"Nursery","term":3,"year":6,"subject":"Oral","marks":20,"duration":"व्यक्तिगत गति के अनुसार","qs":[{"title":"गतिविधि 1 — कहानी सुनकर प्रश्न समझना","body":"<p>अध्यापक निर्देश: कहानी सुनकर प्रश्न समझना। उदाहरण सामग्री/संवाद: <b>मनपसंद रंग</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 2 — रंग/आकृति पहचानना","body":"<p>अध्यापक निर्देश: रंग/आकृति पहचानना। उदाहरण सामग्री/संवाद: <b>घर की वस्तु</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 3 — आयु-अनुसार गिनती/जोड़","body":"<p>अध्यापक निर्देश: आयु-अनुसार गिनती/जोड़। उदाहरण सामग्री/संवाद: <b>पेंसिलें</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 4 — स्वच्छता की एक आदत बताना","body":"<p>अध्यापक निर्देश: स्वच्छता की एक आदत बताना। उदाहरण सामग्री/संवाद: <b>फूल</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।","marks":4},{"title":"गतिविधि 5 — साथियों से सहयोग करना","body":"<p>अध्यापक निर्देश: साथियों से सहयोग करना। उदाहरण सामग्री/संवाद: <b>कृपया</b>।</p><div class=\"rubric-row\">□ स्वतंत्र　 □ थोड़ी सहायता से　 □ अधिक अभ्यास चाहिए</div><p class=\"microtask\">Ask any two: <b>Share toys / खिलौने बाँटना | My teacher / मेरे शिक्षक | Water / पानी</b></p>","answer":"अवलोकन आधारित आकलन; निश्चित एकमात्र उत्तर नहीं। बच्चे की प्रगति दर्ज करें।; दो मौखिक प्रतिक्रिया/गतिविधि","marks":4}]},"Nursery|3|7|Hindi":{"grade":"Nursery","term":3,"year":7,"subject":"Hindi","marks":20,"duration":"25–30 मिनट","qs":[{"title":"दिए गए अक्षरों पर उँगली फेरिए और लिखने का प्रयास कीजिए।","body":"<div class=\"traces\"><span class=\"trace\">ध</span><span class=\"trace\">न</span><span class=\"trace\">प</span><span class=\"trace\">फ</span><span class=\"trace\">ब</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"अक्षरों का सही रूप पहचानकर लिखना: ध, न, प, फ, ब","marks":4},{"title":"अध्यापक बोले—प्रत्येक पंक्ति में बताए गए अक्षर पर गोला लगाइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>ब</b><span>　/　</span><b>प</b><span>　/　</span><b>म</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>भ</b><span>　/　</span><b>फ</b><span>　/　</span><b>य</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>म</b><span>　/　</span><b>ब</b><span>　/　</span><b>र</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>य</b><span>　/　</span><b>भ</b><span>　/　</span><b>ल</b></div></div></div>","answer":"क्रम से: प, फ, ब, भ","marks":4},{"title":"चित्र देखकर उसका नाम बोलिए; पहला अक्षर बताइए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"fish\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 50 Q46 12 72 49 Q45 85 15 50 L7 30 L7 70 Z\"/><circle cx=\"59\" cy=\"44\" r=\"3\"/><path d=\"M35 32L42 19 48 32\"/></g></svg> <span class=\"wide-space\">________</span>　 (म / ध)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"house\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 49L50 16 86 49 M21 46v37h58V46 M43 83V59h15v24 M29 53h10v10H29Z\"/></g></svg> <span class=\"wide-space\">________</span>　 (घ / न)</div><div class=\"opt-line\"><svg class=\"drawing\" width=\"54\" height=\"54\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"sun\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"50\" cy=\"50\" r=\"20\"/><path d=\"M50 7v14 M50 79v14 M7 50h14 M79 50h14 M20 20l11 11 M69 69l11 11 M80 20L69 31 M31 69L20 80\"/></g></svg> <span class=\"wide-space\">________</span>　 (स / प)</div></div>","answer":"चित्र/उत्तर: मछली — म, घर — घ, सूरज — स","marks":4},{"title":"खाली स्थान में अगला अक्षर लिखिए।","body":"<div class=\"questions-grid\"><div class=\"opt-line\">न　→　<span class=\"blank\">_____</span>　→　फ</div><div class=\"opt-line\">प　→　<span class=\"blank\">_____</span>　→　ब</div><div class=\"opt-line\">फ　→　<span class=\"blank\">_____</span>　→　भ</div></div>","answer":"बीच के अक्षर: प, फ, ब","marks":4},{"title":"अपना नाम बोलिए और दिए हुए दो अक्षर पहचानिए।","body":"<div class=\"big-writing\">मेरा नाम: ______________________________________</div><div class=\"traces\"><span class=\"trace\">ब</span><span class=\"trace\">भ</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div><p class=\"microtask\">अतिरिक्त ध्वनि-खेल / Sound game: अध्यापक अक्षर बोलें और बच्चा यहाँ पहचाने: <b>ट | च | ड | अ | ज</b></p>","answer":"अध्यापक द्वारा नाम और दोनों अक्षरों की पहचान दर्ज करें।; ध्वनि-खेल: सुनकर सही अक्षर पहचानना","marks":4}]},"Nursery|3|7|English":{"grade":"Nursery","term":3,"year":7,"subject":"English","marks":20,"duration":"25–30 मिनट","qs":[{"title":"Trace and try writing the letters. / अक्षरों पर लिखिए।","body":"<div class=\"traces\"><span class=\"trace\">Y</span><span class=\"trace\">Z</span><span class=\"trace\">A</span><span class=\"trace\">B</span><span class=\"trace\">C</span></div><div class=\"answer-lines small-lines\"><i></i><i></i></div>","answer":"Letters: Y, Z, A, B, C","marks":4},{"title":"Circle the letter that the teacher says.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">(1)　<div class=\"choices\"><b>Z</b><span>　/　</span><b>B</b><span>　/　</span><b>C</b></div></div><div class=\"opt-line\">(2)　<div class=\"choices\"><b>A</b><span>　/　</span><b>C</b><span>　/　</span><b>D</b></div></div><div class=\"opt-line\">(3)　<div class=\"choices\"><b>B</b><span>　/　</span><b>D</b><span>　/　</span><b>E</b></div></div><div class=\"opt-line\">(4)　<div class=\"choices\"><b>C</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b></div></div></div>","answer":"Circle: Z, A, B, C","marks":4},{"title":"Look at the picture. Say the English word and its first letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"tree\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M41 61v27h18V61\"/><path d=\"M18 61 Q5 39 27 31 Q28 10 49 12 Q73 8 77 30 Q101 47 81 63Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>T</b><span>　/　</span><b>U</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"book\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M50 25q-20 -14 -39 -4v58q22 -10 39 6 q18 -16 39 -6V21q-20 -10 -39 4Z M50 25v60 M17 35q18 -6 28 2 M55 37q15 -8 28 -2\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>B</b><span>　/　</span><b>C</b></div></div><div class=\"opt-line\"><svg class=\"drawing\" width=\"51\" height=\"51\" viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"moon\"><g fill=\"none\" stroke=\"#263850\" stroke-width=\"3.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M66 12 Q30 28 39 59 Q46 81 78 78 Q50 98 25 74 Q0 44 25 22 Q42 9 66 12Z\"/></g></svg>　<span class=\"blank\">______</span>　<div class=\"choices\"><b>M</b><span>　/　</span><b>N</b></div></div></div>","answer":"Tree — T, Book — B, Moon — M","marks":4},{"title":"Fill in the missing letter.","body":"<div class=\"questions-grid\"><div class=\"opt-line\">C　<span class=\"blank\">_____</span>　E</div><div class=\"opt-line\">D　<span class=\"blank\">_____</span>　F</div><div class=\"opt-line\">E　<span class=\"blank\">_____</span>　G</div></div>","answer":"D, E, F","marks":4},{"title":"Say your name and circle its first letter (teacher assists).","body":"<div class=\"big-writing\">My name: ____________________________________</div><div class=\"choices\"><b>C</b><span>　/　</span><b>D</b><span>　/　</span><b>E</b><span>　/　</span><b>F</b><span>　/　</span><b>G</b></div><p class=\"microtask\">Quick letter recognition / अक्षर पहचान: <b>R · G · B · F · N</b></p>","answer":"Teacher records recognition of own-name letter.; recognise R, G, B, F, N","marks":4}]},"Nursery|3|7|Maths":{"grade":"Nursery","term":3,"year":7,"subject":"Maths","marks":20,"duration":"25–30 मिनट","qs":[{"title":"चित्रों को गिनकर सही संख्या लिखिए। / Count the dots.","body":"<div class=\"questions-grid\"><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg></span>　=　<span class=\"blank\">_______</span></div><div class=\"opt-line\"><span class=\"counters\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10 3L17 17H3Z\"/></g></svg><svg width=\"17\" height=\"17\" viewBox=\"0 0 20 20\"><g fill=\"none\" stroke=\"#333\" stroke-width=\"1.5\"><path d=\"M10